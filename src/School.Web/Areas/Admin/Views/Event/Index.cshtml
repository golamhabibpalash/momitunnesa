@model List<School.Application.DTOs.Event.EventDto>
@{
    ViewData["Title"] = "Events";
    ViewBag.ActiveMenu = "Events";
    var sl = 0;
}

<div class="page-header">
    <div>
        <h2><i class="fas fa-calendar-alt me-2"></i>Events</h2>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-area="Admin" asp-controller="Dashboard" asp-action="Index">Dashboard</a></li>
                <li class="breadcrumb-item active" aria-current="page">Events</li>
            </ol>
        </nav>
    </div>
    <a asp-area="Admin" asp-controller="Event" asp-action="Create" class="btn btn-primary">
        <i class="fas fa-plus me-1"></i>Add Event
    </a>
</div>

<div class="card">
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-hover table-datatable">
                <thead>
                    <tr>
                        <th>SL</th>
                        <th>Date</th>
                        <th>Title</th>
                        <th>Location</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        sl++;
                        <tr>
                            <td>@sl</td>
                            <td data-order="@item.EventDate.Ticks">@item.EventDate.ToString("MMM dd, yyyy")</td>
                            <td>@item.TitleEn @if (item.IsFeatured) { <i class="fas fa-star text-warning ms-1" title="Featured"></i> }</td>
                            <td>@item.Location</td>
                            <td>
                                @if (!item.IsActive)
                                {
                                    <span class="badge bg-secondary">Inactive</span>
                                }
                                else if (item.EventDate.Date >= DateTime.Today)
                                {
                                    <span class="badge bg-success">Upcoming</span>
                                }
                                else
                                {
                                    <span class="badge bg-info">Completed</span>
                                }
                            </td>
                            <td>
                                <div class="table-actions d-flex gap-1">
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-info" title="Edit"><i class="fas fa-edit"></i></a>
                                    <form asp-action="Delete" asp-route-id="@item.Id" method="post" onsubmit="return confirm('Delete this event?');">
                                        <button type="submit" class="btn btn-sm btn-danger" title="Delete"><i class="fas fa-trash"></i></button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
