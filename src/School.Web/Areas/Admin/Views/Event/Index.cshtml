                                    <i class="fas fa-trash"></i>
                                </button>
                            </div>
                        </td>
                    </tr>
                    <tr>
                        <td>5</td>
                        <td>Aug 30, 2026</td>
                        <td>Admission Open House</td>
                        <td>Main Campus</td>
                        <td><span class="badge bg-success">Upcoming</span></td>
                        <td>
                            <div class="table-actions">
                                <a asp-area="Admin" asp-controller="Event" asp-action="Edit" asp-route-id="5" class="btn btn-sm btn-info"><i class="fas fa-edit"></i></a>
                                <button type="button" class="btn btn-sm btn-danger" onclick="confirmDelete().then(r => { if(r.isConfirmed){ window.location.href='@Url.Action("Delete", "Event", new { area = "Admin", id = 5 })'; } })">
                                    <i class="fas fa-trash"></i>
                                </button>
                            </div>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>
