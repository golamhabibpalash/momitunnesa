@{
    ViewData["Title"] = "Events";
    ViewBag.ActiveMenu = "Events";
}

<div class="page-header">
    <div>
        <h2><i class="fas fa-calendar-alt me-2"></i>Events</h2>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-area="Admin" asp-controller="Dashboard" asp-action="Index">Dashboard</a></li>
                <li class="breadcrumb-item active" aria-current="page">Events</li>
            </ol>
        </nav>
    </div>
    <a asp-area="Admin" asp-controller="Event" asp-action="Create" class="btn btn-primary">
        <i class="fas fa-plus me-1"></i>Create New Event
    </a>
</div>

<div class="card">
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-hover table-datatable">
                <thead>
                    <tr>
                        <th>SL</th>
                        <th>Event Date</th>
                        <th>Title</th>
                        <th>Location</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td>1</td>
                        <td>Jun 15, 2026</td>
                        <td>Annual Science Fair</td>
                        <td>School Auditorium</td>
                        <td><span class="badge bg-success">Upcoming</span></td>
                        <td>
                            <div class="table-actions">
                                <a asp-area="Admin" asp-controller="Event" asp-action="Edit" asp-route-id="1" class="btn btn-sm btn-info"><i class="fas fa-edit"></i></a>
                                <button type="button" class="btn btn-sm btn-danger" onclick="confirmDelete().then(r => { if(r.isConfirmed){ window.location.href='@Url.Action("Delete", "Event", new { area = "Admin", id = 1 })'; } })">
                                    <i class="fas fa-trash"></i>
                                </button>
                            </div>
                        </td>
                    </tr>
                    <tr>
                        <td>2</td>
                        <td>Jul 20, 2026</td>
                        <td>Parent-Teacher Conference</td>
                        <td>Academic Building</td>
                        <td><span class="badge bg-success">Upcoming</span></td>
                        <td>
                            <div class="table-actions">
                                <a asp-area="Admin" asp-controller="Event" asp-action="Edit" asp-route-id="2" class="btn btn-sm btn-info"><i class="fas fa-edit"></i></a>
                                <button type="button" class="btn btn-sm btn-danger" onclick="confirmDelete().then(r => { if(r.isConfirmed){ window.location.href='@Url.Action("Delete", "Event", new { area = "Admin", id = 2 })'; } })">
                                    <i class="fas fa-trash"></i>
                                </button>
                            </div>
                        </td>
                    </tr>
                    <tr>
                        <td>3</td>
                        <td>May 10, 2026</td>
                        <td>Sports Day</td>
                        <td>School Playground</td>
                        <td><span class="badge bg-secondary">Completed</span></td>
                        <td>
                            <div class="table-actions">
                                <a asp-area="Admin" asp-controller="Event" asp-action="Edit" asp-route-id="3" class="btn btn-sm btn-info"><i class="fas fa-edit"></i></a>
                                <button type="button" class="btn btn-sm btn-danger" onclick="confirmDelete().then(r => { if(r.isConfirmed){ window.location.href='@Url.Action("Delete", "Event", new { area = "Admin", id = 3 })'; } })">
                                    <i class="fas fa-trash"></i>
                                </button>
                            </div>
                        </td>
                    </tr>
                    <tr>
                        <td>4</td>
                        <td>Apr 05, 2026</td>
                        <td>Cultural Program</td>
                        <td>Multi-Purpose Hall</td>
                        <td><span class="badge bg-secondary">Completed</span></td>
                        <td>
                            <div class="table-actions">
                                <a asp-area="Admin" asp-controller="Event" asp-action="Edit" asp-route-id="4" class="btn btn-sm btn-info"><i class="fas fa-edit"></i></a>
