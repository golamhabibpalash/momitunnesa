@model IEnumerable<School.Application.DTOs.Event.EventDto>
@{
    ViewData["Title"] = "Events";
    ViewBag.ActiveMenu = "Events";
}

<div class="page-header">
    <div>
        <h2><i class="fas fa-calendar-alt me-2"></i>Events</h2>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-area="Admin" asp-controller="Dashboard" asp-action="Index">Dashboard</a></li>
                <li class="breadcrumb-item active" aria-current="page">Events</li>
            </ol>
        </nav>
    </div>
    <a asp-area="Admin" asp-controller="Event" asp-action="Create" class="btn btn-primary">
        <i class="fas fa-plus me-1"></i>Create New Event
    </a>
</div>

<div class="card">
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-hover table-datatable">
                <thead>
                    <tr>
                        <th>SL</th>
                        <th>Title (English)</th>
                        <th>Event Date</th>
                        <th>Time</th>
                        <th>Location</th>
                        <th>Featured</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        var sl = 1;
                        foreach (var item in Model)
                        {
                            <tr>
                                <td>@(sl++)</td>
                                <td>@item.TitleEn</td>
                                <td>@item.EventDate.ToString("MMM dd, yyyy")</td>
                                <td>
                                    @if (item.StartTime.HasValue)
                                    {
                                        @($"{DateTime.Today.Add(item.StartTime.Value):hh:mm tt}")
                                        @if (item.EndTime.HasValue)
                                        {
                                            @($" - {DateTime.Today.Add(item.EndTime.Value):hh:mm tt}")
                                        }
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </td>
                                <td>@(string.IsNullOrEmpty(item.Location) ? "-" : item.Location)</td>
                                <td>
                                    @if (item.IsFeatured)
                                    {
                                        <i class="fas fa-star text-warning"></i>
                                    }
                                    else
                                    {
                                        <i class="far fa-star text-muted"></i>
                                    }
                                </td>
                                <td>
                                    @if (item.IsActive)
                                    {
                                        <span class="badge bg-success">Active</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">Inactive</span>
                                    }
                                </td>
                                <td>
                                    <div class="table-actions d-flex gap-1">
                                        <a asp-area="Admin" asp-controller="Event" asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-info"><i class="fas fa-edit"></i></a>
                                        <form asp-area="Admin" asp-controller="Event" asp-action="Delete" asp-route-id="@item.Id" method="post" style="display:inline" onsubmit="return confirm('Are you sure you want to delete this event?');">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-danger"><i class="fas fa-trash"></i></button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="8" class="text-center text-muted py-4">No events found.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
