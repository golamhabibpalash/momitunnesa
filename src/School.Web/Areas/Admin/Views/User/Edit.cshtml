@model School.Application.DTOs.Account.UserUpdateDto
@{
    ViewData["Title"] = "Edit User";
    ViewBag.ActiveMenu = "Users";
    var userId = ViewBag.UserId as string ?? "";
    var userEmail = ViewBag.UserEmail as string ?? "";
    var allRoles = ViewBag.AllRoles as IEnumerable<School.Application.DTOs.Account.RoleDto> ?? Enumerable.Empty<School.Application.DTOs.Account.RoleDto>();
    var currentRoles = Model.Roles ?? new List<string>();
}

<div class="page-header">
    <div>
        <h2><i class="fas fa-edit me-2"></i>Edit User</h2>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-area="Admin" asp-controller="Dashboard" asp-action="Index">Dashboard</a></li>
                <li class="breadcrumb-item"><a asp-area="Admin" asp-controller="User" asp-action="Index">Users</a></li>
                <li class="breadcrumb-item active" aria-current="page">Edit</li>
            </ol>
        </nav>
    </div>
    <a asp-area="Admin" asp-controller="User" asp-action="Index" class="btn btn-outline-secondary">
        <i class="fas fa-arrow-left me-1"></i>Back to List
    </a>
</div>

<form asp-area="Admin" asp-controller="User" asp-action="Edit" asp-route-id="@userId" method="post">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

    <div class="row g-3">
        <div class="col-lg-8">
            <div class="card mb-3">
                <div class="card-header"><i class="fas fa-info-circle me-2"></i>Account Information</div>
                <div class="card-body">
                    <div class="mb-3">
                        <label class="form-label">Email</label>
                        <input type="email" class="form-control" value="@userEmail" readonly>
                        <small class="text-muted">Email cannot be changed.</small>
                    </div>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="FullName" class="form-label required">Full Name</label>
                            <input asp-for="FullName" class="form-control" required>
                            <span asp-validation-for="FullName" class="text-danger"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Phone" class="form-label">Phone</label>
                            <input asp-for="Phone" class="form-control">
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card mb-3">
                <div class="card-header"><i class="fas fa-user-tag me-2"></i>Role Assignment</div>
                <div class="card-body">
                    @if (allRoles.Any())
                    {
                        foreach (var role in allRoles)
                        {
                            <div class="form-check mb-2">
                                <input class="form-check-input" type="checkbox" name="Roles" value="@role.Name" id="role_@role.Name" @(currentRoles.Contains(role.Name) ? "checked" : "")>
                                <label class="form-check-label" for="role_@role.Name">@role.Name</label>
                            </div>
                        }
                    }
                    else
                    {
                        <p class="text-muted small">No roles available.</p>
                    }
                </div>
            </div>

            <div class="card mb-3">
                <div class="card-header"><i class="fas fa-cog me-2"></i>Settings</div>
                <div class="card-body">
                    <div class="mb-3">
                        <div class="form-check form-switch">
                            <input asp-for="IsActive" class="form-check-input" role="switch">
                            <label asp-for="IsActive" class="form-check-label">Active</label>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="d-flex justify-content-end gap-2 mt-3">
        <a asp-area="Admin" asp-controller="User" asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
        <button type="submit" class="btn btn-primary px-4">
            <i class="fas fa-save me-1"></i>Update User
        </button>
    </div>
</form>
