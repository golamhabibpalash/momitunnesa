@model List<string>
@{
    var roles = ViewBag.Roles as List<School.Application.DTOs.Account.RoleDto> ?? new();
}
<div class="card mb-3">
    <div class="card-header"><i class="fas fa-user-tag me-2"></i>Roles</div>
    <div class="card-body">
        @foreach (var role in roles)
        {
            <div class="form-check mb-2">
                <input class="form-check-input" type="checkbox" name="Roles" value="@role.Name" id="role_@role.Id" checked="@Model.Contains(role.Name)">
                <label class="form-check-label" for="role_@role.Id">@role.Name</label>
            </div>
        }
        <small class="text-muted d-block mt-2">SuperAdmin manages users, roles and settings. Admin manages all content.</small>
    </div>
</div>
