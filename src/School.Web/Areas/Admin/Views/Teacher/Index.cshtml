@model IEnumerable<School.Application.DTOs.Teacher.TeacherDto>
@{
    ViewData["Title"] = "Teachers";
    ViewBag.ActiveMenu = "Teachers";
}

<div class="page-header">
    <div>
        <h2><i class="fas fa-chalkboard-teacher me-2"></i>Teachers</h2>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-area="Admin" asp-controller="Dashboard" asp-action="Index">Dashboard</a></li>
                <li class="breadcrumb-item active" aria-current="page">Teachers</li>
            </ol>
        </nav>
    </div>
    <a asp-area="Admin" asp-controller="Teacher" asp-action="Create" class="btn btn-primary">
        <i class="fas fa-plus me-1"></i>Add New Teacher
    </a>
</div>

<div class="card">
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-hover table-datatable">
                <thead>
                    <tr>
                        <th>SL</th>
                        <th>Photo</th>
                        <th>Name (English)</th>
                        <th>Designation</th>
                        <th>Subject</th>
                        <th>Order</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        var sl = 1;
                        foreach (var item in Model)
                        {
                            <tr>
                                <td>@(sl++)</td>
                                <td>
                                    @if (!string.IsNullOrEmpty(item.ImageUrl))
                                    {
                                        <img src="@item.ImageUrl" class="rounded-circle" alt="@item.NameEn" style="width:45px;height:45px;object-fit:cover;">
                                    }
                                    else
                                    {
                                        <i class="fas fa-user-circle text-muted" style="font-size:2.5rem;"></i>
                                    }
                                </td>
                                <td>@item.NameEn</td>
                                <td>@item.Designation</td>
                                <td>@(string.IsNullOrEmpty(item.SubjectEn) ? "-" : item.SubjectEn)</td>
                                <td>@item.SortOrder</td>
                                <td>
                                    @if (item.IsActive)
                                    {
                                        <span class="badge bg-success">Active</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">Inactive</span>
                                    }
                                </td>
                                <td>
                                    <div class="table-actions d-flex gap-1">
                                        <a asp-area="Admin" asp-controller="Teacher" asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-info"><i class="fas fa-edit"></i></a>
                                        <form asp-area="Admin" asp-controller="Teacher" asp-action="Delete" asp-route-id="@item.Id" method="post" style="display:inline" onsubmit="return confirm('Are you sure you want to delete this teacher?');">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-danger"><i class="fas fa-trash"></i></button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="8" class="text-center text-muted py-4">No teachers found.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
