@model List<School.Application.DTOs.Teacher.TeacherDto>
@{
    ViewData["Title"] = "Teachers";
    ViewBag.ActiveMenu = "Teachers";
    var sl = 0;
}

<div class="page-header">
    <div>
        <h2><i class="fas fa-chalkboard-teacher me-2"></i>Teachers</h2>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-area="Admin" asp-controller="Dashboard" asp-action="Index">Dashboard</a></li>
                <li class="breadcrumb-item active" aria-current="page">Teachers</li>
            </ol>
        </nav>
    </div>
    <a asp-area="Admin" asp-controller="Teacher" asp-action="Create" class="btn btn-primary"><i class="fas fa-plus me-1"></i>Add Teacher</a>
</div>

<div class="card">
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-hover table-datatable">
                <thead>
                    <tr>
                        <th>SL</th>
                        <th>Photo</th>
                        <th>Name</th>
                        <th>Designation</th>
                        <th>Subject</th>
                        <th>Phone</th>
                        <th>Order</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var t in Model)
                    {
                        sl++;
                        <tr>
                            <td>@sl</td>
                            <td><img src="@(string.IsNullOrEmpty(t.ImageUrl) ? $"https://ui-avatars.com/api/?name={Uri.EscapeDataString(t.NameEn)}&size=36" : t.ImageUrl)" class="avatar-sm rounded-circle" style="width:36px;height:36px;object-fit:cover;" alt=""></td>
                            <td>@t.NameEn<br><small class="text-muted">@t.NameBn</small></td>
                            <td>@(CategoryHelper.Label<Designation>(t.Designation)) @if (t.IsHeadTeacher) { <span class="badge bg-warning ms-1">Head</span> }</td>
                            <td>@t.SubjectEn</td>
                            <td>@t.Phone</td>
                            <td>@t.SortOrder</td>
                            <td>@if (t.IsActive) { <span class="badge bg-success">Active</span> } else { <span class="badge bg-secondary">Inactive</span> }</td>
                            <td>
                                <div class="table-actions d-flex gap-1">
                                    <a asp-action="Edit" asp-route-id="@t.Id" class="btn btn-sm btn-info" title="Edit"><i class="fas fa-edit"></i></a>
                                    <form asp-action="Delete" asp-route-id="@t.Id" method="post" onsubmit="return confirm('Delete this teacher?');">
                                        <button type="submit" class="btn btn-sm btn-danger" title="Delete"><i class="fas fa-trash"></i></button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
