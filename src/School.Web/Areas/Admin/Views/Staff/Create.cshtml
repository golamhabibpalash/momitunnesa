@model School.Application.DTOs.Staff.StaffCreateDto
@{
    int? staffId = ViewBag.StaffId;
    var isEdit = staffId.HasValue;
    ViewData["Title"] = isEdit ? "Edit Staff" : "Add Staff";
    ViewBag.ActiveMenu = "Staff";
}

<div class="page-header">
    <div>
        <h2><i class="fas @(isEdit ? "fa-user-edit" : "fa-user-plus") me-2"></i>@(isEdit ? "Edit Staff Member" : "Add Staff Member")</h2>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-area="Admin" asp-controller="Dashboard" asp-action="Index">Dashboard</a></li>
                <li class="breadcrumb-item"><a asp-area="Admin" asp-controller="Staff" asp-action="Index">Staff</a></li>
                <li class="breadcrumb-item active" aria-current="page">@(isEdit ? "Edit" : "Create")</li>
            </ol>
        </nav>
    </div>
    <a asp-area="Admin" asp-controller="Staff" asp-action="Index" class="btn btn-outline-secondary"><i class="fas fa-arrow-left me-1"></i>Back to List</a>
</div>

<form asp-area="Admin" asp-controller="Staff" asp-action="@(isEdit ? "Edit" : "Create")" asp-route-id="@staffId" method="post" enctype="multipart/form-data">
    <input type="hidden" asp-for="ImageUrl" />
    <div asp-validation-summary="All" class="alert alert-danger" role="alert"></div>

    <div class="row g-3">
        <div class="col-lg-8">
            <div class="card mb-3">
                <div class="card-header"><i class="fas fa-info-circle me-2"></i>Staff Information</div>
                <div class="card-body">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="NameEn" class="form-label required">Name (English)</label>
                            <input asp-for="NameEn" class="form-control" placeholder="Full name in English">
                        </div>
                        <div class="col-md-6">
                            <label asp-for="NameBn" class="form-label required">Name (Bangla)</label>
                            <input asp-for="NameBn" class="form-control" placeholder="বাংলায় নাম">
                        </div>
                        <div class="col-md-6">
                            <label asp-for="PositionEn" class="form-label">Designation (English)</label>
                            <input asp-for="PositionEn" class="form-control" placeholder="e.g., Office Assistant, Librarian">
                        </div>
                        <div class="col-md-6">
                            <label asp-for="PositionBn" class="form-label">Designation (Bangla)</label>
                            <input asp-for="PositionBn" class="form-control" placeholder="যেমন: অফিস সহকারী">
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Department" class="form-label">Department</label>
                            <input asp-for="Department" class="form-control" placeholder="e.g., Administration, Library" list="departmentOptions">
                            <datalist id="departmentOptions">
                                <option value="Administration"></option>
                                <option value="Accounts"></option>
                                <option value="Library"></option>
                                <option value="Laboratory"></option>
                                <option value="ICT"></option>
                                <option value="Support"></option>
                                <option value="Security"></option>
                            </datalist>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="JoiningDate" class="form-label">Joining Date</label>
                            <input asp-for="JoiningDate" type="date" class="form-control" value="@Model.JoiningDate?.ToString("yyyy-MM-dd")">
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Email" class="form-label">Email</label>
                            <input asp-for="Email" class="form-control" placeholder="staff@school.com">
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Phone" class="form-label">Phone</label>
                            <input asp-for="Phone" class="form-control" placeholder="+880 1XXX-XXXXXX">
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <partial name="_PhotoUpload" model="Model.ImageUrl" />
            <div class="card mb-3">
                <div class="card-header"><i class="fas fa-cog me-2"></i>Settings</div>
                <div class="card-body">
                    <div class="mb-3">
                        <label asp-for="SortOrder" class="form-label">Display Order</label>
                        <input asp-for="SortOrder" type="number" class="form-control" min="0">
                        <small class="text-muted">Lower numbers appear first.</small>
                    </div>
                    <div class="form-check form-switch">
                        <input asp-for="IsActive" class="form-check-input" type="checkbox" role="switch">
                        <label asp-for="IsActive" class="form-check-label">Active (shown on website)</label>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="d-flex justify-content-end gap-2 mt-3">
        <a asp-area="Admin" asp-controller="Staff" asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
        <button type="submit" class="btn btn-primary px-4"><i class="fas fa-save me-1"></i>@(isEdit ? "Update Staff" : "Save Staff")</button>
    </div>
</form>
