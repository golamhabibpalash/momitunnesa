@model School.Application.DTOs.Staff.StaffCreateDto
@{
    ViewData["Title"] = "Add Staff";
    ViewBag.ActiveMenu = "Staff";
}

<div class="page-header">
    <div>
        <h2><i class="fas fa-plus-circle me-2"></i>Add New Staff Member</h2>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-area="Admin" asp-controller="Dashboard" asp-action="Index">Dashboard</a></li>
                <li class="breadcrumb-item"><a asp-area="Admin" asp-controller="Staff" asp-action="Index">Staff</a></li>
                <li class="breadcrumb-item active" aria-current="page">Create</li>
            </ol>
        </nav>
    </div>
    <a asp-area="Admin" asp-controller="Staff" asp-action="Index" class="btn btn-outline-secondary">
        <i class="fas fa-arrow-left me-1"></i>Back to List
    </a>
</div>

<form asp-area="Admin" asp-controller="Staff" asp-action="Create" method="post">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

    <div class="row g-3">
        <div class="col-lg-8">
            <div class="card mb-3">
                <div class="card-header"><i class="fas fa-info-circle me-2"></i>Staff Information</div>
                <div class="card-body">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="NameEn" class="form-label required">Name (English)</label>
                            <input asp-for="NameEn" class="form-control" placeholder="Full name in English" required>
                            <span asp-validation-for="NameEn" class="text-danger"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="NameBn" class="form-label required">Name (Bangla)</label>
                            <input asp-for="NameBn" class="form-control" placeholder="বাংলায় নাম" required>
                            <span asp-validation-for="NameBn" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="row g-3 mt-2">
                        <div class="col-md-6">
                            <label asp-for="Designation" class="form-label required">Designation</label>
                            <select asp-for="Designation" class="form-select" asp-items="Html.GetEnumSelectList<Designation>()" required></select>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Department" class="form-label">Department</label>
                            <input asp-for="Department" class="form-control" placeholder="e.g., Administration, Library">
                        </div>
                    </div>
                    <div class="row g-3 mt-2">
                        <div class="col-md-6">
                            <label asp-for="Email" class="form-label">Email</label>
                            <input asp-for="Email" type="email" class="form-control" placeholder="staff@school.com">
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Phone" class="form-label">Phone</label>
                            <input asp-for="Phone" class="form-control" placeholder="+880 1XXX-XXXXXX">
                        </div>
                    </div>
                    <div class="row g-3 mt-2">
                        <div class="col-md-6">
                            <label asp-for="JoiningDate" class="form-label">Joining Date</label>
                            <input asp-for="JoiningDate" type="date" class="form-control">
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card mb-3">
                <div class="card-header"><i class="fas fa-image me-2"></i>Photo</div>
                <div class="card-body">
                    <label asp-for="ImageUrl" class="form-label">Photo URL</label>
                    <input asp-for="ImageUrl" class="form-control" placeholder="/uploads/staff/photo.jpg">
                    <small class="text-muted">Recommended: 300x300px</small>
                </div>
            </div>

            <div class="card mb-3">
                <div class="card-header"><i class="fas fa-cog me-2"></i>Settings</div>
                <div class="card-body">
                    <div class="mb-3">
                        <label asp-for="SortOrder" class="form-label">Display Order</label>
                        <input asp-for="SortOrder" type="number" class="form-control" value="1" min="0">
                    </div>
                    <div class="mb-3">
                        <div class="form-check form-switch">
                            <input asp-for="IsActive" class="form-check-input" role="switch" checked>
                            <label asp-for="IsActive" class="form-check-label">Active</label>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="d-flex justify-content-end gap-2 mt-3">
        <a asp-area="Admin" asp-controller="Staff" asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
        <button type="submit" class="btn btn-primary px-4">
            <i class="fas fa-save me-1"></i>Save Staff
        </button>
    </div>
</form>
