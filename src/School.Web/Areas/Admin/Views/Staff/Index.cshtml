@model List<School.Application.DTOs.Staff.StaffDto>
@{
    ViewData["Title"] = "Staff";
    ViewBag.ActiveMenu = "Staff";
    var sl = 0;
}

<div class="page-header">
    <div>
        <h2><i class="fas fa-users me-2"></i>Staff</h2>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-area="Admin" asp-controller="Dashboard" asp-action="Index">Dashboard</a></li>
                <li class="breadcrumb-item active" aria-current="page">Staff</li>
            </ol>
        </nav>
    </div>
    <a asp-area="Admin" asp-controller="Staff" asp-action="Create" class="btn btn-primary"><i class="fas fa-plus me-1"></i>Add Staff</a>
</div>

<div class="card">
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-hover table-datatable">
                <thead>
                    <tr>
                        <th>SL</th>
                        <th>Photo</th>
                        <th>Name</th>
                        <th>Designation</th>
                        <th>Department</th>
                        <th>Phone</th>
                        <th>Order</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var s in Model)
                    {
                        sl++;
                        <tr>
                            <td>@sl</td>
                            <td><img src="@(string.IsNullOrEmpty(s.ImageUrl) ? $"https://ui-avatars.com/api/?name={Uri.EscapeDataString(s.NameEn)}&size=36" : s.ImageUrl)" class="avatar-sm rounded-circle" style="width:36px;height:36px;object-fit:cover;" alt=""></td>
                            <td>@s.NameEn<br><small class="text-muted">@s.NameBn</small></td>
                            <td>@s.PositionEn</td>
                            <td>@s.Department</td>
                            <td>@s.Phone</td>
                            <td>@s.SortOrder</td>
                            <td>@if (s.IsActive) { <span class="badge bg-success">Active</span> } else { <span class="badge bg-secondary">Inactive</span> }</td>
                            <td>
                                <div class="table-actions d-flex gap-1">
                                    <a asp-action="Edit" asp-route-id="@s.Id" class="btn btn-sm btn-info" title="Edit"><i class="fas fa-edit"></i></a>
                                    <form asp-action="Delete" asp-route-id="@s.Id" method="post" onsubmit="return confirm('Delete this staff member?');">
                                        <button type="submit" class="btn btn-sm btn-danger" title="Delete"><i class="fas fa-trash"></i></button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
