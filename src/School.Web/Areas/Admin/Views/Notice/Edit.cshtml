@model School.Application.DTOs.Notice.NoticeCreateDto
@{
    ViewData["Title"] = "Edit Notice";
    ViewBag.ActiveMenu = "Notices";
    var noticeId = ViewBag.NoticeId as int? ?? 0;
}

<div class="page-header">
    <div>
        <h2><i class="fas fa-edit me-2"></i>Edit Notice</h2>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-area="Admin" asp-controller="Dashboard" asp-action="Index">Dashboard</a></li>
                <li class="breadcrumb-item"><a asp-area="Admin" asp-controller="Notice" asp-action="Index">Notices</a></li>
                <li class="breadcrumb-item active" aria-current="page">Edit</li>
            </ol>
        </nav>
    </div>
    <a asp-area="Admin" asp-controller="Notice" asp-action="Index" class="btn btn-outline-secondary">
        <i class="fas fa-arrow-left me-1"></i>Back to List
    </a>
</div>

<form asp-area="Admin" asp-controller="Notice" asp-action="Edit" asp-route-id="@noticeId" method="post">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

    <div class="row g-3">
        <div class="col-lg-8">
            <div class="card mb-3">
                <div class="card-header"><i class="fas fa-info-circle me-2"></i>Notice Information</div>
                <div class="card-body">
                    <div class="mb-3">
                        <label asp-for="TitleEn" class="form-label required">Title (English)</label>
                        <input asp-for="TitleEn" class="form-control" required>
                        <span asp-validation-for="TitleEn" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="TitleBn" class="form-label required">Title (Bangla)</label>
                        <input asp-for="TitleBn" class="form-control" required>
                        <span asp-validation-for="TitleBn" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="DescriptionEn" class="form-label">Description (English)</label>
                        <textarea asp-for="DescriptionEn" class="form-control" rows="5"></textarea>
                    </div>
                    <div class="mb-3">
                        <label asp-for="DescriptionBn" class="form-label">Description (Bangla)</label>
                        <textarea asp-for="DescriptionBn" class="form-control" rows="5"></textarea>
                    </div>
                    <div class="mb-3">
                        <label asp-for="AttachmentUrl" class="form-label">Attachment URL</label>
                        <input asp-for="AttachmentUrl" class="form-control" placeholder="/uploads/notices/file.pdf">
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card mb-3">
                <div class="card-header"><i class="fas fa-cog me-2"></i>Settings</div>
                <div class="card-body">
                    <div class="mb-3">
                        <label asp-for="NoticeCategory" class="form-label required">Category</label>
                        <select asp-for="NoticeCategory" class="form-select" asp-items="Html.GetEnumSelectList<NoticeCategory>()" required></select>
                    </div>
                    <div class="mb-3">
                        <label asp-for="PublishDate" class="form-label">Publish Date</label>
                        <input asp-for="PublishDate" type="date" class="form-control" value="@Model.PublishDate.ToString("yyyy-MM-dd")">
                    </div>
                    <div class="mb-3">
                        <label asp-for="ExpiryDate" class="form-label">Expiry Date</label>
                        <input asp-for="ExpiryDate" type="date" class="form-control" value="@(Model.ExpiryDate?.ToString("yyyy-MM-dd"))">
                    </div>
                    <div class="mb-3">
                        <div class="form-check form-switch">
                            <input asp-for="IsFeatured" class="form-check-input" role="switch">
                            <label asp-for="IsFeatured" class="form-check-label">Featured Notice</label>
                        </div>
                    </div>
                    <div class="mb-3">
                        <div class="form-check form-switch">
                            <input asp-for="IsActive" class="form-check-input" role="switch">
                            <label asp-for="IsActive" class="form-check-label">Active</label>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="d-flex justify-content-end gap-2 mt-3">
        <a asp-area="Admin" asp-controller="Notice" asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
        <button type="submit" class="btn btn-primary px-4">
            <i class="fas fa-save me-1"></i>Update Notice
        </button>
    </div>
</form>
