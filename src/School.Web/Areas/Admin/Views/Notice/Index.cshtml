@model List<School.Application.DTOs.Notice.NoticeDto>
@{
    ViewData["Title"] = "Notices";
    ViewBag.ActiveMenu = "Notices";
}

<div class="page-header">
    <div>
        <h2><i class="fas fa-bullhorn me-2"></i>Notices</h2>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-area="Admin" asp-controller="Dashboard" asp-action="Index">Dashboard</a></li>
                <li class="breadcrumb-item active" aria-current="page">Notices</li>
            </ol>
        </nav>
    </div>
    <a asp-area="Admin" asp-controller="Notice" asp-action="Create" class="btn btn-primary">
        <i class="fas fa-plus me-1"></i>Create New Notice
    </a>
</div>

<div class="card">
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-hover table-datatable">
                <thead>
                    <tr>
                        <th>SL</th>
                        <th>Title (English)</th>
                        <th>Category</th>
                        <th>Publish Date</th>
                        <th>Expiry Date</th>
                        <th>Featured</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        var sl = 0;
                        foreach (var notice in Model)
                        {
                            sl++;
                            var isExpired = notice.ExpiryDate.HasValue && notice.ExpiryDate < DateTime.Now;
                            <tr>
                                <td>@sl</td>
                                <td>@notice.TitleEn</td>
                                <td><span class="badge bg-info">@notice.NoticeCategory</span></td>
                                <td>@notice.PublishDate.ToString("MMM dd, yyyy")</td>
                                <td>@(notice.ExpiryDate?.ToString("MMM dd, yyyy") ?? "-")</td>
                                <td>
                                    @if (notice.IsFeatured)
                                    {
                                        <i class="fas fa-star text-warning"></i>
                                    }
                                    else
                                    {
                                        <i class="far fa-star text-muted"></i>
                                    }
                                </td>
                                <td>
                                    @if (isExpired)
                                    {
                                        <span class="badge bg-secondary">Expired</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success">Active</span>
                                    }
                                </td>
                                <td>
                                    <div class="table-actions d-flex gap-1">
                                        <a asp-area="Admin" asp-controller="Notice" asp-action="Edit" asp-route-id="@notice.Id" class="btn btn-sm btn-info"><i class="fas fa-edit"></i></a>
                                        <form asp-area="Admin" asp-controller="Notice" asp-action="Delete" asp-route-id="@notice.Id" method="post" onsubmit="return confirm('Are you sure you want to delete this notice?');">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-danger"><i class="fas fa-trash"></i></button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="8" class="text-center text-muted py-4">No notices found.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        @{
            var currentPage = ViewBag.CurrentPage as int? ?? 1;
            var totalPages = ViewBag.TotalPages as int? ?? 1;
        }
        @if (totalPages > 1)
        {
            <nav class="mt-3">
                <ul class="pagination justify-content-center mb-0">
                    <li class="page-item @(currentPage <= 1 ? "disabled" : "")">
                        <a class="page-link" asp-area="Admin" asp-controller="Notice" asp-action="Index" asp-route-page="@(currentPage - 1)"><i class="fas fa-chevron-left"></i></a>
                    </li>
                    @for (int p = 1; p <= totalPages; p++)
                    {
                        <li class="page-item @(p == currentPage ? "active" : "")">
                            <a class="page-link" asp-area="Admin" asp-controller="Notice" asp-action="Index" asp-route-page="@p">@p</a>
                        </li>
                    }
                    <li class="page-item @(currentPage >= totalPages ? "disabled" : "")">
                        <a class="page-link" asp-area="Admin" asp-controller="Notice" asp-action="Index" asp-route-page="@(currentPage + 1)"><i class="fas fa-chevron-right"></i></a>
                    </li>
                </ul>
            </nav>
        }
    </div>
</div>
