@model School.Application.DTOs.Download.DownloadCreateDto
@{
    int? downloadId = ViewBag.DownloadId;
    var isEdit = downloadId.HasValue;
    ViewData["Title"] = isEdit ? "Edit Download" : "Add Download";
    ViewBag.ActiveMenu = "Downloads";
}
<div class="page-header">
    <div>
        <h2><i class="fas fa-download me-2"></i>@ViewData["Title"]</h2>
        <nav aria-label="breadcrumb"><ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-area="Admin" asp-controller="Dashboard" asp-action="Index">Dashboard</a></li>
            <li class="breadcrumb-item"><a asp-action="Index">Downloads</a></li>
            <li class="breadcrumb-item active" aria-current="page">@(isEdit ? "Edit" : "Create")</li>
        </ol></nav>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary"><i class="fas fa-arrow-left me-1"></i>Back to List</a>
</div>
<form asp-action="@(isEdit ? "Edit" : "Create")" asp-route-id="@downloadId" method="post" enctype="multipart/form-data">
    <input type="hidden" asp-for="FileUrl" />
    <input type="hidden" asp-for="FileType" />
    <input type="hidden" asp-for="FileSize" />
    <div asp-validation-summary="All" class="alert alert-danger"></div>
    <div class="row g-3">
        <div class="col-lg-8">
            <div class="card"><div class="card-body"><div class="row g-3">
                <div class="col-md-6"><label asp-for="TitleEn" class="form-label required">Title (English)</label><input asp-for="TitleEn" class="form-control"></div>
                <div class="col-md-6"><label asp-for="TitleBn" class="form-label required">Title (Bangla)</label><input asp-for="TitleBn" class="form-control"></div>
                <div class="col-md-6"><label asp-for="DescriptionEn" class="form-label">Description (English)</label><textarea asp-for="DescriptionEn" class="form-control" rows="3"></textarea></div>
                <div class="col-md-6"><label asp-for="DescriptionBn" class="form-label">Description (Bangla)</label><textarea asp-for="DescriptionBn" class="form-control" rows="3"></textarea></div>
                <div class="col-12">
                    <label class="form-label @(isEdit ? "" : "required")">File</label>
                    @if (!string.IsNullOrEmpty(Model.FileUrl))
                    {
                        <div class="mb-2"><a href="@Model.FileUrl" target="_blank"><i class="fas fa-paperclip me-1"></i>@System.IO.Path.GetFileName(Model.FileUrl)</a> <small class="text-muted">(choose a new file to replace it)</small></div>
                    }
                    <input type="file" name="File" class="form-control">
                    <small class="text-muted">PDF, Word, Excel, PowerPoint, image or TXT, max 10MB.</small>
                </div>
            </div></div></div>
        </div>
        <div class="col-lg-4">
            <div class="card"><div class="card-body">
                <div class="mb-3">
                    <label asp-for="DownloadCategory" class="form-label required">Category</label>
                    <select asp-for="DownloadCategory" class="form-select" asp-items="Html.GetEnumSelectList<DownloadCategory>()"></select>
                </div>
                <div class="form-check form-switch">
                    <input asp-for="IsActive" class="form-check-input" role="switch">
                    <label asp-for="IsActive" class="form-check-label">Show on website</label>
                </div>
            </div></div>
        </div>
    </div>
    <div class="text-end mt-3"><button type="submit" class="btn btn-primary px-4"><i class="fas fa-save me-1"></i>@(isEdit ? "Update" : "Save")</button></div>
</form>
