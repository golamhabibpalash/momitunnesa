@model IEnumerable<School.Application.DTOs.Download.DownloadDto>
@{
    ViewData["Title"] = "Downloads";
    ViewBag.ActiveMenu = "Downloads";
}

<div class="page-header">
    <div>
        <h2><i class="fas fa-download me-2"></i>Downloads</h2>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-area="Admin" asp-controller="Dashboard" asp-action="Index">Dashboard</a></li>
                <li class="breadcrumb-item active" aria-current="page">Downloads</li>
            </ol>
        </nav>
    </div>
    <a asp-area="Admin" asp-controller="Download" asp-action="Create" class="btn btn-primary">
        <i class="fas fa-plus me-1"></i>Add New Download
    </a>
</div>

<div class="card">
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-hover table-datatable">
                <thead>
                    <tr>
                        <th>SL</th>
                        <th>Title (English)</th>
                        <th>Category</th>
                        <th>Type</th>
                        <th>File</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        var sl = 1;
                        foreach (var item in Model)
                        {
                            <tr>
                                <td>@(sl++)</td>
                                <td>@item.TitleEn</td>
                                <td><span class="badge bg-info">@item.DownloadCategory</span></td>
                                <td>@(string.IsNullOrEmpty(item.FileType) ? "-" : item.FileType)</td>
                                <td>
                                    @if (!string.IsNullOrEmpty(item.FileUrl))
                                    {
                                        <a href="@item.FileUrl" target="_blank" rel="noopener"><i class="fas fa-file-download"></i> Open</a>
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </td>
                                <td>
                                    @if (item.IsActive)
                                    {
                                        <span class="badge bg-success">Active</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">Inactive</span>
                                    }
                                </td>
                                <td>
                                    <div class="table-actions d-flex gap-1">
                                        <a asp-area="Admin" asp-controller="Download" asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-info"><i class="fas fa-edit"></i></a>
                                        <form asp-area="Admin" asp-controller="Download" asp-action="Delete" asp-route-id="@item.Id" method="post" style="display:inline" onsubmit="return confirm('Are you sure you want to delete this download?');">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-danger"><i class="fas fa-trash"></i></button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="text-center text-muted py-4">No downloads found.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
