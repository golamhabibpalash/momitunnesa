@{
    ViewData["Title"] = "Media Manager";
    ViewBag.ActiveMenu = "Media";
    var currentFolder = ViewBag.CurrentFolder as string ?? "";
    var files = ViewBag.Files as IEnumerable<string> ?? Enumerable.Empty<string>();
    var imageExts = new[] { ".jpg", ".jpeg", ".png", ".webp", ".gif", ".bmp", ".svg" };
}

<div class="page-header">
    <div>
        <h2><i class="fas fa-photo-video me-2"></i>Media Manager</h2>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-area="Admin" asp-controller="Dashboard" asp-action="Index">Dashboard</a></li>
                <li class="breadcrumb-item active" aria-current="page">Media@(string.IsNullOrEmpty(currentFolder) ? "" : " / " + currentFolder)</li>
            </ol>
        </nav>
    </div>
    <div class="d-flex gap-2">
        <button type="button" class="btn btn-outline-primary" data-bs-toggle="modal" data-bs-target="#createFolderModal">
            <i class="fas fa-folder-plus me-1"></i>New Folder
        </button>
        <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#uploadMediaModal">
            <i class="fas fa-upload me-1"></i>Upload Media
        </button>
    </div>
</div>

<div class="card">
    <div class="card-header"><i class="fas fa-images me-1"></i>Files@(string.IsNullOrEmpty(currentFolder) ? " (Root)" : " in " + currentFolder)</div>
    <div class="card-body">
        <div class="row g-3">
            @if (files.Any())
            {
                foreach (var file in files)
                {
                    var name = System.IO.Path.GetFileName(file);
                    var ext = System.IO.Path.GetExtension(file).ToLowerInvariant();
                    var isImage = imageExts.Contains(ext);
                    <div class="col-md-3 col-6">
                        <div class="border rounded overflow-hidden">
                            @if (isImage)
                            {
                                <img src="@file" alt="@name" style="width:100%;height:120px;object-fit:cover;">
                            }
                            else
                            {
                                <div class="d-flex align-items-center justify-content-center" style="height:120px;background:#f4f6f9;">
                                    <i class="fas fa-file text-muted" style="font-size:2rem;"></i>
                                </div>
                            }
                            <div class="p-2">
                                <small class="d-block text-truncate" title="@name">@name</small>
                                <div class="d-flex gap-1 mt-1">
                                    <a href="@file" target="_blank" rel="noopener" class="btn btn-sm btn-light" title="Open"><i class="fas fa-external-link-alt"></i></a>
                                    <form asp-area="Admin" asp-controller="Media" asp-action="Delete" method="post" onsubmit="return confirm('Delete this file?');">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="path" value="@file">
                                        <button type="submit" class="btn btn-sm btn-light" title="Delete"><i class="fas fa-trash text-danger"></i></button>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="col-12 text-center text-muted py-4">No files found@(string.IsNullOrEmpty(currentFolder) ? "" : " in this folder").</div>
            }
        </div>
    </div>
</div>

<div class="modal fade" id="uploadMediaModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-area="Admin" asp-controller="Media" asp-action="Upload" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h5 class="modal-title"><i class="fas fa-upload me-2"></i>Upload Media</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Upload to Folder</label>
                        <input type="text" name="folder" class="form-control" value="@currentFolder" placeholder="Leave empty for root">
                    </div>
                    <div class="mb-3">
                        <label class="form-label required">File</label>
                        <input type="file" name="file" class="form-control" required>
                        <small class="text-muted">Max 25MB.</small>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary"><i class="fas fa-upload me-1"></i>Upload File</button>
                </div>
            </form>
        </div>
    </div>
</div>

<div class="modal fade" id="createFolderModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-area="Admin" asp-controller="Media" asp-action="CreateFolder" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h5 class="modal-title"><i class="fas fa-folder-plus me-2"></i>Create Folder</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label required">Folder Name</label>
                        <input type="text" name="name" class="form-control" placeholder="e.g., gallery/sports-2026" required>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary"><i class="fas fa-save me-1"></i>Create Folder</button>
                </div>
            </form>
        </div>
    </div>
</div>
