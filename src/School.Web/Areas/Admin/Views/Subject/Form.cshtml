@model School.Application.DTOs.Academic.SubjectUpdateDto
@{
    var isEdit = Model.Id > 0;
    ViewData["Title"] = isEdit ? "Edit Subject" : "Add Subject";
    ViewBag.ActiveMenu = "Subjects";
}
<div class="page-header">
    <div>
        <h2><i class="fas fa-book-open me-2"></i>@ViewData["Title"]</h2>
        <nav aria-label="breadcrumb"><ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-area="Admin" asp-controller="Dashboard" asp-action="Index">Dashboard</a></li>
            <li class="breadcrumb-item"><a asp-action="Index">Subjects</a></li>
            <li class="breadcrumb-item active" aria-current="page">@(isEdit ? "Edit" : "Create")</li>
        </ol></nav>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary"><i class="fas fa-arrow-left me-1"></i>Back</a>
</div>
<form asp-action="@(isEdit ? "Edit" : "Create")" asp-route-id="@(isEdit ? Model.Id : null)" method="post">
    <div asp-validation-summary="All" class="alert alert-danger"></div>
    <div class="card"><div class="card-body"><div class="row g-3">
        <div class="col-md-4"><label asp-for="ClassName" class="form-label required"></label><input asp-for="ClassName" class="form-control" list="classOptions" placeholder="e.g., Class 6"></div>
        <div class="col-md-4"><label asp-for="Code" class="form-label"></label><input asp-for="Code" class="form-control" placeholder="e.g., 101"></div>
        <div class="col-md-4 d-flex align-items-end"><div class="form-check form-switch mb-2"><input asp-for="IsActive" class="form-check-input" role="switch"><label asp-for="IsActive" class="form-check-label">Show on website</label></div></div>
        <div class="col-md-6"><label asp-for="NameEn" class="form-label required"></label><input asp-for="NameEn" class="form-control" placeholder="e.g., Mathematics"></div>
        <div class="col-md-6"><label asp-for="NameBn" class="form-label required"></label><input asp-for="NameBn" class="form-control" placeholder="যেমন: গণিত"></div>
    </div></div></div>
    <partial name="_ClassDatalist" />
    <div class="text-end mt-3"><button type="submit" class="btn btn-primary px-4"><i class="fas fa-save me-1"></i>Save</button></div>
</form>
