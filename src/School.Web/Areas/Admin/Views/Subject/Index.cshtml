@model List<School.Application.DTOs.Academic.SubjectDto>
@{
    ViewData["Title"] = "Subjects";
    ViewBag.ActiveMenu = "Subjects";
}
<div class="page-header">
    <div>
        <h2><i class="fas fa-book-open me-2"></i>Subjects</h2>
        <nav aria-label="breadcrumb"><ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-area="Admin" asp-controller="Dashboard" asp-action="Index">Dashboard</a></li>
            <li class="breadcrumb-item active" aria-current="page">Subjects</li>
        </ol></nav>
    </div>
    <a asp-action="Create" class="btn btn-primary"><i class="fas fa-plus me-1"></i>Add Subject</a>
</div>
<div class="card"><div class="card-body"><div class="table-responsive">
    <table class="table table-hover table-datatable">
        <thead><tr><th>Class</th><th>Code</th><th>Subject (English)</th><th>Subject (Bangla)</th><th>Status</th><th>Actions</th></tr></thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.ClassName</td>
                    <td>@item.Code</td>
                    <td>@item.NameEn</td>
                    <td>@item.NameBn</td>
                    <td>@if (item.IsActive) { <span class="badge bg-success">Active</span> } else { <span class="badge bg-secondary">Hidden</span> }</td>
                    <td><div class="d-flex gap-1">
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-info" title="Edit"><i class="fas fa-edit"></i></a>
                        <form asp-action="Delete" asp-route-id="@item.Id" method="post" onsubmit="return confirm('Delete this subject?');"><button type="submit" class="btn btn-sm btn-danger" title="Delete"><i class="fas fa-trash"></i></button></form>
                    </div></td>
                </tr>
            }
        </tbody>
    </table>
</div></div></div>
