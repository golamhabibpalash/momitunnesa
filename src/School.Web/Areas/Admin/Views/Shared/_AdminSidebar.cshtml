@{
    var activeMenu = ViewBag.ActiveMenu as string ?? "";
    var activeSubMenu = ViewBag.ActiveSubMenu as string ?? "";
    bool IsActive(string menu, string? subMenu = null)
    {
        if (subMenu == null) return activeMenu == menu;
        return activeMenu == menu && activeSubMenu == subMenu;
    }
}

