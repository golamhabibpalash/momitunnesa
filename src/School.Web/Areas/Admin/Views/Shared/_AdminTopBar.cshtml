@using Microsoft.AspNetCore.Identity
@using School.Domain.Entities
@inject UserManager<ApplicationUser> UserManager
@inject IContactService ContactService
@{
    var currentUser = await UserManager.GetUserAsync(User);
    var currentUserName = currentUser?.FullName is { Length: > 0 } fullName ? fullName : (currentUser?.UserName ?? "Unknown user");
    var currentUserEmail = currentUser?.Email ?? "";
    var currentUserInitial = currentUserName.Substring(0, 1).ToUpperInvariant();

    var messagesResult = await ContactService.GetAllMessagesAsync();
    var unreadMessages = messagesResult.Success && messagesResult.Data is not null
        ? messagesResult.Data.Where(m => !m.IsRead).OrderByDescending(m => m.CreatedAt).ToList()
        : new List<School.Application.DTOs.Contact.ContactMessageDto>();
}
<header class="topbar">
    <div class="topbar-left">
        <button class="topbar-btn d-md-none" type="button" id="mobileSidebarToggle" onclick="$('.sidebar').toggleClass('expanded-mobile')">
            <i class="fas fa-bars"></i>
        </button>
        <h5 class="page-title">@ViewData["Title"]</h5>
    </div>

    <div class="topbar-right">
        <div class="topbar-search d-none d-md-block">
            <i class="fas fa-search"></i>
            <input type="text" class="form-control" placeholder="Search anything..." id="globalSearch">
        </div>

        <button class="topbar-btn" onclick="toggleDarkMode()" data-bs-toggle="tooltip" title="Toggle Theme">
            <i class="fas fa-moon"></i>
        </button>

        <div class="dropdown">
            <button class="topbar-btn" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                <i class="fas fa-globe"></i>
                <span style="font-size:0.75rem; font-weight:600; margin-left:2px;">EN</span>
            </button>
            <ul class="dropdown-menu dropdown-menu-end shadow-sm">
                <li><a class="dropdown-item" href="#"><img src="https://flagcdn.com/16x12/gb.png" alt="EN" class="me-2" style="width:16px;height:12px;">English</a></li>
                <li><a class="dropdown-item" href="#"><img src="https://flagcdn.com/16x12/bd.png" alt="BN" class="me-2" style="width:16px;height:12px;">বাংলা</a></li>
            </ul>
        </div>

        <div class="dropdown">
            <button class="topbar-btn" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                <i class="fas fa-bell"></i>
                @if (unreadMessages.Count > 0)
                {
                    <span class="badge bg-danger rounded-pill">@unreadMessages.Count</span>
                }
            </button>
            <div class="dropdown-menu dropdown-menu-end shadow-sm" style="width:320px;">
                <div class="dropdown-header">
                    <strong>Unread Messages</strong>
                </div>
                <div class="dropdown-divider"></div>
                @if (unreadMessages.Count == 0)
                {
                    <div class="dropdown-item text-center text-muted small py-3">
                        No unread messages.
                    </div>
                }
                else
                {
                    @foreach (var message in unreadMessages.Take(5))
                    {
                        <a asp-area="Admin" asp-controller="Contact" asp-action="Details" asp-route-id="@message.Id" class="dropdown-item d-flex align-items-start gap-3 py-2">
                            <div class="bg-primary rounded-circle d-flex align-items-center justify-content-center" style="width:36px;height:36px;min-width:36px;">
                                <i class="fas fa-envelope text-white" style="font-size:0.8rem;"></i>
                            </div>
                            <div class="flex-grow-1">
                                <p class="mb-0 small fw-semibold text-truncate">@message.Subject</p>
                                <small class="text-muted">@message.Name</small>
                                <br><small class="text-muted">@message.CreatedAt.ToLocalTime().ToString("dd MMM yyyy, HH:mm")</small>
                            </div>
                        </a>
                    }
                    <div class="dropdown-divider"></div>
                    <a class="dropdown-item text-center small" asp-area="Admin" asp-controller="Contact" asp-action="Index">
                        View All Messages
                    </a>
                }
            </div>
        </div>

        <div class="dropdown user-dropdown">
            <button class="topbar-btn d-flex align-items-center gap-2" type="button" data-bs-toggle="dropdown" aria-expanded="false" style="width:auto;padding:4px 12px;border-radius:30px;">
                @if (!string.IsNullOrEmpty(currentUser?.ImageUrl))
                {
                    <img src="@currentUser.ImageUrl" alt="@currentUserName" style="width:34px;height:34px;border-radius:50%;object-fit:cover;">
                }
                else
                {
                    <span class="avatar-initials">@currentUserInitial</span>
                }
                <span class="d-none d-md-inline" style="font-size:0.85rem;font-weight:500;">@currentUserName</span>
                <i class="fas fa-chevron-down" style="font-size:0.7rem;"></i>
            </button>
            <ul class="dropdown-menu dropdown-menu-end shadow-sm">
                <li>
                    <div class="dropdown-header d-flex align-items-center gap-3">
                        @if (!string.IsNullOrEmpty(currentUser?.ImageUrl))
                        {
                            <img src="@currentUser.ImageUrl" alt="@currentUserName" style="width:40px;height:40px;border-radius:50%;object-fit:cover;">
                        }
                        else
                        {
                            <span class="avatar-initials" style="width:40px;height:40px;font-size:1rem;">@currentUserInitial</span>
                        }
                        <div>
                            <strong>@currentUserName</strong>
                            <br><small class="text-muted">@currentUserEmail</small>
                        </div>
                    </div>
                </li>
                <li><hr class="dropdown-divider"></li>
                <li><a class="dropdown-item" asp-area="Admin" asp-controller="Account" asp-action="Profile"><i class="fas fa-user-circle me-2"></i>My Profile</a></li>
                <li><a class="dropdown-item" asp-area="Admin" asp-controller="Account" asp-action="ChangePassword"><i class="fas fa-lock me-2"></i>Change Password</a></li>
                <li><hr class="dropdown-divider"></li>
                <li>
                    <form asp-area="Admin" asp-controller="Account" asp-action="Logout" method="post">
                        <button type="submit" class="dropdown-item text-danger">
                            <i class="fas fa-sign-out-alt me-2"></i>Logout
                        </button>
                    </form>
                </li>
            </ul>
        </div>
    </div>
</header>
