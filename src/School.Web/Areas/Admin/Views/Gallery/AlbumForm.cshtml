@model School.Application.DTOs.Gallery.GalleryAlbumCreateDto
@{
    int? albumId = ViewBag.AlbumId;
    var isEdit = albumId.HasValue;
    ViewData["Title"] = isEdit ? "Edit Album" : "Create Album";
    ViewBag.ActiveMenu = "Albums";
}

<div class="page-header">
    <div>
        <h2><i class="fas @(isEdit ? "fa-edit" : "fa-folder-plus") me-2"></i>@ViewData["Title"]</h2>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-area="Admin" asp-controller="Dashboard" asp-action="Index">Dashboard</a></li>
                <li class="breadcrumb-item"><a asp-action="Albums">Albums</a></li>
                <li class="breadcrumb-item active" aria-current="page">@(isEdit ? "Edit" : "Create")</li>
            </ol>
        </nav>
    </div>
    <a asp-action="@(isEdit ? "AlbumImages" : "Albums")" asp-route-id="@albumId" class="btn btn-outline-secondary"><i class="fas fa-arrow-left me-1"></i>Back</a>
</div>

<form asp-action="@(isEdit ? "EditAlbum" : "CreateAlbum")" asp-route-id="@albumId" method="post" enctype="multipart/form-data">
    <input type="hidden" asp-for="CoverImageUrl" />
    <div asp-validation-summary="All" class="alert alert-danger" role="alert"></div>
    <div class="row g-3">
        <div class="col-lg-8">
            <div class="card">
                <div class="card-body">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="TitleEn" class="form-label required">Album Title (English)</label>
                            <input asp-for="TitleEn" class="form-control" placeholder="e.g., Annual Sports Day 2026">
                        </div>
                        <div class="col-md-6">
                            <label asp-for="TitleBn" class="form-label required">Album Title (Bangla)</label>
                            <input asp-for="TitleBn" class="form-control" placeholder="যেমন: বার্ষিক ক্রীড়া প্রতিযোগিতা ২০২৬">
                        </div>
                        <div class="col-md-6">
                            <label asp-for="DescriptionEn" class="form-label">Description (English)</label>
                            <textarea asp-for="DescriptionEn" class="form-control" rows="3"></textarea>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="DescriptionBn" class="form-label">Description (Bangla)</label>
                            <textarea asp-for="DescriptionBn" class="form-control" rows="3"></textarea>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-lg-4">
            <div class="card mb-3">
                <div class="card-header"><i class="fas fa-image me-2"></i>Cover Image</div>
                <div class="card-body">
                    @if (!string.IsNullOrEmpty(Model.CoverImageUrl))
                    {
                        <img src="@Model.CoverImageUrl" class="img-fluid rounded mb-2" alt="Cover" />
                    }
                    <input type="file" name="CoverImage" class="form-control" accept="image/*">
                    <small class="text-muted">Optional. You can also pick any album photo as the cover later.</small>
                </div>
            </div>
            <div class="card">
                <div class="card-body">
                    <div class="form-check form-switch">
                        <input asp-for="IsActive" class="form-check-input" type="checkbox" role="switch">
                        <label asp-for="IsActive" class="form-check-label">Show on website</label>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="d-flex justify-content-end gap-2 mt-3">
        <button type="submit" class="btn btn-primary px-4"><i class="fas fa-save me-1"></i>@(isEdit ? "Update Album" : "Create Album")</button>
    </div>
</form>
