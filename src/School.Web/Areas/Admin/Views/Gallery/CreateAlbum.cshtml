@model School.Application.DTOs.Gallery.GalleryAlbumCreateDto
@{
    ViewData["Title"] = "Create Album";
    ViewBag.ActiveMenu = "Albums";
}

<div class="page-header">
    <div>
        <h2><i class="fas fa-folder-plus me-2"></i>Create New Album</h2>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-area="Admin" asp-controller="Dashboard" asp-action="Index">Dashboard</a></li>
                <li class="breadcrumb-item"><a asp-area="Admin" asp-controller="Gallery" asp-action="Albums">Albums</a></li>
                <li class="breadcrumb-item active" aria-current="page">Create</li>
            </ol>
        </nav>
    </div>
    <a asp-area="Admin" asp-controller="Gallery" asp-action="Albums" class="btn btn-outline-secondary">
        <i class="fas fa-arrow-left me-1"></i>Back to Albums
    </a>
</div>

<form asp-area="Admin" asp-controller="Gallery" asp-action="CreateAlbum" method="post">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

    <div class="card mb-3">
        <div class="card-header"><i class="fas fa-info-circle me-2"></i>Album Information</div>
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="TitleEn" class="form-label required">Title (English)</label>
                    <input asp-for="TitleEn" class="form-control" required>
                    <span asp-validation-for="TitleEn" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="TitleBn" class="form-label required">Title (Bangla)</label>
                    <input asp-for="TitleBn" class="form-control" required>
                    <span asp-validation-for="TitleBn" class="text-danger"></span>
                </div>
            </div>
            <div class="row g-3 mt-1">
                <div class="col-md-6">
                    <label asp-for="DescriptionEn" class="form-label">Description (English)</label>
                    <textarea asp-for="DescriptionEn" class="form-control" rows="2"></textarea>
                </div>
                <div class="col-md-6">
                    <label asp-for="DescriptionBn" class="form-label">Description (Bangla)</label>
                    <textarea asp-for="DescriptionBn" class="form-control" rows="2"></textarea>
                </div>
            </div>
            <div class="mt-3">
                <label asp-for="CoverImageUrl" class="form-label">Cover Image URL</label>
                <input asp-for="CoverImageUrl" class="form-control" placeholder="/uploads/gallery/cover.jpg">
            </div>
            <div class="mt-3">
                <div class="form-check form-switch">
                    <input asp-for="IsActive" class="form-check-input" role="switch" checked>
                    <label asp-for="IsActive" class="form-check-label">Active</label>
                </div>
            </div>
        </div>
    </div>

    <div class="d-flex justify-content-end gap-2">
        <a asp-area="Admin" asp-controller="Gallery" asp-action="Albums" class="btn btn-outline-secondary">Cancel</a>
        <button type="submit" class="btn btn-primary px-4"><i class="fas fa-save me-1"></i>Create Album</button>
    </div>
</form>
