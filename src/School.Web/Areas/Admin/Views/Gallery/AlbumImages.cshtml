@{
    ViewData["Title"] = "Album Images";
    ViewBag.ActiveMenu = "Albums";
    var album = ViewBag.Album as School.Application.DTOs.Gallery.GalleryAlbumDto;
    var images = ViewBag.Images as IEnumerable<School.Application.DTOs.Gallery.GalleryImageDto> ?? Enumerable.Empty<School.Application.DTOs.Gallery.GalleryImageDto>();
    var albumId = album?.Id ?? 0;
}

<div class="page-header">
    <div>
        <h2><i class="fas fa-images me-2"></i>Album: @album?.TitleEn</h2>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-area="Admin" asp-controller="Dashboard" asp-action="Index">Dashboard</a></li>
                <li class="breadcrumb-item"><a asp-area="Admin" asp-controller="Gallery" asp-action="Albums">Albums</a></li>
                <li class="breadcrumb-item active" aria-current="page">Album Images</li>
            </ol>
        </nav>
    </div>
    <div class="d-flex gap-2">
        <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#uploadImagesModal">
            <i class="fas fa-upload me-1"></i>Upload Image
        </button>
        <a asp-area="Admin" asp-controller="Gallery" asp-action="Albums" class="btn btn-outline-secondary">
            <i class="fas fa-arrow-left me-1"></i>Back
        </a>
    </div>
</div>

<div class="card mb-3">
    <div class="card-body">
        <div class="row g-3">
            @if (images.Any())
            {
                foreach (var image in images)
                {
                    <div class="col-md-3 col-6">
                        <div class="border rounded overflow-hidden position-relative">
                            <img src="@image.ImageUrl" alt="@image.Title" style="width:100%;height:160px;object-fit:cover;">
                            <div class="p-2 d-flex justify-content-between align-items-center">
                                <small class="text-truncate">@image.Title</small>
                                <form asp-area="Admin" asp-controller="Gallery" asp-action="DeleteImage" asp-route-id="@image.Id" method="post" onsubmit="return confirm('Delete this image?');">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-light"><i class="fas fa-times text-danger"></i></button>
                                </form>
                            </div>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="col-12 text-center text-muted py-4">No images in this album yet.</div>
            }
        </div>
    </div>
</div>

<div class="modal fade" id="uploadImagesModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-area="Admin" asp-controller="Gallery" asp-action="UploadImage" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <input type="hidden" name="albumId" value="@albumId">
                <div class="modal-header">
                    <h5 class="modal-title"><i class="fas fa-upload me-2"></i>Upload Image</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label required">Select Image</label>
                        <input type="file" name="file" class="form-control" accept="image/*" required>
                        <small class="text-muted">Supports JPG, PNG, WEBP.</small>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary"><i class="fas fa-upload me-1"></i>Upload</button>
                </div>
            </form>
        </div>
    </div>
</div>
