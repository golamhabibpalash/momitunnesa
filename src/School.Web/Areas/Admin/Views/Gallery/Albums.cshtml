@model IEnumerable<School.Application.DTOs.Gallery.GalleryAlbumDto>
@{
    ViewData["Title"] = "Gallery Albums";
    ViewBag.ActiveMenu = "Albums";
}

<div class="page-header">
    <div>
        <h2><i class="fas fa-folder me-2"></i>Gallery Albums</h2>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-area="Admin" asp-controller="Dashboard" asp-action="Index">Dashboard</a></li>
                <li class="breadcrumb-item active" aria-current="page">Albums</li>
            </ol>
        </nav>
    </div>
    <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#createAlbumModal">
        <i class="fas fa-plus me-1"></i>Create New Album
    </button>
</div>

<div class="row g-3">
    @if (Model != null && Model.Any())
    {
        foreach (var album in Model)
        {
            <div class="col-lg-4 col-md-6">
                <div class="album-card card">
                    <div class="album-cover" style="background-image: url('@(string.IsNullOrEmpty(album.CoverImageUrl) ? "https://placehold.co/600x400/667eea/white?text=Album" : album.CoverImageUrl)'); background-size:cover; background-position:center; height:180px;">
                        <span class="album-count"><i class="fas fa-images me-1"></i>@album.ImageCount</span>
                    </div>
                    <div class="album-body p-3">
                        <h6>@album.TitleEn</h6>
                        <small class="text-muted"><i class="far fa-calendar me-1"></i>Created: @album.CreatedAt.ToString("MMM dd, yyyy")</small>
                        <div class="mt-2 d-flex gap-1">
                            <a asp-area="Admin" asp-controller="Gallery" asp-action="AlbumImages" asp-route-id="@album.Id" class="btn btn-sm btn-primary">
                                <i class="fas fa-eye"></i> View
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        }
    }
    else
    {
        <div class="col-12">
            <div class="card">
                <div class="card-body text-center text-muted py-4">No albums found.</div>
            </div>
        </div>
    }
</div>

<div class="modal fade" id="createAlbumModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-area="Admin" asp-controller="Gallery" asp-action="CreateAlbum" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h5 class="modal-title"><i class="fas fa-folder-plus me-2"></i>Create New Album</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label required">Album Title (English)</label>
                        <input type="text" name="TitleEn" class="form-control" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label required">Album Title (Bangla)</label>
                        <input type="text" name="TitleBn" class="form-control" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Description (English)</label>
                        <textarea name="DescriptionEn" class="form-control" rows="2"></textarea>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Description (Bangla)</label>
                        <textarea name="DescriptionBn" class="form-control" rows="2"></textarea>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Cover Image URL</label>
                        <input type="text" name="CoverImageUrl" class="form-control" placeholder="/uploads/gallery/cover.jpg">
                    </div>
                    <div class="mb-3">
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" role="switch" id="albumActive" name="IsActive" value="true" checked>
                            <label class="form-check-label" for="albumActive">Active</label>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary"><i class="fas fa-save me-1"></i>Create Album</button>
                </div>
            </form>
        </div>
    </div>
</div>
