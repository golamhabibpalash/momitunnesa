@model List<School.Application.DTOs.Gallery.GalleryAlbumDto>
@{
    ViewData["Title"] = "Photo Albums";
    ViewBag.ActiveMenu = "Albums";
}

<div class="page-header">
    <div>
        <h2><i class="fas fa-folder me-2"></i>Photo Albums</h2>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-area="Admin" asp-controller="Dashboard" asp-action="Index">Dashboard</a></li>
                <li class="breadcrumb-item active" aria-current="page">Albums</li>
            </ol>
        </nav>
    </div>
    <a asp-action="CreateAlbum" class="btn btn-primary"><i class="fas fa-plus me-1"></i>Create Album</a>
</div>

@if (!Model.Any())
{
    <div class="card"><div class="card-body text-center text-muted py-5">
        <i class="fas fa-images fa-3x mb-3"></i>
        <p class="mb-3">No albums yet.</p>
        <a asp-action="CreateAlbum" class="btn btn-primary"><i class="fas fa-plus me-1"></i>Create your first album</a>
    </div></div>
}
<div class="row g-3">
    @foreach (var album in Model)
    {
        <div class="col-sm-6 col-lg-4 col-xl-3">
            <div class="card h-100">
                <a asp-action="AlbumImages" asp-route-id="@album.Id" class="d-block" style="aspect-ratio:4/3;background:#f1f3f5;overflow:hidden;border-radius:.5rem .5rem 0 0;">
                    @if (!string.IsNullOrEmpty(album.CoverImageUrl))
                    {
                        <img src="@album.CoverImageUrl" alt="" style="width:100%;height:100%;object-fit:cover;">
                    }
                    else
                    {
                        <div class="h-100 d-flex align-items-center justify-content-center text-muted"><i class="far fa-image fa-3x"></i></div>
                    }
                </a>
                <div class="card-body d-flex flex-column">
                    <h6 class="mb-1 text-truncate" title="@album.TitleEn">@album.TitleEn</h6>
                    <small class="text-muted mb-2">
                        @album.ImageCount photo(s) •
                        @if (album.IsActive) { <span class="text-success">Active</span> } else { <span class="text-secondary">Hidden</span> }
                    </small>
                    <div class="mt-auto d-flex gap-1">
                        <a asp-action="AlbumImages" asp-route-id="@album.Id" class="btn btn-sm btn-primary flex-grow-1"><i class="fas fa-images me-1"></i>Photos</a>
                        <a asp-action="EditAlbum" asp-route-id="@album.Id" class="btn btn-sm btn-info" title="Edit album"><i class="fas fa-edit"></i></a>
                        <form asp-action="DeleteAlbum" asp-route-id="@album.Id" method="post" onsubmit="return confirm('Delete this album and hide all its photos?');">
                            <button type="submit" class="btn btn-sm btn-danger" title="Delete album"><i class="fas fa-trash"></i></button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    }
</div>
