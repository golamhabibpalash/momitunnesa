@{
    ViewData["Title"] = "Gallery Albums";
    ViewBag.ActiveMenu = "Albums";
}

<div class="page-header">
    <div>
        <h2><i class="fas fa-folder me-2"></i>Gallery Albums</h2>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-area="Admin" asp-controller="Dashboard" asp-action="Index">Dashboard</a></li>
                <li class="breadcrumb-item"><a asp-area="Admin" asp-controller="Gallery" asp-action="Albums">Gallery</a></li>
                <li class="breadcrumb-item active" aria-current="page">Albums</li>
            </ol>
        </nav>
    </div>
    <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#createAlbumModal">
        <i class="fas fa-plus me-1"></i>Create New Album
    </button>
</div>

<div class="row g-3">
    <div class="col-lg-4 col-md-6">
        <div class="album-card card">
            <div class="album-cover" style="background-image: url('https://placehold.co/600x400/667eea/white?text=School+Event');">
                <span class="album-count"><i class="fas fa-images me-1"></i>24</span>
            </div>
            <div class="album-body">
                <h6>Annual Sports Day 2026</h6>
                <small class="text-muted"><i class="far fa-calendar me-1"></i>Created: May 10, 2026</small>
                <div class="mt-2 d-flex gap-1">
                    <a asp-area="Admin" asp-controller="Gallery" asp-action="AlbumImages" asp-route-id="1" class="btn btn-sm btn-primary">
                        <i class="fas fa-eye"></i> View
                    </a>
                    <button class="btn btn-sm btn-outline-danger" onclick="confirmDelete('Delete this album?').then(r => { if(r.isConfirmed) { } })">
                        <i class="fas fa-trash"></i>
                    </button>
                </div>
            </div>
        </div>
    </div>
    <div class="col-lg-4 col-md-6">
        <div class="album-card card">
            <div class="album-cover" style="background-image: url('https://placehold.co/600x400/43e97b/white?text=Cultural+Program');">
                <span class="album-count"><i class="fas fa-images me-1"></i>18</span>
            </div>
            <div class="album-body">
                <h6>Cultural Program 2026</h6>
                <small class="text-muted"><i class="far fa-calendar me-1"></i>Created: Apr 05, 2026</small>
                <div class="mt-2 d-flex gap-1">
                    <a asp-area="Admin" asp-controller="Gallery" asp-action="AlbumImages" asp-route-id="2" class="btn btn-sm btn-primary">
                        <i class="fas fa-eye"></i> View
                    </a>
                    <button class="btn btn-sm btn-outline-danger"><i class="fas fa-trash"></i></button>
                </div>
            </div>
        </div>
    </div>
    <div class="col-lg-4 col-md-6">
        <div class="album-card card">
            <div class="album-cover" style="background-image: url('https://placehold.co/600x400/f6d365/white?text=Science+Fair');">
                <span class="album-count"><i class="fas fa-images me-1"></i>32</span>
            </div>
            <div class="album-body">
                <h6>Science Fair Exhibition</h6>
                <small class="text-muted"><i class="far fa-calendar me-1"></i>Created: Mar 15, 2026</small>
                <div class="mt-2 d-flex gap-1">
                    <a asp-area="Admin" asp-controller="Gallery" asp-action="AlbumImages" asp-route-id="3" class="btn btn-sm btn-primary">
                        <i class="fas fa-eye"></i> View
                    </a>
                    <button class="btn btn-sm btn-outline-danger"><i class="fas fa-trash"></i></button>
                </div>
            </div>
        </div>
    </div>
    <div class="col-lg-4 col-md-6">
        <div class="album-card card">
            <div class="album-cover" style="background-image: url('https://placehold.co/600x400/f093fb/white?text=Graduation');">
                <span class="album-count"><i class="fas fa-images me-1"></i>45</span>
            </div>
            <div class="album-body">
                <h6>Graduation Ceremony 2026</h6>
                <small class="text-muted"><i class="far fa-calendar me-1"></i>Created: Feb 28, 2026</small>
                <div class="mt-2 d-flex gap-1">
                    <a asp-area="Admin" asp-controller="Gallery" asp-action="AlbumImages" asp-route-id="4" class="btn btn-sm btn-primary">
                        <i class="fas fa-eye"></i> View
                    </a>
                    <button class="btn btn-sm btn-outline-danger"><i class="fas fa-trash"></i></button>
                </div>
            </div>
        </div>
    </div>
    <div class="col-lg-4 col-md-6">
        <div class="album-card card">
            <div class="album-cover" style="background-image: url('https://placehold.co/600x400/4facfe/white?text=Field+Trip');">
                <span class="album-count"><i class="fas fa-images me-1"></i>15</span>
            </div>
            <div class="album-body">
                <h6>Educational Field Trip</h6>
                <small class="text-muted"><i class="far fa-calendar me-1"></i>Created: Jan 20, 2026</small>
                <div class="mt-2 d-flex gap-1">
                    <a asp-area="Admin" asp-controller="Gallery" asp-action="AlbumImages" asp-route-id="5" class="btn btn-sm btn-primary">
                        <i class="fas fa-eye"></i> View
                    </a>
                    <button class="btn btn-sm btn-outline-danger"><i class="fas fa-trash"></i></button>
                </div>
            </div>
        </div>
    </div>
    <div class="col-lg-4 col-md-6">
        <div class="album-card card border-dashed" style="border:2px dashed #dee2e6;">
            <div class="album-body text-center py-4" style="cursor:pointer;" data-bs-toggle="modal" data-bs-target="#createAlbumModal">
                <i class="fas fa-plus-circle text-muted" style="font-size:3rem;"></i>
                <h6 class="text-muted mt-2">Create New Album</h6>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="createAlbumModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-area="Admin" asp-controller="Gallery" asp-action="CreateAlbum" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h5 class="modal-title"><i class="fas fa-folder-plus me-2"></i>Create New Album</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label required">Album Title (English)</label>
                        <input type="text" name="TitleEn" class="form-control" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label required">Album Title (Bangla)</label>
                        <input type="text" name="TitleBn" class="form-control" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Description</label>
                        <textarea name="Description" class="form-control" rows="3"></textarea>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Cover Image</label>
                        <input type="file" name="CoverImage" class="form-control" accept="image/*">
                    </div>
                    <div class="mb-3">
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" role="switch" id="albumActive" name="IsActive" value="true" checked>
                            <label class="form-check-label" for="albumActive">Active</label>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary"><i class="fas fa-save me-1"></i>Create Album</button>
                </div>
            </form>
        </div>
    </div>
</div>
