@model School.Application.DTOs.Gallery.GalleryVideoCreateDto
@{
    ViewData["Title"] = "Add Video";
    ViewBag.ActiveMenu = "Videos";
}

<div class="page-header">
    <div>
        <h2><i class="fas fa-video me-2"></i>Add Video</h2>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-area="Admin" asp-controller="Dashboard" asp-action="Index">Dashboard</a></li>
                <li class="breadcrumb-item"><a asp-area="Admin" asp-controller="Gallery" asp-action="Videos">Videos</a></li>
                <li class="breadcrumb-item active" aria-current="page">Add</li>
            </ol>
        </nav>
    </div>
    <a asp-area="Admin" asp-controller="Gallery" asp-action="Videos" class="btn btn-outline-secondary">
        <i class="fas fa-arrow-left me-1"></i>Back to Videos
    </a>
</div>

<form asp-area="Admin" asp-controller="Gallery" asp-action="CreateVideo" method="post">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

    <div class="card mb-3">
        <div class="card-header"><i class="fas fa-info-circle me-2"></i>Video Information</div>
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="TitleEn" class="form-label required">Title (English)</label>
                    <input asp-for="TitleEn" class="form-control" required>
                    <span asp-validation-for="TitleEn" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="TitleBn" class="form-label required">Title (Bangla)</label>
                    <input asp-for="TitleBn" class="form-control" required>
                    <span asp-validation-for="TitleBn" class="text-danger"></span>
                </div>
            </div>
            <div class="mt-3">
                <label asp-for="YouTubeUrl" class="form-label required">YouTube URL</label>
                <input asp-for="YouTubeUrl" type="url" class="form-control" placeholder="https://youtube.com/watch?v=..." required>
                <span asp-validation-for="YouTubeUrl" class="text-danger"></span>
            </div>
            <div class="mt-3">
                <label asp-for="ThumbnailUrl" class="form-label">Thumbnail URL</label>
                <input asp-for="ThumbnailUrl" class="form-control" placeholder="/uploads/gallery/thumb.jpg">
            </div>
            <div class="mt-3">
                <label asp-for="Description" class="form-label">Description</label>
                <textarea asp-for="Description" class="form-control" rows="2"></textarea>
            </div>
            <div class="row g-3 mt-1">
                <div class="col-md-4">
                    <label asp-for="SortOrder" class="form-label">Display Order</label>
                    <input asp-for="SortOrder" type="number" class="form-control" value="0" min="0">
                </div>
            </div>
            <div class="mt-3">
                <div class="form-check form-switch">
                    <input asp-for="IsActive" class="form-check-input" role="switch" checked>
                    <label asp-for="IsActive" class="form-check-label">Published</label>
                </div>
            </div>
        </div>
    </div>

    <div class="d-flex justify-content-end gap-2">
        <a asp-area="Admin" asp-controller="Gallery" asp-action="Videos" class="btn btn-outline-secondary">Cancel</a>
        <button type="submit" class="btn btn-primary px-4"><i class="fas fa-save me-1"></i>Add Video</button>
    </div>
</form>
