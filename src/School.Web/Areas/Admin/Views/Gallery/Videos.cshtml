@model List<School.Application.DTOs.Gallery.GalleryVideoDto>
@{
    ViewData["Title"] = "Videos";
    ViewBag.ActiveMenu = "Videos";
}

<div class="page-header">
    <div>
        <h2><i class="fas fa-video me-2"></i>Videos</h2>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-area="Admin" asp-controller="Dashboard" asp-action="Index">Dashboard</a></li>
                <li class="breadcrumb-item active" aria-current="page">Videos</li>
            </ol>
        </nav>
    </div>
    <a asp-action="CreateVideo" class="btn btn-primary"><i class="fas fa-plus me-1"></i>Add Video</a>
</div>

<div class="card">
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-hover table-datatable">
                <thead>
                    <tr>
                        <th>Order</th>
                        <th>Preview</th>
                        <th>Title</th>
                        <th>Source</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var video in Model)
                    {
                        var thumb = VideoHelper.GetThumbnail(video.YouTubeUrl, video.ThumbnailUrl);
                        <tr>
                            <td>@video.SortOrder</td>
                            <td>
                                @if (thumb is not null)
                                {
                                    <img src="@thumb" alt="" style="width:96px;height:54px;object-fit:cover;border-radius:4px;">
                                }
                                else
                                {
                                    <div class="bg-dark text-white d-flex align-items-center justify-content-center" style="width:96px;height:54px;border-radius:4px;"><i class="fas fa-play"></i></div>
                                }
                            </td>
                            <td>@video.TitleEn<br><small class="text-muted">@video.TitleBn</small></td>
                            <td>
                                @if (VideoHelper.IsUploadedFile(video.YouTubeUrl))
                                {
                                    <span class="badge bg-secondary"><i class="fas fa-file-video me-1"></i>Uploaded file</span>
                                }
                                else
                                {
                                    <a href="@video.YouTubeUrl" target="_blank" rel="noopener"><i class="fab fa-youtube text-danger me-1"></i>YouTube</a>
                                }
                            </td>
                            <td>@if (video.IsActive) { <span class="badge bg-success">Published</span> } else { <span class="badge bg-secondary">Hidden</span> }</td>
                            <td>
                                <div class="table-actions d-flex gap-1">
                                    <a asp-action="EditVideo" asp-route-id="@video.Id" class="btn btn-sm btn-info" title="Edit"><i class="fas fa-edit"></i></a>
                                    <form asp-action="DeleteVideo" asp-route-id="@video.Id" method="post" onsubmit="return confirm('Delete this video?');">
                                        <button type="submit" class="btn btn-sm btn-danger" title="Delete"><i class="fas fa-trash"></i></button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
