@model School.Application.DTOs.Dashboard.DashboardDto
@{
    ViewData["Title"] = "Dashboard";
    ViewBag.ActiveMenu = "Dashboard";
}

<div class="page-header">
    <div>
        <h2><i class="fas fa-chart-pie me-2"></i>Dashboard</h2>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-area="Admin" asp-controller="Dashboard" asp-action="Index">Admin</a></li>
                <li class="breadcrumb-item active" aria-current="page">Dashboard</li>
            </ol>
        </nav>
    </div>
    <div class="d-flex gap-2">
        <span class="text-muted small"><i class="far fa-calendar-alt me-1"></i>@DateTime.Now.ToString("dddd, MMMM dd, yyyy")</span>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-xl-3 col-lg-6 col-md-6 col-sm-6">
        <div class="stat-card bg-gradient-primary position-relative overflow-hidden">
            <i class="fas fa-eye stat-icon"></i>
            <div class="stat-value">@Model.TotalVisitors.ToString("N0")</div>
            <div class="stat-label">Total Visitors</div>
            <small class="opacity-75">@Model.VisitorsThisMonth.ToString("N0") this month</small>
        </div>
    </div>
    <div class="col-xl-3 col-lg-6 col-md-6 col-sm-6">
        <div class="stat-card bg-gradient-success position-relative overflow-hidden" style="color:#1a1d29;">
            <i class="fas fa-chalkboard-teacher stat-icon"></i>
            <div class="stat-value">@Model.TotalTeachers.ToString("N0")</div>
            <div class="stat-label">Teachers</div>
        </div>
    </div>
    <div class="col-xl-3 col-lg-6 col-md-6 col-sm-6">
        <div class="stat-card bg-gradient-warning position-relative overflow-hidden" style="color:#1a1d29;">
            <i class="fas fa-users stat-icon"></i>
            <div class="stat-value">@Model.TotalStaff.ToString("N0")</div>
            <div class="stat-label">Staff Members</div>
        </div>
    </div>
    <div class="col-xl-3 col-lg-6 col-md-6 col-sm-6">
        <div class="stat-card bg-gradient-info position-relative overflow-hidden" style="color:#1a1d29;">
            <i class="fas fa-bullhorn stat-icon"></i>
            <div class="stat-value">@Model.TotalNotices.ToString("N0")</div>
            <div class="stat-label">Notices</div>
        </div>
    </div>
    <div class="col-xl-3 col-lg-6 col-md-6 col-sm-6">
        <div class="stat-card bg-gradient-danger position-relative overflow-hidden">
            <i class="fas fa-newspaper stat-icon"></i>
            <div class="stat-value">@Model.TotalNews.ToString("N0")</div>
            <div class="stat-label">News Articles</div>
        </div>
    </div>
    <div class="col-xl-3 col-lg-6 col-md-6 col-sm-6">
        <div class="stat-card bg-gradient-primary position-relative overflow-hidden">
            <i class="fas fa-images stat-icon"></i>
            <div class="stat-value">@Model.TotalGalleryImages.ToString("N0")</div>
            <div class="stat-label">Gallery Images</div>
            <small class="opacity-75">Across @Model.TotalGalleryAlbums.ToString("N0") album@(Model.TotalGalleryAlbums == 1 ? "" : "s")</small>
        </div>
    </div>
    <div class="col-xl-3 col-lg-6 col-md-6 col-sm-6">
        <div class="stat-card bg-gradient-success position-relative overflow-hidden" style="color:#1a1d29;">
            <i class="fas fa-download stat-icon"></i>
            <div class="stat-value">@Model.TotalDownloads.ToString("N0")</div>
            <div class="stat-label">Downloadable Files</div>
        </div>
    </div>
    <div class="col-xl-3 col-lg-6 col-md-6 col-sm-6">
        <div class="stat-card bg-gradient-dark position-relative overflow-hidden">
            <i class="fas fa-user-graduate stat-icon"></i>
            <div class="stat-value">@Model.TotalStudents.ToString("N0")</div>
            <div class="stat-label">Students</div>
        </div>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-lg-8">
        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span><i class="fas fa-chart-bar me-2"></i>Monthly Visitors</span>
                <span class="badge bg-secondary">@Model.ChartYear</span>
            </div>
            <div class="card-body">
                @if (Model.MonthlyVisitors.Any(v => v > 0))
                {
                    <canvas id="visitorChart" height="300"></canvas>
                }
                else
                {
                    <div class="text-center text-muted py-5">
                        <i class="fas fa-chart-bar fa-2x d-block mb-2"></i>
                        No visits recorded for @Model.ChartYear yet.
                    </div>
                }
            </div>
        </div>
    </div>
    <div class="col-lg-4">
        <div class="card">
            <div class="card-header">
                <i class="fas fa-bolt me-2"></i>Quick Actions
            </div>
            <div class="card-body">
                <div class="d-grid gap-2">
                    <a asp-area="Admin" asp-controller="Page" asp-action="Create" class="btn btn-primary">
                        <i class="fas fa-plus me-2"></i>New Page
                    </a>
                    <a asp-area="Admin" asp-controller="Notice" asp-action="Create" class="btn btn-success">
                        <i class="fas fa-bullhorn me-2"></i>Publish Notice
                    </a>
                    <a asp-area="Admin" asp-controller="Event" asp-action="Create" class="btn btn-warning">
                        <i class="fas fa-calendar-plus me-2"></i>Add Event
                    </a>
                    <a asp-area="Admin" asp-controller="Media" asp-action="Index" class="btn btn-info">
                        <i class="fas fa-upload me-2"></i>Upload Media
                    </a>
                    <a asp-area="Admin" asp-controller="Slider" asp-action="Create" class="btn btn-outline-primary">
                        <i class="fas fa-images me-2"></i>Add Slider
                    </a>
                    <a asp-area="Admin" asp-controller="User" asp-action="Create" class="btn btn-outline-success">
                        <i class="fas fa-user-plus me-2"></i>Add User
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row g-3">
    <div class="col-12">
        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span><i class="fas fa-clock me-2"></i>Recent Activities</span>
                <span class="text-muted small">Latest @Model.RecentActivities.Count</span>
            </div>
            <div class="card-body p-0">
                @if (!Model.RecentActivities.Any())
                {
                    <div class="text-center text-muted py-5">
                        <i class="fas fa-clock fa-2x d-block mb-2"></i>
                        No activity has been recorded yet.
                    </div>
                }
                else
                {
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>User</th>
                                <th>Action</th>
                                <th>Details</th>
                                <th>When</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var activity in Model.RecentActivities)
                            {
                                var userName = string.IsNullOrWhiteSpace(activity.UserName) ? "System" : activity.UserName;
                                var badgeClass = activity.Action?.ToLowerInvariant() switch
                                {
                                    "create" or "created" => "bg-success",
                                    "update" or "updated" => "bg-info",
                                    "delete" or "deleted" => "bg-danger",
                                    "login" or "logout" => "bg-secondary",
                                    _ => "bg-primary"
                                };
                                <tr>
                                    <td>
                                        <div class="d-flex align-items-center gap-2">
                                            <span class="avatar-initials">@userName.Substring(0, 1).ToUpperInvariant()</span>
                                            <span>@userName</span>
                                        </div>
                                    </td>
                                    <td><span class="badge @badgeClass">@(activity.Action ?? "—")</span></td>
                                    <td>@(string.IsNullOrWhiteSpace(activity.Description) ? "—" : activity.Description)</td>
                                    <td><small title="@activity.Timestamp.ToString("g")">@activity.Timestamp.ToLocalTime().ToString("dd MMM yyyy, HH:mm")</small></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @if (Model.MonthlyVisitors.Any(v => v > 0))
    {
    <script>
        const ctx = document.getElementById('visitorChart').getContext('2d');
        new Chart(ctx, {
            type: 'bar',
            data: {
                labels: ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'],
                datasets: [{
                    label: 'Visitors @Model.ChartYear',
                    data: [@Html.Raw(string.Join(", ", Model.MonthlyVisitors))],
                    backgroundColor: [
                        'rgba(102, 126, 234, 0.7)',
                        'rgba(67, 233, 123, 0.7)',
                        'rgba(246, 211, 101, 0.7)',
                        'rgba(240, 147, 251, 0.7)',
                        'rgba(79, 172, 254, 0.7)',
                        'rgba(0, 242, 254, 0.7)',
                        'rgba(102, 126, 234, 0.7)',
                        'rgba(67, 233, 123, 0.7)',
                        'rgba(246, 211, 101, 0.7)',
                        'rgba(240, 147, 251, 0.7)',
                        'rgba(79, 172, 254, 0.7)',
                        'rgba(0, 242, 254, 0.7)'
                    ],
                    borderColor: [
                        'rgb(102, 126, 234)',
                        'rgb(67, 233, 123)',
                        'rgb(246, 211, 101)',
                        'rgb(240, 147, 251)',
                        'rgb(79, 172, 254)',
                        'rgb(0, 242, 254)',
                        'rgb(102, 126, 234)',
                        'rgb(67, 233, 123)',
                        'rgb(246, 211, 101)',
                        'rgb(240, 147, 251)',
                        'rgb(79, 172, 254)',
                        'rgb(0, 242, 254)'
                    ],
                    borderWidth: 2,
                    borderRadius: 6,
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: { display: false }
                },
                scales: {
                    y: {
                        beginAtZero: true,
                        ticks: {
                            callback: function(value) { return value.toLocaleString(); }
                        },
                        grid: {
                            color: 'rgba(0,0,0,0.05)'
                        }
                    },
                    x: {
                        grid: { display: false }
                    }
                }
            }
        });
    </script>
    }
}
