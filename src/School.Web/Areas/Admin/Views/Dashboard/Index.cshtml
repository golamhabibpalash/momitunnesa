@{
    ViewData["Title"] = "Dashboard";
    ViewBag.ActiveMenu = "Dashboard";
}

<div class="page-header">
    <div>
        <h2><i class="fas fa-chart-pie me-2"></i>Dashboard</h2>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-area="Admin" asp-controller="Dashboard" asp-action="Index">Admin</a></li>
                <li class="breadcrumb-item active" aria-current="page">Dashboard</li>
            </ol>
        </nav>
    </div>
    <div class="d-flex gap-2">
        <span class="text-muted small"><i class="far fa-calendar-alt me-1"></i>@DateTime.Now.ToString("dddd, MMMM dd, yyyy")</span>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-xl-3 col-lg-6 col-md-6 col-sm-6">
        <div class="stat-card bg-gradient-primary position-relative overflow-hidden">
            <i class="fas fa-eye stat-icon"></i>
            <div class="stat-value">45,254</div>
            <div class="stat-label"><i class="fas fa-arrow-up me-1"></i>Total Visitors</div>
            <small class="opacity-75">+12.5% from last month</small>
        </div>
    </div>
    <div class="col-xl-3 col-lg-6 col-md-6 col-sm-6">
        <div class="stat-card bg-gradient-success position-relative overflow-hidden" style="color:#1a1d29;">
            <i class="fas fa-chalkboard-teacher stat-icon"></i>
            <div class="stat-value">128</div>
            <div class="stat-label"><i class="fas fa-arrow-up me-1"></i>Teachers</div>
            <small class="opacity-75">+3 this semester</small>
        </div>
    </div>
    <div class="col-xl-3 col-lg-6 col-md-6 col-sm-6">
        <div class="stat-card bg-gradient-warning position-relative overflow-hidden" style="color:#1a1d29;">
            <i class="fas fa-users stat-icon"></i>
            <div class="stat-value">64</div>
            <div class="stat-label"><i class="fas fa-arrow-up me-1"></i>Staff Members</div>
            <small class="opacity-75">Full time &amp; part time</small>
        </div>
    </div>
    <div class="col-xl-3 col-lg-6 col-md-6 col-sm-6">
        <div class="stat-card bg-gradient-info position-relative overflow-hidden" style="color:#1a1d29;">
            <i class="fas fa-bullhorn stat-icon"></i>
            <div class="stat-value">56</div>
            <div class="stat-label">Notices Published</div>
            <small class="opacity-75">12 featured notices</small>
        </div>
    </div>
    <div class="col-xl-3 col-lg-6 col-md-6 col-sm-6">
        <div class="stat-card bg-gradient-danger position-relative overflow-hidden">
            <i class="fas fa-newspaper stat-icon"></i>
            <div class="stat-value">89</div>
            <div class="stat-label">News Articles</div>
            <small class="opacity-75">24 published this month</small>
        </div>
    </div>
    <div class="col-xl-3 col-lg-6 col-md-6 col-sm-6">
        <div class="stat-card bg-gradient-primary position-relative overflow-hidden">
            <i class="fas fa-images stat-icon"></i>
            <div class="stat-value">1,247</div>
            <div class="stat-label">Gallery Images</div>
            <small class="opacity-75">Across 32 albums</small>
        </div>
    </div>
    <div class="col-xl-3 col-lg-6 col-md-6 col-sm-6">
        <div class="stat-card bg-gradient-success position-relative overflow-hidden" style="color:#1a1d29;">
            <i class="fas fa-download stat-icon"></i>
            <div class="stat-value">3,521</div>
            <div class="stat-label">Downloads</div>
            <small class="opacity-75">+842 this month</small>
        </div>
    </div>
    <div class="col-xl-3 col-lg-6 col-md-6 col-sm-6">
        <div class="stat-card bg-gradient-dark position-relative overflow-hidden">
            <i class="fas fa-user-graduate stat-icon"></i>
            <div class="stat-value">2,450</div>
            <div class="stat-label">Students</div>
            <small class="opacity-75">+150 new admissions</small>
        </div>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-lg-8">
        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span><i class="fas fa-chart-bar me-2"></i>Monthly Visitors</span>
                <div class="btn-group btn-group-sm">
                    <button type="button" class="btn btn-outline-secondary active">2026</button>
                    <button type="button" class="btn btn-outline-secondary">2025</button>
                </div>
            </div>
            <div class="card-body">
                <canvas id="visitorChart" height="300"></canvas>
            </div>
        </div>
    </div>
    <div class="col-lg-4">
        <div class="card">
            <div class="card-header">
                <i class="fas fa-bolt me-2"></i>Quick Actions
            </div>
            <div class="card-body">
                <div class="d-grid gap-2">
                    <a asp-area="Admin" asp-controller="Page" asp-action="Create" class="btn btn-primary">
                        <i class="fas fa-plus me-2"></i>New Page
                    </a>
                    <a asp-area="Admin" asp-controller="Notice" asp-action="Create" class="btn btn-success">
                        <i class="fas fa-bullhorn me-2"></i>Publish Notice
                    </a>
                    <a asp-area="Admin" asp-controller="Event" asp-action="Create" class="btn btn-warning">
                        <i class="fas fa-calendar-plus me-2"></i>Add Event
                    </a>
                    <a asp-area="Admin" asp-controller="Media" asp-action="Index" class="btn btn-info">
                        <i class="fas fa-upload me-2"></i>Upload Media
                    </a>
                    <a asp-area="Admin" asp-controller="Slider" asp-action="Create" class="btn btn-outline-primary">
                        <i class="fas fa-images me-2"></i>Add Slider
                    </a>
                    <a asp-area="Admin" asp-controller="User" asp-action="Create" class="btn btn-outline-success">
                        <i class="fas fa-user-plus me-2"></i>Add User
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row g-3">
    <div class="col-12">
        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span><i class="fas fa-clock me-2"></i>Recent Activities</span>
                <a href="#" class="btn btn-sm btn-outline-primary">View All</a>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>User</th>
                                <th>Action</th>
                                <th>Item</th>
                                <th>Date</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        <img src="https://ui-avatars.com/api/?name=Admin&background=667eea&color=fff&size=32" class="avatar-sm">
                                        <span>Admin</span>
                                    </div>
                                </td>
                                <td>Created</td>
                                <td>Notice: "Summer Vacation 2026"</td>
                                <td><small>2 hours ago</small></td>
                                <td><span class="badge bg-success">Published</span></td>
                            </tr>
                            <tr>
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        <img src="https://ui-avatars.com/api/?name=Moderator&background=43e97b&color=fff&size=32" class="avatar-sm">
                                        <span>Moderator</span>
                                    </div>
                                </td>
                                <td>Updated</td>
                                <td>Page: "About Us"</td>
                                <td><small>5 hours ago</small></td>
                                <td><span class="badge bg-info">Draft</span></td>
                            </tr>
                            <tr>
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        <img src="https://ui-avatars.com/api/?name=Editor&background=f6d365&color=fff&size=32" class="avatar-sm">
                                        <span>Editor</span>
                                    </div>
                                </td>
                                <td>Uploaded</td>
                                <td>8 images to "Annual Sports Day"</td>
                                <td><small>1 day ago</small></td>
                                <td><span class="badge bg-success">Published</span></td>
                            </tr>
                            <tr>
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        <img src="https://ui-avatars.com/api/?name=Admin&background=667eea&color=fff&size=32" class="avatar-sm">
                                        <span>Admin</span>
                                    </div>
                                </td>
                                <td>Deleted</td>
                                <td>User: "testuser@email.com"</td>
                                <td><small>2 days ago</small></td>
                                <td><span class="badge bg-danger">Deleted</span></td>
                            </tr>
                            <tr>
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        <img src="https://ui-avatars.com/api/?name=Manager&background=f093fb&color=fff&size=32" class="avatar-sm">
                                        <span>Manager</span>
                                    </div>
                                </td>
                                <td>Updated</td>
                                <td>Settings: School Information</td>
                                <td><small>3 days ago</small></td>
                                <td><span class="badge bg-success">Saved</span></td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const ctx = document.getElementById('visitorChart').getContext('2d');
        new Chart(ctx, {
            type: 'bar',
            data: {
                labels: ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'],
                datasets: [{
                    label: 'Visitors 2026',
                    data: [3200, 2800, 4100, 3800, 5200, 4800, 6100, 5500, 4900, 5800, 6300, 5900],
                    backgroundColor: [
                        'rgba(102, 126, 234, 0.7)',
                        'rgba(67, 233, 123, 0.7)',
                        'rgba(246, 211, 101, 0.7)',
                        'rgba(240, 147, 251, 0.7)',
                        'rgba(79, 172, 254, 0.7)',
                        'rgba(0, 242, 254, 0.7)',
                        'rgba(102, 126, 234, 0.7)',
                        'rgba(67, 233, 123, 0.7)',
                        'rgba(246, 211, 101, 0.7)',
                        'rgba(240, 147, 251, 0.7)',
                        'rgba(79, 172, 254, 0.7)',
                        'rgba(0, 242, 254, 0.7)'
                    ],
                    borderColor: [
                        'rgb(102, 126, 234)',
                        'rgb(67, 233, 123)',
                        'rgb(246, 211, 101)',
                        'rgb(240, 147, 251)',
                        'rgb(79, 172, 254)',
                        'rgb(0, 242, 254)',
                        'rgb(102, 126, 234)',
                        'rgb(67, 233, 123)',
                        'rgb(246, 211, 101)',
                        'rgb(240, 147, 251)',
                        'rgb(79, 172, 254)',
                        'rgb(0, 242, 254)'
                    ],
                    borderWidth: 2,
                    borderRadius: 6,
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: { display: false }
                },
                scales: {
                    y: {
                        beginAtZero: true,
                        ticks: {
                            callback: function(value) { return value.toLocaleString(); }
                        },
                        grid: {
                            color: 'rgba(0,0,0,0.05)'
                        }
                    },
                    x: {
                        grid: { display: false }
                    }
                }
            }
        });
    </script>
}
