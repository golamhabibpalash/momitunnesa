@model List<NewsDto>
@{
    ViewData["Title"] = "News";
    ViewBag.ActiveMenu = "News";
    var sl = 0;
}

<div class="page-header">
    <div>
        <h2><i class="fas fa-newspaper me-2"></i>News</h2>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-area="Admin" asp-controller="Dashboard" asp-action="Index">Dashboard</a></li>
                <li class="breadcrumb-item active" aria-current="page">News</li>
            </ol>
        </nav>
    </div>
    <a asp-area="Admin" asp-controller="News" asp-action="Create" class="btn btn-primary">
        <i class="fas fa-plus me-1"></i>Add News
    </a>
</div>

<div class="card">
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-hover table-datatable">
                <thead>
                    <tr>
                        <th>SL</th>
                        <th>Image</th>
                        <th>Title</th>
                        <th>Category</th>
                        <th>Featured</th>
                        <th>Status</th>
                        <th>Publish Date</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        sl++;
                        <tr>
                            <td>@sl</td>
                            <td>
                                @if (!string.IsNullOrEmpty(item.ImageUrl))
                                {
                                    <img src="@item.ImageUrl" class="preview-img" alt="" style="width:60px;height:40px;object-fit:cover;border-radius:4px;">
                                }
                                else
                                {
                                    <span class="text-muted"><i class="far fa-image"></i></span>
                                }
                            </td>
                            <td>@item.TitleEn</td>
                            <td><span class="badge bg-info">@(CategoryHelper.Label<NewsCategory>(item.Category))</span></td>
                            <td>@if (item.IsFeatured) { <i class="fas fa-star text-warning"></i> } else { <i class="far fa-star text-muted"></i> }</td>
                            <td>
                                @if (item.IsActive)
                                {
                                    <span class="badge bg-success">Published</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Draft</span>
                                }
                            </td>
                            <td data-order="@item.PublishDate.Ticks">@item.PublishDate.ToString("MMM dd, yyyy")</td>
                            <td>
                                <div class="table-actions d-flex gap-1">
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-info" title="Edit"><i class="fas fa-edit"></i></a>
                                    <a asp-area="" asp-controller="News" asp-action="Details" asp-route-id="@item.Id" target="_blank" class="btn btn-sm btn-outline-secondary" title="View on website"><i class="fas fa-eye"></i></a>
                                    <form asp-action="Delete" asp-route-id="@item.Id" method="post" onsubmit="return confirm('Delete this news article?');">
                                        <button type="submit" class="btn btn-sm btn-danger" title="Delete"><i class="fas fa-trash"></i></button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
