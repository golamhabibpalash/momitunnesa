@using School.Application.DTOs.Account
@model LoginDto
@{
    Layout = null;
    ViewData["Title"] = "Login";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Login - Admin Panel</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body { font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; }
        .login-page {
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            padding: 20px;
            position: relative;
            overflow: hidden;
        }
        .login-page::before {
            content: '';
            position: absolute;
            top: -50%;
            left: -50%;
            width: 200%;
            height: 200%;
            background: radial-gradient(circle, rgba(255,255,255,0.05) 0%, transparent 70%);
            animation: pulse 8s ease-in-out infinite;
        }
        @@keyframes pulse {
            0%, 100% { transform: scale(1); opacity: 0.5; }
            50% { transform: scale(1.1); opacity: 0.8; }
        }
        .login-card {
            background: #fff;
            border-radius: 20px;
            padding: 45px 40px 35px;
            width: 100%;
            max-width: 420px;
            box-shadow: 0 25px 80px rgba(0,0,0,0.3);
            position: relative;
            z-index: 1;
        }
        .login-logo { text-align: center; margin-bottom: 30px; }
        .login-logo .logo-icon {
            width: 80px; height: 80px;
            background: linear-gradient(135deg, #667eea, #764ba2);
            border-radius: 20px;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 15px;
            font-size: 2rem;
            color: #fff;
            box-shadow: 0 10px 30px rgba(102,126,234,0.3);
        }
        .login-logo h3 { font-weight: 700; color: #333; margin-bottom: 5px; }
        .login-logo p { color: #6c757d; font-size: 0.9rem; margin: 0; }
        .form-floating { margin-bottom: 15px; }
        .form-floating > .form-control:focus { border-color: #667eea; box-shadow: 0 0 0 3px rgba(102,126,234,0.15); }
        .form-floating > label { color: #6c757d; }
        .btn-login {
            width: 100%;
            padding: 12px;
            font-weight: 600;
            background: linear-gradient(135deg, #667eea, #764ba2);
            border: none;
            border-radius: 10px;
            color: #fff;
            font-size: 1rem;
            transition: all 0.3s;
            margin-top: 5px;
        }
        .btn-login:hover {
            transform: translateY(-2px);
            box-shadow: 0 10px 30px rgba(102,126,234,0.4);
            color: #fff;
        }
        .login-footer { text-align: center; margin-top: 20px; color: #6c757d; font-size: 0.85rem; }
        .login-footer a { color: #667eea; text-decoration: none; font-weight: 500; }
        .login-footer a:hover { text-decoration: underline; }
        .password-toggle {
            position: absolute;
            right: 15px;
            top: 50%;
            transform: translateY(-50%);
            background: none;
            border: none;
            color: #6c757d;
            cursor: pointer;
            z-index: 10;
        }
        .password-toggle:hover { color: #333; }
        .form-check-label { font-size: 0.9rem; color: #6c757d; }
        .divider { display: flex; align-items: center; color: #6c757d; font-size: 0.85rem; margin: 20px 0; }
        .divider::before, .divider::after { content: ''; flex: 1; border-top: 1px solid #dee2e6; }
        .divider::before { margin-right: 15px; }
        .divider::after { margin-left: 15px; }
        @@media (max-width: 480px) {
            .login-card { padding: 30px 20px; }
        }
    </style>
</head>
<body>
    <div class="login-page">
        <div class="login-card animate__animated animate__fadeIn">
            <div class="login-logo">
                <div class="logo-icon">
                    <i class="fas fa-school"></i>
                </div>
                <h3>Momitunnesa School</h3>
                <p>Admin Panel Login</p>
            </div>

            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show d-flex align-items-center" role="alert">
                    <i class="fas fa-exclamation-circle me-2"></i>
                    @TempData["Error"]
                    <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert"></button>
                </div>
            }

            <form asp-area="Admin" asp-controller="Account" asp-action="Login" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="ReturnUrl" value="@Context.Request.Query["ReturnUrl"]" />

                <div class="form-floating">
                    <input type="email" name="Email" class="form-control" id="emailInput" placeholder="name@example.com" required autofocus>
                    <label for="emailInput"><i class="fas fa-envelope me-2"></i>Email Address</label>
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>

                <div class="form-floating position-relative">
                    <input type="password" name="Password" class="form-control" id="passwordInput" placeholder="Password" required>
                    <label for="passwordInput"><i class="fas fa-lock me-2"></i>Password</label>
                    <button type="button" class="password-toggle" onclick="togglePassword()" tabindex="-1">
                        <i class="fas fa-eye" id="passwordToggle"></i>
                    </button>
                    <span asp-validation-for="Password" class="text-danger small"></span>
                </div>

                <div class="d-flex justify-content-between align-items-center mb-3">
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="rememberMe" name="RememberMe" value="true">
                        <label class="form-check-label" for="rememberMe">Remember me</label>
                    </div>
                    <a href="#" class="text-decoration-none small">Forgot password?</a>
                </div>

                <button type="submit" class="btn-login">
                    <i class="fas fa-sign-in-alt me-2"></i>Sign In
                </button>
            </form>

            <div class="divider">or</div>

            <div class="d-flex justify-content-center gap-3">
                <a href="#" class="text-decoration-none text-muted small">
                    <i class="fas fa-question-circle me-1"></i>Need Help?
                </a>
            </div>

            <div class="login-footer">
                &copy; @DateTime.Now.Year Momitunnesa School. All rights reserved.
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css" />
    <script>
        function togglePassword() {
            const input = document.getElementById('passwordInput');
            const toggle = document.getElementById('passwordToggle');
            if (input.type === 'password') {
                input.type = 'text';
                toggle.classList.remove('fa-eye');
                toggle.classList.add('fa-eye-slash');
            } else {
                input.type = 'password';
                toggle.classList.remove('fa-eye-slash');
                toggle.classList.add('fa-eye');
            }
        }
    </script>
</body>
</html>
