@model List<School.Application.Services.Interfaces.MenuDto>
@{
    ViewData["Title"] = "Menus";
    ViewBag.ActiveMenu = "Menus";
}

<div class="page-header">
    <div>
        <h2><i class="fas fa-bars me-2"></i>Menu Management</h2>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-area="Admin" asp-controller="Dashboard" asp-action="Index">Dashboard</a></li>
                <li class="breadcrumb-item active" aria-current="page">Menus</li>
            </ol>
        </nav>
    </div>
    <a asp-area="Admin" asp-controller="Menu" asp-action="Create" class="btn btn-primary">
        <i class="fas fa-plus me-1"></i>Create New Menu
    </a>
</div>

<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <span><i class="fas fa-sitemap me-2"></i>All Menus</span>
        <button class="btn btn-sm btn-outline-success" id="saveOrderBtn" onclick="saveMenuOrder()">
            <i class="fas fa-save me-1"></i>Save Order
        </button>
    </div>
    <div class="card-body">
        <div class="alert alert-info d-flex align-items-center" role="alert">
            <i class="fas fa-arrows-alt me-2"></i>
            <span>Drag and drop menu items to reorder them.</span>
        </div>

        <div id="menuTree" class="sortable-menu list-group">
            @if (Model != null && Model.Any())
            {
                await RenderMenu(Model, 0);
            }
            else
            {
                <div class="text-center text-muted py-4">No menu items found.</div>
            }
        </div>
    </div>
</div>

@{
    async Task RenderMenu(List<School.Application.Services.Interfaces.MenuDto> items, int depth)
    {
        foreach (var item in items)
        {
            <div class="list-group-item menu-item d-flex justify-content-between align-items-center" data-id="@item.Id" data-parent-id="@(item.ParentMenuId?.ToString() ?? "")" data-sort-order="@item.SortOrder" style="padding-left: @(20 + depth * 30)px;">
                <div class="d-flex align-items-center gap-3">
                    <i class="fas fa-grip-vertical text-muted menu-handle" style="cursor:grab;"></i>
                    @if (!string.IsNullOrEmpty(item.Icon))
                    {
                        <i class="@item.Icon"></i>
                    }
                    else
                    {
                        <i class="fas fa-circle text-muted" style="font-size:8px;"></i>
                    }
                    <div>
                        <strong>@item.Title</strong>
                        <small class="text-muted ms-2">@item.Url</small>
                    </div>
                </div>
                <div class="d-flex gap-1 align-items-center">
                    <span class="badge bg-@(item.IsExternal ? "secondary" : "info") me-2">@item.MenuType</span>
                    <span class="badge bg-@(item.IsActive ? "success" : "secondary") me-2">@(item.IsActive ? "Active" : "Inactive")</span>
                    <a asp-area="Admin" asp-controller="Menu" asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary"><i class="fas fa-edit"></i></a>
                    <form asp-area="Admin" asp-controller="Menu" asp-action="Delete" asp-route-id="@item.Id" method="post" style="display:inline" onsubmit="return confirm('Delete this menu item?');">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-sm btn-outline-danger"><i class="fas fa-trash"></i></button>
                    </form>
                </div>
            </div>
            if (item.Children != null && item.Children.Any())
            {
                await RenderMenu(item.Children, depth + 1);
            }
        }
    }
}

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sortablejs@1.15.0/Sortable.min.js"></script>
    <script>
        new Sortable(document.getElementById('menuTree'), {
            animation: 150,
            handle: '.menu-handle',
            ghostClass: 'sortable-placeholder',
            onEnd: function() {
                showToast('Menu order updated. Click "Save Order" to persist.', 'info');
            }
        });

        function saveMenuOrder() {
            const btn = document.getElementById('saveOrderBtn');
            btn.disabled = true;
            btn.innerHTML = '<i class="fas fa-spinner fa-spin me-1"></i>Saving...';

            const items = [];
            document.querySelectorAll('.menu-item').forEach(function(el, index) {
                items.push({
                    id: parseInt(el.dataset.id),
                    parentMenuId: null,
                    sortOrder: index + 1
                });
            });

            const token = document.querySelector('input[name="__RequestVerificationToken"]');
            const headers = { 'Content-Type': 'application/json' };
            if (token) headers['RequestVerificationToken'] = token.value;

            fetch('@Url.Action("Reorder", "Menu", new { area = "Admin" })', {
                method: 'POST',
                headers: headers,
                body: JSON.stringify(items)
            })
            .then(r => r.json())
            .then(data => {
                if (data.success) {
                    showToast(data.message, 'success');
                } else {
                    showToast(data.message || 'Failed to save order.', 'error');
                }
            })
            .catch(() => {
                showToast('Failed to save order.', 'error');
            })
            .finally(() => {
                btn.disabled = false;
                btn.innerHTML = '<i class="fas fa-save me-1"></i>Save Order';
            });
        }
    </script>
}
