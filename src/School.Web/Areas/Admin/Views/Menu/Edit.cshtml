@model School.Application.Services.Interfaces.MenuUpdateDto
@{
    ViewData["Title"] = "Edit Menu Item";
    ViewBag.ActiveMenu = "Menus";
    var parentMenus = ViewBag.ParentMenus as List<School.Application.Services.Interfaces.MenuDto> ?? new();
}

<div class="page-header">
    <div>
        <h2><i class="fas fa-edit me-2"></i>Edit Menu Item</h2>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-area="Admin" asp-controller="Dashboard" asp-action="Index">Dashboard</a></li>
                <li class="breadcrumb-item"><a asp-area="Admin" asp-controller="Menu" asp-action="Index">Menus</a></li>
                <li class="breadcrumb-item active" aria-current="page">Edit</li>
            </ol>
        </nav>
    </div>
    <a asp-area="Admin" asp-controller="Menu" asp-action="Index" class="btn btn-outline-secondary">
        <i class="fas fa-arrow-left me-1"></i>Back to Menus
    </a>
</div>

<form asp-area="Admin" asp-controller="Menu" asp-action="Edit" asp-route-id="@Model.Id" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Id" />
    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

    <div class="row g-3">
        <div class="col-lg-8">
            <div class="card mb-3">
                <div class="card-header"><i class="fas fa-info-circle me-2"></i>Menu Item Details</div>
                <div class="card-body">
                    <div class="mb-3">
                        <label asp-for="Title" class="form-label required"></label>
                        <input asp-for="Title" class="form-control" required>
                        <span asp-validation-for="Title" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Url" class="form-label"></label>
                        <input asp-for="Url" class="form-control" placeholder="/about-us or https://example.com">
                    </div>
                    <div class="mb-3">
                        <label asp-for="MenuLocation" class="form-label"></label>
                        <select asp-for="MenuLocation" class="form-select" asp-items="Html.GetEnumSelectList<School.Domain.Enums.MenuLocation>()"></select>
                    </div>
                    <div class="mb-3">
                        <label asp-for="MenuType" class="form-label"></label>
                        <select asp-for="MenuType" class="form-select" asp-items="Html.GetEnumSelectList<School.Domain.Enums.MenuType>()"></select>
                    </div>
                    <div class="mb-3">
                        <label asp-for="ParentMenuId" class="form-label"></label>
                        <select asp-for="ParentMenuId" class="form-select">
                            <option value="">-- None (Top Level) --</option>
                            @foreach (var parent in parentMenus)
                            {
                                <option value="@parent.Id">@parent.Title</option>
                            }
                        </select>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Icon" class="form-label"></label>
                        <input asp-for="Icon" class="form-control" placeholder="fas fa-home">
                    </div>
                    <div class="mb-3">
                        <label asp-for="Controller" class="form-label"></label>
                        <input asp-for="Controller" class="form-control" placeholder="Home">
                    </div>
                    <div class="mb-3">
                        <label asp-for="Action" class="form-label"></label>
                        <input asp-for="Action" class="form-control" placeholder="Index">
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card mb-3">
                <div class="card-header"><i class="fas fa-cog me-2"></i>Settings</div>
                <div class="card-body">
                    <div class="mb-3">
                        <label asp-for="SortOrder" class="form-label"></label>
                        <input asp-for="SortOrder" class="form-control" type="number" min="1">
                    </div>
                    <div class="mb-3">
                        <div class="form-check form-switch">
                            <input asp-for="IsActive" class="form-check-input" role="switch" />
                            <label asp-for="IsActive" class="form-check-label"></label>
                        </div>
                    </div>
                    <div class="mb-3">
                        <div class="form-check form-switch">
                            <input asp-for="IsExternal" class="form-check-input" role="switch" />
                            <label asp-for="IsExternal" class="form-check-label"></label>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Target" class="form-label"></label>
                        <select asp-for="Target" class="form-select">
                            <option value="">Same Tab</option>
                            <option value="_blank">New Tab</option>
                        </select>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="d-flex justify-content-end gap-2 mt-3">
        <a asp-area="Admin" asp-controller="Menu" asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
        <button type="submit" class="btn btn-primary px-4">
            <i class="fas fa-save me-1"></i>Update Menu Item
        </button>
    </div>
</form>
