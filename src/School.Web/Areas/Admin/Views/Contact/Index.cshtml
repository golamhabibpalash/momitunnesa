@model IEnumerable<School.Application.DTOs.Contact.ContactMessageDto>
@{
    ViewData["Title"] = "Contact Messages";
    ViewBag.ActiveMenu = "Contact";
    var currentPage = ViewBag.CurrentPage as int? ?? 1;
    var totalPages = ViewBag.TotalPages as int? ?? 1;
}

<div class="page-header">
    <div>
        <h2><i class="fas fa-envelope me-2"></i>Contact Messages</h2>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-area="Admin" asp-controller="Dashboard" asp-action="Index">Dashboard</a></li>
                <li class="breadcrumb-item active" aria-current="page">Contact Messages</li>
            </ol>
        </nav>
    </div>
</div>

<div class="card">
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-hover table-datatable">
                <thead>
                    <tr>
                        <th>SL</th>
                        <th>Status</th>
                        <th>Name</th>
                        <th>Email</th>
                        <th>Subject</th>
                        <th>Message Preview</th>
                        <th>Date</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        var sl = (currentPage - 1) * 20 + 1;
                        foreach (var msg in Model)
                        {
                            <tr class="@(msg.IsRead ? "" : "table-primary")">
                                <td>@(sl++)</td>
                                <td>
                                    @if (msg.IsRead)
                                    {
                                        <span class="badge bg-success">Read</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning">Unread</span>
                                    }
                                </td>
                                <td>@msg.Name</td>
                                <td>@msg.Email</td>
                                <td>@msg.Subject</td>
                                <td class="text-truncate" style="max-width:200px;">@msg.Message</td>
                                <td>@msg.CreatedAt.ToString("MMM dd, yyyy")</td>
                                <td>
                                    <div class="table-actions">
                                        <a asp-area="Admin" asp-controller="Contact" asp-action="Details" asp-route-id="@msg.Id" class="btn btn-sm btn-primary"><i class="fas fa-eye"></i></a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="8" class="text-center text-muted py-4">No messages found.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        @if (totalPages > 1)
        {
            <nav class="mt-3">
                <ul class="pagination justify-content-center mb-0">
                    <li class="page-item @(currentPage <= 1 ? "disabled" : "")">
                        <a class="page-link" asp-area="Admin" asp-controller="Contact" asp-action="Index" asp-route-page="@(currentPage - 1)"><i class="fas fa-chevron-left"></i></a>
                    </li>
                    @for (int p = 1; p <= totalPages; p++)
                    {
                        <li class="page-item @(p == currentPage ? "active" : "")">
                            <a class="page-link" asp-area="Admin" asp-controller="Contact" asp-action="Index" asp-route-page="@p">@p</a>
                        </li>
                    }
                    <li class="page-item @(currentPage >= totalPages ? "disabled" : "")">
                        <a class="page-link" asp-area="Admin" asp-controller="Contact" asp-action="Index" asp-route-page="@(currentPage + 1)"><i class="fas fa-chevron-right"></i></a>
                    </li>
                </ul>
            </nav>
        }
    </div>
</div>
