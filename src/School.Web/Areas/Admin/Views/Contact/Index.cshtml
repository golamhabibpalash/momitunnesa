@model List<School.Application.DTOs.Contact.ContactMessageDto>
@{
    ViewData["Title"] = "Contact Messages";
    ViewBag.ActiveMenu = "Contact";
    var sl = 0;
}

<div class="page-header">
    <div>
        <h2><i class="fas fa-envelope me-2"></i>Contact Messages</h2>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-area="Admin" asp-controller="Dashboard" asp-action="Index">Dashboard</a></li>
                <li class="breadcrumb-item active" aria-current="page">Contact Messages</li>
            </ol>
        </nav>
    </div>
</div>

<div class="card">
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-hover table-datatable">
                <thead>
                    <tr>
                        <th>SL</th>
                        <th>Status</th>
                        <th>Name</th>
                        <th>Email</th>
                        <th>Subject</th>
                        <th>Message</th>
                        <th>Received</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var message in Model)
                    {
                        sl++;
                        <tr class="@(message.IsRead ? "" : "fw-semibold")">
                            <td>@sl</td>
                            <td>
                                @if (message.IsRead)
                                {
                                    <span class="badge bg-success">Read</span>
                                }
                                else
                                {
                                    <span class="badge bg-warning">Unread</span>
                                }
                            </td>
                            <td>@message.Name</td>
                            <td><a href="mailto:@message.Email">@message.Email</a></td>
                            <td>@message.Subject</td>
                            <td class="text-truncate" style="max-width:220px;">@message.Message</td>
                            <td data-order="@message.CreatedAt.Ticks">@message.CreatedAt.ToLocalTime().ToString("MMM dd, yyyy HH:mm")</td>
                            <td>
                                <div class="table-actions d-flex gap-1">
                                    <a asp-action="Details" asp-route-id="@message.Id" class="btn btn-sm btn-info" title="View"><i class="fas fa-eye"></i></a>
                                    <form asp-action="Delete" asp-route-id="@message.Id" method="post" onsubmit="return confirm('Delete this message?');">
                                        <button type="submit" class="btn btn-sm btn-danger" title="Delete"><i class="fas fa-trash"></i></button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
