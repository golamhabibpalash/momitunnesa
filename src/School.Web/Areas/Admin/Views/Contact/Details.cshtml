@{
    ViewData["Title"] = "Message Details";
    ViewBag.ActiveMenu = "Contact";
}

<div class="page-header">
    <div>
        <h2><i class="fas fa-envelope-open me-2"></i>Message Details</h2>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-area="Admin" asp-controller="Dashboard" asp-action="Index">Dashboard</a></li>
                <li class="breadcrumb-item"><a asp-area="Admin" asp-controller="Contact" asp-action="Index">Contact Messages</a></li>
                <li class="breadcrumb-item active" aria-current="page">Details</li>
            </ol>
        </nav>
    </div>
    <a asp-area="Admin" asp-controller="Contact" asp-action="Index" class="btn btn-outline-secondary">
        <i class="fas fa-arrow-left me-1"></i>Back to Messages
    </a>
</div>

<div class="row g-3">
    <div class="col-lg-8">
        <div class="card mb-3">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span><i class="fas fa-user me-2"></i>Sender Information</span>
                <span class="badge bg-warning">Unread</span>
            </div>
            <div class="card-body">
                <div class="d-flex align-items-center gap-3 mb-4">
                    <img src="https://ui-avatars.com/api/?name=John+Doe&background=667eea&color=fff&size=60" class="rounded-circle" style="width:60px;height:60px;">
                    <div>
                        <h5 class="mb-1">John Doe</h5>
                        <p class="text-muted mb-1"><i class="fas fa-envelope me-1"></i>john@example.com</p>
                        <p class="text-muted mb-0"><i class="fas fa-phone me-1"></i>+880 1712-345678</p>
                    </div>
                </div>
                <hr>
                <h5 class="mb-3">Subject: Admission Inquiry</h5>
                <div class="message-content p-3 bg-light rounded">
                    <p>Dear Sir/Madam,</p>
                    <p>I would like to know about the admission process for class 1 for the academic year 2027. My son is currently 5 years old and will be eligible for admission next year.</p>
                    <p>Could you please provide me with the following information:</p>
                    <ul>
                        <li>Admission schedule and important dates</li>
                        <li>Required documents for admission</li>
                        <li>Fee structure for class 1</li>
                        <li>Age eligibility criteria</li>
                    </ul>
                    <p>I would also like to know if there is any entrance test or interview for the admission process.</p>
                    <p>Thank you for your time and assistance.</p>
                    <p>Best regards,<br>John Doe</p>
                </div>
                <div class="mt-3 d-flex gap-2">
                    <small class="text-muted"><i class="far fa-calendar me-1"></i>Received: Jul 05, 2026 at 10:30 AM</small>
                    <small class="text-muted"><i class="fas fa-globe me-1"></i>IP: 103.123.45.67</small>
                </div>
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="card mb-3">
            <div class="card-header"><i class="fas fa-reply me-2"></i>Quick Reply</div>
            <div class="card-body">
                <form asp-area="Admin" asp-controller="Contact" asp-action="Reply" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="Id" value="1">
                    <div class="mb-3">
                        <label class="form-label">To</label>
                        <input type="text" class="form-control" value="John Doe &lt;john@example.com&gt;" readonly>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Subject</label>
                        <input type="text" name="Subject" class="form-control" value="Re: Admission Inquiry">
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Message</label>
                        <textarea name="Message" class="form-control" rows="8" placeholder="Type your reply here..."></textarea>
                    </div>
                    <button type="submit" class="btn btn-primary w-100">
                        <i class="fas fa-paper-plane me-1"></i>Send Reply
                    </button>
                </form>
            </div>
        </div>

        <div class="card">
            <div class="card-header"><i class="fas fa-tasks me-2"></i>Actions</div>
            <div class="card-body">
                <div class="d-grid gap-2">
                    <button class="btn btn-success"><i class="fas fa-check me-1"></i>Mark as Read</button>
                    <button class="btn btn-warning"><i class="fas fa-flag me-1"></i>Mark as Spam</button>
                    <button class="btn btn-outline-danger" onclick="confirmDelete().then(r => { if(r.isConfirmed){ } })">
                        <i class="fas fa-trash me-1"></i>Delete Message
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>
