@model School.Application.DTOs.Contact.ContactMessageDto
@{
    ViewData["Title"] = "Message Details";
    ViewBag.ActiveMenu = "Contact";
}

<div class="page-header">
    <div>
        <h2><i class="fas fa-envelope-open me-2"></i>Message Details</h2>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-area="Admin" asp-controller="Dashboard" asp-action="Index">Dashboard</a></li>
                <li class="breadcrumb-item"><a asp-area="Admin" asp-controller="Contact" asp-action="Index">Contact Messages</a></li>
                <li class="breadcrumb-item active" aria-current="page">Details</li>
            </ol>
        </nav>
    </div>
    <a asp-area="Admin" asp-controller="Contact" asp-action="Index" class="btn btn-outline-secondary">
        <i class="fas fa-arrow-left me-1"></i>Back to Messages
    </a>
</div>

<div class="row g-3">
    <div class="col-lg-8">
        <div class="card mb-3">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span><i class="fas fa-user me-2"></i>Sender Information</span>
                @if (Model.IsRead)
                {
                    <span class="badge bg-success">Read</span>
                }
                else
                {
                    <span class="badge bg-warning">Unread</span>
                }
            </div>
            <div class="card-body">
                <div class="mb-3">
                    <h5 class="mb-1">@Model.Name</h5>
                    <p class="text-muted mb-1"><i class="fas fa-envelope me-1"></i>@Model.Email</p>
                    @if (!string.IsNullOrEmpty(Model.Phone))
                    {
                        <p class="text-muted mb-0"><i class="fas fa-phone me-1"></i>@Model.Phone</p>
                    }
                </div>
                <hr>
                <h5 class="mb-3">Subject: @Model.Subject</h5>
                <div class="message-content p-3 bg-light rounded" style="white-space:pre-wrap;">@Model.Message</div>
                <div class="mt-3">
                    <small class="text-muted"><i class="far fa-calendar me-1"></i>Received: @Model.CreatedAt.ToString("MMM dd, yyyy 'at' hh:mm tt")</small>
                </div>
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="card">
            <div class="card-header"><i class="fas fa-tasks me-2"></i>Actions</div>
            <div class="card-body">
                <div class="d-grid gap-2">
                    @if (!Model.IsRead)
                    {
                        <form asp-area="Admin" asp-controller="Contact" asp-action="MarkAsRead" asp-route-id="@Model.Id" method="post">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-success w-100"><i class="fas fa-check me-1"></i>Mark as Read</button>
                        </form>
                    }
                    <a href="mailto:@Model.Email?subject=Re: @Model.Subject" class="btn btn-primary">
                        <i class="fas fa-reply me-1"></i>Reply by Email
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
