@model List<School.Application.DTOs.Achievement.AchievementDto>
@{
    ViewData["Title"] = "Achievements";
    ViewBag.ActiveMenu = "Achievements";
    var sl = 0;
}

<div class="page-header">
    <div>
        <h2><i class="fas fa-trophy me-2"></i>Achievements</h2>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-area="Admin" asp-controller="Dashboard" asp-action="Index">Dashboard</a></li>
                <li class="breadcrumb-item active" aria-current="page">Achievements</li>
            </ol>
        </nav>
    </div>
    <a asp-area="Admin" asp-controller="Achievement" asp-action="Create" class="btn btn-primary"><i class="fas fa-plus me-1"></i>Add Achievement</a>
</div>

<div class="row g-3 mb-3">
    @foreach (var c in Enum.GetValues<AchievementCategory>())
    {
        <div class="col">
            <div class="card text-center"><div class="card-body py-2">
                <div class="fs-4 fw-bold">@Model.Count(a => a.IsActive && a.AchievementCategory == c.ToString())</div>
                <small class="text-muted">@CategoryHelper.EnglishLabel(c)</small>
            </div></div>
        </div>
    }
</div>

<div class="card">
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-hover table-datatable">
                <thead>
                    <tr>
                        <th>SL</th>
                        <th>Title</th>
                        <th>Category</th>
                        <th>Date</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var a in Model)
                    {
                        sl++;
                        <tr>
                            <td>@sl</td>
                            <td>@a.TitleEn</td>
                            <td><span class="badge bg-info">@(Enum.TryParse<AchievementCategory>(a.AchievementCategory, out var cat) ? CategoryHelper.EnglishLabel(cat) : a.AchievementCategory)</span></td>
                            <td data-order="@a.Date.Ticks">@a.Date.ToString("MMM dd, yyyy")</td>
                            <td>@if (a.IsActive) { <span class="badge bg-success">Active</span> } else { <span class="badge bg-secondary">Inactive</span> }</td>
                            <td>
                                <div class="table-actions d-flex gap-1">
                                    <a asp-action="Edit" asp-route-id="@a.Id" class="btn btn-sm btn-info" title="Edit"><i class="fas fa-edit"></i></a>
                                    <form asp-action="Delete" asp-route-id="@a.Id" method="post" onsubmit="return confirm('Delete this achievement?');">
                                        <button type="submit" class="btn btn-sm btn-danger" title="Delete"><i class="fas fa-trash"></i></button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
