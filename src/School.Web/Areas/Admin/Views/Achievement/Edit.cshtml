@model School.Application.DTOs.Achievement.AchievementDto
@{
    ViewData["Title"] = "Edit Achievement";
    ViewBag.ActiveMenu = "Achievements";
    var achievementId = ViewBag.AchievementId as int? ?? Model.Id;
    var categories = new[] { "Student", "Teacher", "Institution", "Sports", "NationalAward" };
}

<div class="page-header">
    <div>
        <h2><i class="fas fa-edit me-2"></i>Edit Achievement</h2>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-area="Admin" asp-controller="Dashboard" asp-action="Index">Dashboard</a></li>
                <li class="breadcrumb-item"><a asp-area="Admin" asp-controller="Achievement" asp-action="Index">Achievements</a></li>
                <li class="breadcrumb-item active" aria-current="page">Edit</li>
            </ol>
        </nav>
    </div>
    <a asp-area="Admin" asp-controller="Achievement" asp-action="Index" class="btn btn-outline-secondary">
        <i class="fas fa-arrow-left me-1"></i>Back to Achievements
    </a>
</div>

<form asp-area="Admin" asp-controller="Achievement" asp-action="Edit" asp-route-id="@achievementId" method="post">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

    <div class="row g-3">
        <div class="col-lg-8">
            <div class="card mb-3">
                <div class="card-header"><i class="fas fa-info-circle me-2"></i>Achievement Details</div>
                <div class="card-body">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="TitleEn" class="form-label required">Title (English)</label>
                            <input asp-for="TitleEn" class="form-control" required>
                            <span asp-validation-for="TitleEn" class="text-danger"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="TitleBn" class="form-label required">Title (Bangla)</label>
                            <input asp-for="TitleBn" class="form-control" required>
                            <span asp-validation-for="TitleBn" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="mb-3 mt-3">
                        <label asp-for="DescriptionEn" class="form-label">Description (English)</label>
                        <textarea asp-for="DescriptionEn" class="form-control" rows="4"></textarea>
                    </div>
                    <div class="mb-3">
                        <label asp-for="DescriptionBn" class="form-label">Description (Bangla)</label>
                        <textarea asp-for="DescriptionBn" class="form-control" rows="4"></textarea>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card mb-3">
                <div class="card-header"><i class="fas fa-cog me-2"></i>Settings</div>
                <div class="card-body">
                    <div class="mb-3">
                        <label asp-for="AchievementCategory" class="form-label required">Category</label>
                        <select asp-for="AchievementCategory" class="form-select" required>
                            <option value="">-- Select Category --</option>
                            @foreach (var c in categories)
                            {
                                <option value="@c">@c</option>
                            }
                        </select>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Date" class="form-label">Date</label>
                        <input asp-for="Date" type="date" class="form-control" value="@Model.Date.ToString("yyyy-MM-dd")">
                    </div>
                    <div class="mb-3">
                        <label asp-for="ImageUrl" class="form-label">Image URL</label>
                        <input asp-for="ImageUrl" class="form-control" placeholder="/uploads/achievements/photo.jpg">
                        @if (!string.IsNullOrEmpty(Model.ImageUrl))
                        {
                            <div class="mt-2 text-center">
                                <img src="@Model.ImageUrl" class="img-fluid rounded" style="max-height:120px;" />
                            </div>
                        }
                    </div>
                    <div class="mb-3">
                        <div class="form-check form-switch">
                            <input asp-for="IsActive" class="form-check-input" role="switch">
                            <label asp-for="IsActive" class="form-check-label">Active</label>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="d-flex justify-content-end gap-2 mt-3">
        <a asp-area="Admin" asp-controller="Achievement" asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
        <button type="submit" class="btn btn-primary px-4">
            <i class="fas fa-save me-1"></i>Update Achievement
        </button>
    </div>
</form>
