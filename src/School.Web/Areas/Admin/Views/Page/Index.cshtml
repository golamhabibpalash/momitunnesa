@model List<School.Application.DTOs.Page.PageDto>
@{
    ViewData["Title"] = "Pages";
    ViewBag.ActiveMenu = "Pages";
    var isRtl = (ViewData["CurrentLanguage"]?.ToString() ?? "en") == "bn";
}

<div class="page-header">
    <div>
        <h2><i class="fas fa-file-alt me-2"></i>Pages</h2>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-area="Admin" asp-controller="Dashboard" asp-action="Index">Dashboard</a></li>
                <li class="breadcrumb-item active" aria-current="page">Pages</li>
            </ol>
        </nav>
    </div>
    <a asp-area="Admin" asp-controller="Page" asp-action="Create" class="btn btn-primary">
        <i class="fas fa-plus me-1"></i>Create New Page
    </a>
</div>

<div class="card">
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-hover table-datatable" id="pagesTable">
                <thead>
                    <tr>
                        <th>SL</th>
                        <th>Title (English)</th>
                        <th>Title (Bangla)</th>
                        <th>Status</th>
                        <th>Home Page</th>
                        <th>Created Date</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        var sl = ((ViewBag.CurrentPage ?? 1) - 1) * 20 + 1;
                        foreach (var item in Model)
                        {
                            <tr>
                                <td>@(sl++)</td>
                                <td>@item.TitleEn</td>
                                <td>@item.TitleBn</td>
                                <td>
                                    @if (item.IsPublished)
                                    {
                                        <span class="badge bg-success">Published</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-info">Draft</span>
                                    }
                                </td>
                                <td>
                                    @if (item.IsHomePage)
                                    {
                                        <span class="badge bg-success">Yes</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">No</span>
                                    }
                                </td>
                                <td>@item.CreatedAt.ToString("MMM dd, yyyy")</td>
                                <td>
                                    <div class="table-actions">
                                        <a asp-area="Admin" asp-controller="Page" asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-info" title="Edit">
                                            <i class="fas fa-edit"></i>
                                        </a>
                                        <a asp-area="Admin" asp-controller="Page" asp-action="Preview" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary" title="Preview" target="_blank">
                                            <i class="fas fa-eye"></i>
                                        </a>
                                        <form asp-area="Admin" asp-controller="Page" asp-action="Delete" asp-route-id="@item.Id" method="post" style="display:inline" onsubmit="return confirm('Are you sure you want to delete this page?');">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-danger" title="Delete">
                                                <i class="fas fa-trash"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="text-center text-muted py-4">No pages found.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (ViewBag.TotalPages > 1)
        {
            <nav class="mt-3">
                <ul class="pagination justify-content-center">
                    <li class="page-item @(ViewBag.CurrentPage <= 1 ? "disabled" : "")">
                        <a class="page-link" asp-area="Admin" asp-controller="Page" asp-action="Index" asp-route-page="@(ViewBag.CurrentPage - 1)">
                            <i class="fas fa-chevron-left"></i>
                        </a>
                    </li>
                    @for (int i = 1; i <= ViewBag.TotalPages; i++)
                    {
                        <li class="page-item @(i == ViewBag.CurrentPage ? "active" : "")">
                            <a class="page-link" asp-area="Admin" asp-controller="Page" asp-action="Index" asp-route-page="@i">@i</a>
                        </li>
                    }
                    <li class="page-item @(ViewBag.CurrentPage >= ViewBag.TotalPages ? "disabled" : "")">
                        <a class="page-link" asp-area="Admin" asp-controller="Page" asp-action="Index" asp-route-page="@(ViewBag.CurrentPage + 1)">
                            <i class="fas fa-chevron-right"></i>
                        </a>
                    </li>
                </ul>
            </nav>
        }
    </div>
</div>
