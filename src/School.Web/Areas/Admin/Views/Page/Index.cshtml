@{
    ViewData["Title"] = "Pages";
    ViewBag.ActiveMenu = "Pages";
}

<div class="page-header">
    <div>
        <h2><i class="fas fa-file-alt me-2"></i>Pages</h2>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-area="Admin" asp-controller="Dashboard" asp-action="Index">Dashboard</a></li>
                <li class="breadcrumb-item active" aria-current="page">Pages</li>
            </ol>
        </nav>
    </div>
    <a asp-area="Admin" asp-controller="Page" asp-action="Create" class="btn btn-primary">
        <i class="fas fa-plus me-1"></i>Create New Page
    </a>
</div>

<div class="card">
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-hover table-datatable" id="pagesTable">
                <thead>
                    <tr>
                        <th>SL</th>
                        <th>Title (English)</th>
                        <th>Title (Bangla)</th>
                        <th>Status</th>
                        <th>Home Page</th>
                        <th>Created Date</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td>1</td>
                        <td>About Us</td>
                        <td>আমাদের সম্পর্কে</td>
                        <td><span class="badge bg-success">Published</span></td>
                        <td><span class="badge bg-secondary">No</span></td>
                        <td>Jan 15, 2026</td>
                        <td>
                            <div class="table-actions">
                                <a asp-area="Admin" asp-controller="Page" asp-action="Edit" asp-route-id="1" class="btn btn-sm btn-info" title="Edit">
                                    <i class="fas fa-edit"></i>
                                </a>
                                <a asp-area="Admin" asp-controller="Page" asp-action="Preview" asp-route-id="1" class="btn btn-sm btn-outline-secondary" title="Preview" target="_blank">
                                    <i class="fas fa-eye"></i>
                                </a>
                                <button type="button" class="btn btn-sm btn-danger" title="Delete" onclick="confirmDelete('Delete this page?').then(r => { if(r.isConfirmed) { window.location.href='@Url.Action("Delete", "Page", new { area = "Admin", id = 1 })'; } })">
                                    <i class="fas fa-trash"></i>
                                </button>
                            </div>
                        </td>
                    </tr>
                    <tr>
                        <td>2</td>
                        <td>Admission</td>
                        <td>ভর্তি</td>
                        <td><span class="badge bg-success">Published</span></td>
                        <td><span class="badge bg-secondary">No</span></td>
                        <td>Feb 10, 2026</td>
                        <td>
                            <div class="table-actions">
                                <a asp-area="Admin" asp-controller="Page" asp-action="Edit" asp-route-id="2" class="btn btn-sm btn-info"><i class="fas fa-edit"></i></a>
                                <a asp-area="Admin" asp-controller="Page" asp-action="Preview" asp-route-id="2" class="btn btn-sm btn-outline-secondary"><i class="fas fa-eye"></i></a>
                                <button type="button" class="btn btn-sm btn-danger" onclick="confirmDelete('Delete this page?').then(r => { if(r.isConfirmed) { window.location.href='@Url.Action("Delete", "Page", new { area = "Admin", id = 2 })'; } })">
                                    <i class="fas fa-trash"></i>
                                </button>
                            </div>
                        </td>
                    </tr>
                    <tr>
                        <td>3</td>
                        <td>Academic Programs</td>
                        <td>শিক্ষামূলক প্রোগ্রাম</td>
                        <td><span class="badge bg-info">Draft</span></td>
                        <td><span class="badge bg-secondary">No</span></td>
                        <td>Mar 5, 2026</td>
                        <td>
                            <div class="table-actions">
                                <a asp-area="Admin" asp-controller="Page" asp-action="Edit" asp-route-id="3" class="btn btn-sm btn-info"><i class="fas fa-edit"></i></a>
                                <a asp-area="Admin" asp-controller="Page" asp-action="Preview" asp-route-id="3" class="btn btn-sm btn-outline-secondary"><i class="fas fa-eye"></i></a>
                                <button type="button" class="btn btn-sm btn-danger" onclick="confirmDelete('Delete this page?').then(r => { if(r.isConfirmed) { window.location.href='@Url.Action("Delete", "Page", new { area = "Admin", id = 3 })'; } })">
                                    <i class="fas fa-trash"></i>
                                </button>
                            </div>
                        </td>
                    </tr>
                    <tr>
                        <td>4</td>
                        <td>Contact Us</td>
                        <td>যোগাযোগ</td>
                        <td><span class="badge bg-success">Published</span></td>
                        <td><span class="badge bg-secondary">No</span></td>
                        <td>Jan 20, 2026</td>
                        <td>
                            <div class="table-actions">
                                <a asp-area="Admin" asp-controller="Page" asp-action="Edit" asp-route-id="4" class="btn btn-sm btn-info"><i class="fas fa-edit"></i></a>
                                <a asp-area="Admin" asp-controller="Page" asp-action="Preview" asp-route-id="4" class="btn btn-sm btn-outline-secondary"><i class="fas fa-eye"></i></a>
                                <button type="button" class="btn btn-sm btn-danger" onclick="confirmDelete('Delete this page?').then(r => { if(r.isConfirmed) { window.location.href='@Url.Action("Delete", "Page", new { area = "Admin", id = 4 })'; } })">
                                    <i class="fas fa-trash"></i>
                                </button>
                            </div>
                        </td>
                    </tr>
                    <tr>
                        <td>5</td>
                        <td>Home Page</td>
                        <td>হোম পেজ</td>
                        <td><span class="badge bg-success">Published</span></td>
                        <td><span class="badge bg-success">Yes</span></td>
                        <td>Jan 1, 2026</td>
                        <td>
                            <div class="table-actions">
                                <a asp-area="Admin" asp-controller="Page" asp-action="Edit" asp-route-id="5" class="btn btn-sm btn-info"><i class="fas fa-edit"></i></a>
                                <a asp-area="Admin" asp-controller="Page" asp-action="Preview" asp-route-id="5" class="btn btn-sm btn-outline-secondary"><i class="fas fa-eye"></i></a>
                                <button type="button" class="btn btn-sm btn-danger" onclick="confirmDelete('Delete this page?').then(r => { if(r.isConfirmed) { window.location.href='@Url.Action("Delete", "Page", new { area = "Admin", id = 5 })'; } })">
                                    <i class="fas fa-trash"></i>
                                </button>
                            </div>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>
