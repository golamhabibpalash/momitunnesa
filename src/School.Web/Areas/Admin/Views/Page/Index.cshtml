@model List<School.Application.DTOs.Page.PageDto>
@{
    ViewData["Title"] = "Pages";
    ViewBag.ActiveMenu = "Pages";
    var isRtl = (ViewData["CurrentLanguage"]?.ToString() ?? "en") == "bn";
}

<div class="page-header">
    <div>
        <h2><i class="fas fa-file-alt me-2"></i>Pages</h2>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-area="Admin" asp-controller="Dashboard" asp-action="Index">Dashboard</a></li>
                <li class="breadcrumb-item active" aria-current="page">Pages</li>
            </ol>
        </nav>
    </div>
    <a asp-area="Admin" asp-controller="Page" asp-action="Create" class="btn btn-primary">
        <i class="fas fa-plus me-1"></i>Create New Page
    </a>
</div>

<div class="card">
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-hover table-datatable" id="pagesTable">
                <thead>
                    <tr>
                        <th>SL</th>
                        <th>Title (English)</th>
                        <th>Title (Bangla)</th>
                        <th>Status</th>
                        <th>Home Page</th>
                        <th>Created Date</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        var sl = 1;
                        foreach (var item in Model)
                        {
                            <tr>
                                <td>@(sl++)</td>
                                <td>@item.TitleEn</td>
                                <td>@item.TitleBn</td>
                                <td>
                                    @if (item.IsPublished && item.Status)
                                    {
                                        <span class="badge bg-success">Published</span>
                                    }
                                    else if (!item.Status)
                                    {
                                        <span class="badge bg-secondary">Inactive</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-info">Draft</span>
                                    }
                                </td>
                                <td>
                                    @if (item.IsHomePage)
                                    {
                                        <span class="badge bg-success">Yes</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">No</span>
                                    }
                                </td>
                                <td>@item.CreatedAt.ToString("MMM dd, yyyy")</td>
                                <td>
                                    <div class="table-actions">
                                        <a asp-area="Admin" asp-controller="Page" asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-info" title="Edit">
                                            <i class="fas fa-edit"></i>
                                        </a>
                                        <a href="/page/@item.Slug" class="btn btn-sm btn-outline-secondary" title="View on website" target="_blank">
                                            <i class="fas fa-eye"></i>
                                        </a>
                                        <form asp-area="Admin" asp-controller="Page" asp-action="Delete" asp-route-id="@item.Id" method="post" style="display:inline" onsubmit="return confirm('Are you sure you want to delete this page?');">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-danger" title="Delete">
                                                <i class="fas fa-trash"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="text-center text-muted py-4">No pages found.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

    </div>
</div>
