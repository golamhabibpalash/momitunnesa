@{
    ViewData["Title"] = "Edit Page";
    ViewBag.ActiveMenu = "Pages";
}

<div class="page-header">
    <div>
        <h2><i class="fas fa-edit me-2"></i>Edit Page</h2>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-area="Admin" asp-controller="Dashboard" asp-action="Index">Dashboard</a></li>
                <li class="breadcrumb-item"><a asp-area="Admin" asp-controller="Page" asp-action="Index">Pages</a></li>
                <li class="breadcrumb-item active" aria-current="page">Edit</li>
            </ol>
        </nav>
    </div>
    <a asp-area="Admin" asp-controller="Page" asp-action="Index" class="btn btn-outline-secondary">
        <i class="fas fa-arrow-left me-1"></i>Back to List
    </a>
</div>

<form asp-area="Admin" asp-controller="Page" asp-action="Edit" method="post" enctype="multipart/form-data">
    @Html.AntiForgeryToken()
    <input type="hidden" name="Id" value="1">
    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

    <div class="row g-3">
        <div class="col-lg-8">
            <div class="card mb-3">
                <div class="card-header"><i class="fas fa-info-circle me-2"></i>Page Information</div>
                <div class="card-body">
                    <div class="mb-3">
                        <label class="form-label required">Title (English)</label>
                        <input type="text" name="TitleEn" class="form-control" value="About Us" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label required">Title (Bangla)</label>
                        <input type="text" name="TitleBn" class="form-control" value="আমাদের সম্পর্কে" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Slug</label>
                        <div class="input-group">
                            <span class="input-group-text">/</span>
                            <input type="text" name="Slug" class="form-control" value="about-us" id="slugInput">
                            <button type="button" class="btn btn-outline-secondary" onclick="generateSlug()">
                                <i class="fas fa-sync-alt"></i>
                            </button>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label required">Content (English)</label>
                        <textarea name="ContentEn" class="form-control tinymce"><h2>About Our School</h2><p>Momitunnesa School has been providing quality education since its establishment. We are committed to nurturing young minds and building future leaders.</p><p>Our mission is to create a supportive and challenging learning environment that encourages students to reach their full potential.</p></textarea>
                    </div>
                    <div class="mb-3">
                        <label class="form-label required">Content (Bangla)</label>
                        <textarea name="ContentBn" class="form-control tinymce"><h2>আমাদের বিদ্যালয় সম্পর্কে</h2><p>প্রতিষ্ঠার পর থেকে মমিতুন্নেসা স্কুল মানসম্মত শিক্ষা প্রদান করে আসছে। আমরা তরুণ মনের বিকাশ এবং ভবিষ্যৎ নেতা গঠনে প্রতিশ্রুতিবদ্ধ।</p></textarea>
                    </div>
                </div>
            </div>

            <div class="card mb-3">
                <div class="card-header"><i class="fas fa-search me-2"></i>SEO Settings</div>
                <div class="card-body">
                    <div class="mb-3">
                        <label class="form-label">Meta Title</label>
                        <input type="text" name="MetaTitle" class="form-control" value="About Us - Momitunnesa School">
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Meta Description</label>
                        <textarea name="MetaDescription" class="form-control" rows="3">Learn about Momitunnesa School's history, mission, and values. Discover our commitment to quality education.</textarea>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Meta Keywords</label>
                        <input type="text" name="MetaKeywords" class="form-control" value="about us, school history, mission, momitunnesa">
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card mb-3">
                <div class="card-header"><i class="fas fa-cog me-2"></i>Publish Settings</div>
                <div class="card-body">
                    <div class="mb-3">
                        <label class="form-label">Status</label>
                        <select name="Status" class="form-select">
                            <option value="Draft">Draft</option>
                            <option value="Published" selected>Published</option>
                            <option value="Archived">Archived</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Publish Date</label>
                        <input type="datetime-local" name="PublishDate" class="form-control" value="2026-01-15T09:00">
                    </div>
                    <div class="mb-3">
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" role="switch" id="isHomePage" name="IsHomePage" value="true">
                            <label class="form-check-label" for="isHomePage">Set as Home Page</label>
                        </div>
                    </div>
                    <div class="mb-3">
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" role="switch" id="isPublished" name="IsPublished" value="true" checked>
                            <label class="form-check-label" for="isPublished">Published</label>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card mb-3">
                <div class="card-header"><i class="fas fa-image me-2"></i>Featured Image</div>
                <div class="card-body">
                    <div class="mb-3 text-center">
                        <img src="https://placehold.co/600x400/667eea/white?text=About+Us" class="img-fluid rounded mb-2" style="max-height:150px;">
                        <br>
                        <button type="button" class="btn btn-sm btn-outline-danger" onclick="document.getElementById('removeImage').value='true';this.parentElement.querySelector('img').remove();">
                            <i class="fas fa-times"></i> Remove
                        </button>
                        <input type="hidden" name="RemoveImage" id="removeImage" value="">
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Change Image</label>
                        <input type="file" name="FeaturedImage" class="form-control" accept="image/*">
                        <small class="text-muted">Recommended: 1200x630px, max 2MB</small>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="d-flex justify-content-end gap-2 mt-3">
        <a asp-area="Admin" asp-controller="Page" asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
        <button type="submit" class="btn btn-primary px-4">
            <i class="fas fa-save me-1"></i>Update Page
        </button>
    </div>
</form>

@section Scripts {
    <script src="https://cdn.tiny.cloud/1/no-api-key/tinymce/6/tinymce.min.js" referrerpolicy="origin"></script>
    <script>
        tinymce.init({
            selector: '.tinymce',
            height: 500,
            plugins: 'advlist autolink lists link image charmap preview anchor searchreplace visualblocks code fullscreen insertdatetime media table code help wordcount',
            toolbar: 'undo redo | blocks | bold italic forecolor | alignleft aligncenter alignright alignjustify | bullist numlist outdent indent | removeformat | help',
            promotion: false
        });

        function generateSlug() {
            const title = document.querySelector('input[name="TitleEn"]').value;
            const slug = title.toLowerCase()
                .replace(/[^\w\s-]/g, '')
                .replace(/[\s_]+/g, '-')
                .replace(/^-+|-+$/g, '');
            document.getElementById('slugInput').value = slug;
        }
    </script>
}
