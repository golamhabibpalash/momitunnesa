@model List<School.Application.DTOs.Slider.SliderDto>
@{
    ViewData["Title"] = "Sliders";
    ViewBag.ActiveMenu = "Sliders";
}

<div class="page-header">
    <div>
        <h2><i class="fas fa-images me-2"></i>Sliders</h2>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-area="Admin" asp-controller="Dashboard" asp-action="Index">Dashboard</a></li>
                <li class="breadcrumb-item active" aria-current="page">Sliders</li>
            </ol>
        </nav>
    </div>
    <a asp-area="Admin" asp-controller="Slider" asp-action="Create" class="btn btn-primary">
        <i class="fas fa-plus me-1"></i>Add New Slider
    </a>
</div>

<div class="card">
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-hover table-datatable">
                <thead>
                    <tr>
                        <th>SL</th>
                        <th>Image</th>
                        <th>Title (English)</th>
                        <th>Title (Bangla)</th>
                        <th>Status</th>
                        <th>Sort Order</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        var sl = 1;
                        foreach (var item in Model)
                        {
                            <tr>
                                <td>@(sl++)</td>
                                <td>
                                    <img src="@item.ImageUrl" class="preview-img" alt="@item.TitleEn" style="width:120px;height:80px;object-fit:cover;">
                                </td>
                                <td>@item.TitleEn</td>
                                <td>@item.TitleBn</td>
                                <td>
                                    @if (item.IsActive)
                                    {
                                        <span class="badge bg-success">Active</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">Inactive</span>
                                    }
                                </td>
                                <td>@item.SortOrder</td>
                                <td>
                                    <div class="table-actions">
                                        <a asp-area="Admin" asp-controller="Slider" asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-info"><i class="fas fa-edit"></i></a>
                                        <form asp-area="Admin" asp-controller="Slider" asp-action="Delete" asp-route-id="@item.Id" method="post" style="display:inline" onsubmit="return confirm('Are you sure you want to delete this slider?');">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-danger"><i class="fas fa-trash"></i></button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="text-center text-muted py-4">No sliders found.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
