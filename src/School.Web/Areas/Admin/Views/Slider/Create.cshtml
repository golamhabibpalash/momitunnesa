@model School.Application.DTOs.Slider.SliderCreateDto
@{
    ViewData["Title"] = "Create Slider";
    ViewBag.ActiveMenu = "Sliders";
}

<div class="page-header">
    <div>
        <h2><i class="fas fa-plus-circle me-2"></i>Create New Slider</h2>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-area="Admin" asp-controller="Dashboard" asp-action="Index">Dashboard</a></li>
                <li class="breadcrumb-item"><a asp-area="Admin" asp-controller="Slider" asp-action="Index">Sliders</a></li>
                <li class="breadcrumb-item active" aria-current="page">Create</li>
            </ol>
        </nav>
    </div>
    <a asp-area="Admin" asp-controller="Slider" asp-action="Index" class="btn btn-outline-secondary">
        <i class="fas fa-arrow-left me-1"></i>Back to List
    </a>
</div>

<form asp-area="Admin" asp-controller="Slider" asp-action="Create" method="post" enctype="multipart/form-data">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

    <div class="row g-3">
        <div class="col-lg-8">
            <div class="card mb-3">
                <div class="card-header"><i class="fas fa-info-circle me-2"></i>Slider Information</div>
                <div class="card-body">
                    <div class="mb-3">
                        <label asp-for="TitleEn" class="form-label required"></label>
                        <input asp-for="TitleEn" class="form-control" required>
                        <span asp-validation-for="TitleEn" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="TitleBn" class="form-label required"></label>
                        <input asp-for="TitleBn" class="form-control" required>
                        <span asp-validation-for="TitleBn" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="SubtitleEn" class="form-label"></label>
                        <input asp-for="SubtitleEn" class="form-control">
                    </div>
                    <div class="mb-3">
                        <label asp-for="SubtitleBn" class="form-label"></label>
                        <input asp-for="SubtitleBn" class="form-control">
                    </div>
                    <div class="mb-3">
                        <label asp-for="LinkUrl" class="form-label"></label>
                        <input asp-for="LinkUrl" class="form-control">
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card mb-3">
                <div class="card-header"><i class="fas fa-cog me-2"></i>Settings</div>
                <div class="card-body">
                    <div class="mb-3">
                        <label asp-for="SortOrder" class="form-label"></label>
                        <input asp-for="SortOrder" class="form-control" type="number" value="1" min="1">
                    </div>
                    <div class="mb-3">
                        <div class="form-check form-switch">
                            <input asp-for="IsActive" class="form-check-input" role="switch" />
                            <label asp-for="IsActive" class="form-check-label"></label>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card mb-3">
                <div class="card-header"><i class="fas fa-image me-2"></i>Slider Image</div>
                <div class="card-body">
                    <div class="mb-3">
                        <label class="form-label required">Image</label>
                        <input type="file" name="Image" class="form-control" accept="image/*" required>
                        <small class="text-muted">Recommended: 1920x800px, max 5MB</small>
                    </div>
                    <div id="imagePreview" class="mt-2 text-center d-none">
                        <img src="#" alt="Preview" class="img-fluid rounded" style="max-height:180px;">
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="d-flex justify-content-end gap-2 mt-3">
        <a asp-area="Admin" asp-controller="Slider" asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
        <button type="submit" class="btn btn-primary px-4">
            <i class="fas fa-save me-1"></i>Save Slider
        </button>
    </div>
</form>

@section Scripts {
    <script>
        document.querySelector('input[name="Image"]').addEventListener('change', function(e) {
            const file = e.target.files[0];
            if (file) {
                const reader = new FileReader();
                reader.onload = function(e) {
                    const preview = document.getElementById('imagePreview');
                    preview.classList.remove('d-none');
                    preview.querySelector('img').src = e.target.result;
                };
                reader.readAsDataURL(file);
            }
        });
    </script>
}
