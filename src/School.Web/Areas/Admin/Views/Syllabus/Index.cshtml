@model List<School.Application.DTOs.Academic.SyllabusDto>
@{
    ViewData["Title"] = "Syllabus";
    ViewBag.ActiveMenu = "Syllabus";
}
<div class="page-header">
    <div>
        <h2><i class="fas fa-book me-2"></i>Syllabus</h2>
        <nav aria-label="breadcrumb"><ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-area="Admin" asp-controller="Dashboard" asp-action="Index">Dashboard</a></li>
            <li class="breadcrumb-item active" aria-current="page">Syllabus</li>
        </ol></nav>
    </div>
    <a asp-action="Create" class="btn btn-primary"><i class="fas fa-plus me-1"></i>Add Syllabus</a>
</div>
<div class="card"><div class="card-body"><div class="table-responsive">
    <table class="table table-hover table-datatable">
        <thead><tr><th>Class</th><th>Title</th><th>Subject</th><th>File</th><th>Status</th><th>Actions</th></tr></thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.ClassName</td>
                    <td>@item.TitleEn<br><small class="text-muted">@item.TitleBn</small></td>
                    <td>@item.Subject</td>
                    <td><a href="@item.FileUrl" target="_blank"><i class="fas fa-file-download me-1"></i>@(item.FileType ?? "File")</a></td>
                    <td>@if (item.IsActive) { <span class="badge bg-success">Active</span> } else { <span class="badge bg-secondary">Hidden</span> }</td>
                    <td><div class="d-flex gap-1">
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-info" title="Edit"><i class="fas fa-edit"></i></a>
                        <form asp-action="Delete" asp-route-id="@item.Id" method="post" onsubmit="return confirm('Delete this syllabus and its file?');"><button type="submit" class="btn btn-sm btn-danger" title="Delete"><i class="fas fa-trash"></i></button></form>
                    </div></td>
                </tr>
            }
        </tbody>
    </table>
</div></div></div>
