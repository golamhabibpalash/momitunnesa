@model School.Web.Models.StaffListViewModel
@{
    ViewData["Title"] = "Staff";
    var isRtl = (ViewData["CurrentLanguage"]?.ToString() ?? "en") == "bn";
}
<div class="staff-page">
    <div class="row g-4">
        <div class="col-lg-9">
            @if (Model.Staff == null || !Model.Staff.Any())
            {
                <div class="alert alert-light border text-center py-5">@(isRtl ? "কোনো কর্মচারী পাওয়া যায়নি।" : "No staff found.")</div>
            }
            else
            {
                <div class="row g-4">
                    @foreach (var staff in Model.Staff)
                    {
                        var card = new PersonCardModel
                        {
                            Name = staff.Name,
                            Role = staff.Designation,
                            Meta = staff.Department,
                            ImageUrl = staff.ImageUrl,
                            Email = staff.Email,
                            Phone = staff.Phone
                        };
                        <div class="col-xl-4 col-md-6">
                            <partial name="_PersonCard" model="card" />
                        </div>
                    }
                </div>
            }
        </div>
        <div class="col-lg-3">
            <aside>
                @await Html.PartialAsync("_ImportantLinks")
            </aside>
        </div>
    </div>
</div>
