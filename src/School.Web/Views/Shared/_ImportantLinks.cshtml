@{
    var isRtl = (ViewData["CurrentLanguage"]?.ToString() ?? "en") == "bn";
    var links = new List<School.Web.Models.LinkItem>
    {
        new() { Title = "Notice Board", TitleBn = "নোটিশ বোর্ড", Url = "/notice", Icon = "fas fa-bullhorn" },
        new() { Title = "Academic Calendar", TitleBn = "একাডেমিক ক্যালেন্ডার", Url = "/academic/calendar", Icon = "fas fa-calendar-alt" },
        new() { Title = "Class Routine", TitleBn = "ক্লাস রুটিন", Url = "/academic/routine", Icon = "fas fa-clock" },
        new() { Title = "Syllabus", TitleBn = "সিলেবাস", Url = "/academic/syllabus", Icon = "fas fa-book" },
        new() { Title = "Results", TitleBn = "ফলাফল", Url = "/results", Icon = "fas fa-chart-bar" },
        new() { Title = "Admission", TitleBn = "ভর্তি", Url = "/admission", Icon = "fas fa-user-plus" },
    };
}
<div class="important-links-widget">
    <h4 class="widget-title">@(isRtl ? "গুরুত্বপূর্ণ লিংক" : "Important Links")</h4>
    <ul class="links-list">
        @foreach (var link in links)
        {
            <li>
                <a href="@link.Url">
                    <i class="@link.Icon"></i>
                    <span>@(isRtl ? link.TitleBn : link.Title)</span>
                </a>
            </li>
        }
    </ul>
</div>
