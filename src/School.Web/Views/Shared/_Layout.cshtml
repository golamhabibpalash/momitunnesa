@using System.Globalization
@using School.Application.DTOs.Settings
@using School.Application.Services.Interfaces
@using School.Web.Helpers
@inject ISettingsService SettingsService
@{
    var currentLang = ViewData["CurrentLanguage"]?.ToString() ?? "en";
    var isRtl = currentLang == "bn";
    var direction = "ltr";
    var langAttr = isRtl ? "bn" : "en";
    var currentYear = DateTime.Now.Year;
    var canonicalUrl = Context.Request.Scheme + "://" + Context.Request.Host + Context.Request.Path;
    var schoolInfo = await SettingsService.GetSchoolInfoAsync();
    var schoolName = schoolInfo.Success ? schoolInfo.Data?.SchoolNameEn : "Momitunnesa Secondary School";
    var schoolNameBn = schoolInfo.Success ? schoolInfo.Data?.SchoolNameBn : "মোমিতুন্নেছা মাধ্যমিক বিদ্যালয়";
    var displayName = isRtl ? schoolNameBn : schoolName;
    var schoolPhone = schoolInfo.Success ? schoolInfo.Data?.Phone : null;
    var schoolEmail = schoolInfo.Success ? schoolInfo.Data?.Email : null;
    var logoUrl = schoolInfo.Success ? schoolInfo.Data?.LogoUrl : null;
    var faviconUrl = schoolInfo.Success ? schoolInfo.Data?.FaviconUrl : null;

    var socialLinksResult = await SettingsService.GetAllSocialLinksAsync();
    var socialLinks = socialLinksResult.Success && socialLinksResult.Data is not null
        ? socialLinksResult.Data.Where(l => l.IsActive).OrderBy(l => l.SortOrder).ToList()
        : new List<SocialLinkDto>();
}
<!DOCTYPE html>
<html lang="@langAttr" dir="@direction">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, shrink-to-fit=no" />
    <meta name="description" content="@(ViewData["MetaDescription"] ?? "মোমিতুন্নেসা উচ্চ বিদ্যালয় - একটি উন্নতমানের শিক্ষাপ্রতিষ্ঠান")" />
    <meta name="keywords" content="@(ViewData["MetaKeywords"] ?? "মোমিতুন্নেসা, উচ্চ বিদ্যালয়, শিক্ষা, বাংলাদেশ, স্কুল")" />
    <meta name="author" content="Momitunnesa High School" />
    <meta name="robots" content="index, follow" />

    <meta property="og:title" content="@ViewData["Title"] - @displayName" />
    <meta property="og:description" content="@(ViewData["MetaDescription"] ?? "মোমিতুন্নেসা উচ্চ বিদ্যালয় - একটি উন্নতমানের শিক্ষাপ্রতিষ্ঠান")" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="@canonicalUrl" />
    <meta property="og:image" content="@(ViewData["OgImage"] ?? $"{Context.Request.Scheme}://{Context.Request.Host}/images/og-default.jpg")" />
    <meta property="og:site_name" content="@displayName" />
    <meta property="og:locale" content="@(isRtl ? "bn_BD" : "en_US")" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="@ViewData["Title"] - @displayName" />
    <meta name="twitter:description" content="@(ViewData["MetaDescription"] ?? "মোমিতুন্নেসা উচ্চ বিদ্যালয়")" />
    <meta name="twitter:image" content="@(ViewData["OgImage"] ?? $"{Context.Request.Scheme}://{Context.Request.Host}/images/og-default.jpg")" />

    <link rel="canonical" href="@canonicalUrl" />

    <script type="application/ld+json">
    {
        "@@context": "https://schema.org",
        "@@type": "School",
        "name": "Momitunnesa High School",
        "alternateName": "মোমিতুন্নেসা উচ্চ বিদ্যালয়",
        "description": "মোমিতুন্নেসা উচ্চ বিদ্যালয় একটি উন্নতমানের শিক্ষাপ্রতিষ্ঠান",
        "address": {
            "@@type": "PostalAddress",
            "addressLocality": "Your District",
            "addressRegion": "Your Division",
            "addressCountry": "BD"
        },
        "email": "info@momitunnesa.edu.bd",
        "telephone": "+880-XXX-XXXXXX",
        "url": "@canonicalUrl"
    }
    </script>

    <title>@ViewData["Title"] - @displayName</title>

    @if (!string.IsNullOrEmpty(faviconUrl))
    {
        <link rel="icon" href="@faviconUrl" />
    }
    else
    {
        <link rel="icon" type="image/x-icon" href="~/favicon.ico" />
    }

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+Bengali:wght@300;400;500;600;700&family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="ltr-mode">
    <div class="school-wrapper">
        <div id="top-bar" class="top-bar">
            <div class="container">
                <div class="row align-items-center">
                    <div class="col-md-7 col-lg-8 top-bar-left">
                        @if (!string.IsNullOrEmpty(schoolPhone))
                        {
                            <span class="top-bar-item">
                                <i class="fas fa-phone-alt"></i>
                                <a href="tel:@schoolPhone">@schoolPhone</a>
                            </span>
                        }
                        @if (!string.IsNullOrEmpty(schoolEmail))
                        {
                            <span class="top-bar-item">
                                <i class="fas fa-envelope"></i>
                                <a href="mailto:@schoolEmail">@schoolEmail</a>
                            </span>
                        }
                    </div>
                    <div class="col-md-5 col-lg-4 top-bar-right">
                        @if (socialLinks.Any())
                        {
                            <div class="top-bar-social">
                                @foreach (var link in socialLinks)
                                {
                                    <a href="@link.Url" target="_blank" rel="noopener" aria-label="@link.Platform">
                                        <i class="@SocialPlatformHelper.GetIcon(link.Platform, link.Icon)"></i>
                                    </a>
                                }
                            </div>
                        }
                        <div class="top-bar-lang">
                            <a href="@Url.Action("SwitchLanguage", "Home", new { lang = "en", returnUrl = Context.Request.Path })" class="@(currentLang == "en" ? "active" : "")">EN</a>
                            <span class="lang-separator">|</span>
                            <a href="@Url.Action("SwitchLanguage", "Home", new { lang = "bn", returnUrl = Context.Request.Path })" class="@(currentLang == "bn" ? "active" : "")">বাংলা</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <header class="school-header">
            <div class="container">
                <div class="row align-items-center">
                    <div class="col-auto">
                        <a href="@Url.Action("Index", "Home")" class="school-brand">
                            <div class="brand-logo @(string.IsNullOrEmpty(logoUrl) ? "" : "has-image")">
                                @if (!string.IsNullOrEmpty(logoUrl))
                                {
                                    <img src="@logoUrl" alt="@displayName" />
                                }
                                else
                                {
                                    <i class="fas fa-school"></i>
                                }
                            </div>
                        </a>
                    </div>
                    <div class="col">
                        <div class="brand-text">
                            <h1 class="brand-name">@displayName</h1>
                            <p class="brand-tagline">@(isRtl ? "শিক্ষা, শৃঙ্খলা, উন্নতি" : "Education, Discipline, Progress")</p>
                        </div>
                    </div>
                    <div class="col-auto d-none d-lg-block">
                        <div class="header-quick-links">
                            <a href="@Url.Action("Index", "Notice")" class="btn btn-outline-primary btn-sm"><i class="fas fa-bullhorn"></i> @(isRtl ? "নোটিশ" : "Notice")</a>
                            <a href="@Url.Action("Index", "Contact")" class="btn btn-primary btn-sm"><i class="fas fa-phone"></i> @(isRtl ? "যোগাযোগ" : "Contact")</a>
                        </div>
                    </div>
                </div>
            </div>
        </header>

        <nav class="main-nav navbar navbar-expand-lg" id="mainNav">
            <div class="container">
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarContent"
                        aria-controls="navbarContent" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                    <span class="toggler-text">@(isRtl ? "মেনু" : "Menu")</span>
                </button>
                <div class="collapse navbar-collapse" id="navbarContent">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Home" && ViewContext.RouteData.Values["action"]?.ToString() == "Index" ? "active" : "")"
                               asp-controller="Home" asp-action="Index">
                                <i class="fas fa-home"></i> @(isRtl ? "হোম" : "Home")
                            </a>
                        </li>
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">
                                @(isRtl ? "আমাদের সম্পর্কে" : "About Us")
                            </a>
                            <ul class="dropdown-menu">
                                <li><a class="dropdown-item" asp-controller="About" asp-action="Index">@(isRtl ? "পরিচিতি" : "About Us")</a></li>
                                <li><a class="dropdown-item" asp-controller="About" asp-action="SchoolProfile">@(isRtl ? "স্কুল প্রোফাইল" : "School Profile")</a></li>
                                <li><a class="dropdown-item" asp-controller="About" asp-action="History">@(isRtl ? "ইতিহাস" : "History")</a></li>
                                <li><a class="dropdown-item" asp-controller="Teacher" asp-action="Index">@(isRtl ? "শিক্ষকগণ" : "Teachers")</a></li>
                                <li><a class="dropdown-item" asp-controller="Staff" asp-action="Index">@(isRtl ? "কর্মচারীবৃন্দ" : "Staff")</a></li>
                                <li><a class="dropdown-item" asp-controller="Administration" asp-action="Index">@(isRtl ? "প্রশাসন" : "Administration")</a></li>
                            </ul>
                        </li>
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">
                                @(isRtl ? "একাডেমিক" : "Academic")
                            </a>
                            <ul class="dropdown-menu">
                                <li><a class="dropdown-item" asp-controller="Academic" asp-action="Calendar">@(isRtl ? "একাডেমিক ক্যালেন্ডার" : "Calendar")</a></li>
                                <li><a class="dropdown-item" asp-controller="Academic" asp-action="Routine">@(isRtl ? "ক্লাস রুটিন" : "Class Routine")</a></li>
                                <li><a class="dropdown-item" asp-controller="Academic" asp-action="Syllabus">@(isRtl ? "সিলেবাস" : "Syllabus")</a></li>
                            </ul>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Notice" asp-action="Index">@(isRtl ? "নোটিশ" : "Notices")</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="News" asp-action="Index">@(isRtl ? "খবর" : "News")</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Event" asp-action="Index">@(isRtl ? "ইভেন্ট" : "Events")</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Gallery" asp-action="Index">@(isRtl ? "গ্যালারি" : "Gallery")</a>
                        </li>
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">
                                @(isRtl ? "আরও" : "More")
                            </a>
                            <ul class="dropdown-menu">
                                <li><a class="dropdown-item" asp-controller="Facilities" asp-action="Index">@(isRtl ? "সুযোগ-সুবিধা" : "Facilities")</a></li>
                                <li><a class="dropdown-item" asp-controller="Clubs" asp-action="Index">@(isRtl ? "ক্লাব" : "Clubs")</a></li>
                                <li><a class="dropdown-item" asp-controller="Achievement" asp-action="Index">@(isRtl ? "সাফল্য" : "Achievements")</a></li>
                                <li><a class="dropdown-item" asp-controller="Publication" asp-action="Index">@(isRtl ? "প্রকাশনা" : "Publications")</a></li>
                                <li><a class="dropdown-item" asp-controller="Download" asp-action="Index">@(isRtl ? "ডাউনলোড" : "Downloads")</a></li>
                            </ul>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Contact" asp-action="Index">@(isRtl ? "যোগাযোগ" : "Contact")</a>
                        </li>
                    </ul>
                    <form class="d-flex nav-search" asp-controller="Search" asp-action="Index" method="get">
                        <div class="input-group">
                            <input class="form-control form-control-sm" type="search" name="q"
                                   placeholder="@(isRtl ? "অনুসন্ধান..." : "Search...")"
                                   aria-label="Search" />
                            <button class="btn btn-outline-light btn-sm" type="submit">
                                <i class="fas fa-search"></i>
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </nav>

        @if (IsSectionDefined("Hero"))
        {
            @await RenderSectionAsync("Hero", required: false)
        }

        <main role="main" class="main-content">
            @if (!IsSectionDefined("Hero"))
            {
                <div class="page-banner">
                    <div class="container">
                        <h1 class="page-title">@ViewData["Title"]</h1>
                        @await Html.PartialAsync("_Breadcrumb")
                    </div>
                </div>
            }
            <div class="container py-4">
                @RenderBody()
            </div>
        </main>

        <footer class="school-footer">
            <div class="footer-main">
                <div class="container">
                    <div class="row g-4">
                        <div class="col-lg-4 col-md-6">
                            <div class="footer-widget">
                                <h4 class="footer-widget-title">@(isRtl ? "স্কুল তথ্য" : "School Info")</h4>
                                <div class="footer-logo">
                                    @if (!string.IsNullOrEmpty(logoUrl))
                                    {
                                        <img src="@logoUrl" alt="@displayName" />
                                    }
                                    else
                                    {
                                        <i class="fas fa-school"></i>
                                    }
                                    <h5>@displayName</h5>
                                </div>
                                <ul class="footer-contact-list">
                                    <li>
                                        <i class="fas fa-map-marker-alt"></i>
                                        <span>@(isRtl ? "ঠিকানা: আপনার জেলা, বাংলাদেশ" : "Address: Your District, Bangladesh")</span>
                                    </li>
                                    <li>
                                        <i class="fas fa-phone-alt"></i>
                                        <a href="tel:+880XXXXXXXXX">+880-XXX-XXXXXX</a>
                                    </li>
                                    <li>
                                        <i class="fas fa-envelope"></i>
                                        <a href="mailto:info@momitunnesa.edu.bd">info@momitunnesa.edu.bd</a>
                                    </li>
                                </ul>
                            </div>
                        </div>
                        <div class="col-lg-2 col-md-6">
                            <div class="footer-widget">
                                <h4 class="footer-widget-title">@(isRtl ? "দ্রুত লিংক" : "Quick Links")</h4>
                                <ul class="footer-links">
                                    <li><a asp-controller="About" asp-action="Index">@(isRtl ? "পরিচিতি" : "About Us")</a></li>
                                    <li><a asp-controller="Notice" asp-action="Index">@(isRtl ? "নোটিশ" : "Notices")</a></li>
                                    <li><a asp-controller="News" asp-action="Index">@(isRtl ? "খবর" : "News")</a></li>
                                    <li><a asp-controller="Event" asp-action="Index">@(isRtl ? "ইভেন্ট" : "Events")</a></li>
                                    <li><a asp-controller="Gallery" asp-action="Index">@(isRtl ? "গ্যালারি" : "Gallery")</a></li>
                                    <li><a asp-controller="Download" asp-action="Index">@(isRtl ? "ডাউনলোড" : "Downloads")</a></li>
                                </ul>
                            </div>
                        </div>
                        <div class="col-lg-3 col-md-6">
                            <div class="footer-widget">
                                <h4 class="footer-widget-title">@(isRtl ? "সরকারি লিংক" : "Government Links")</h4>
                                <ul class="footer-links">
                                    <li><a href="http://www.moedu.gov.bd" target="_blank" rel="noopener">@(isRtl ? "শিক্ষা মন্ত্রণালয়" : "Ministry of Education")</a></li>
                                    <li><a href="http://www.dshe.gov.bd" target="_blank" rel="noopener">@(isRtl ? "মাধ্যমিক ও উচ্চ শিক্ষা অধিদপ্তর" : "DSHE")</a></li>
                                    <li><a href="http://www.nctb.gov.bd" target="_blank" rel="noopener">@(isRtl ? "এনসিটিবি" : "NCTB")</a></li>
                                    <li><a href="http://www.educationboard.gov.bd" target="_blank" rel="noopener">@(isRtl ? "শিক্ষা বোর্ড" : "Education Board")</a></li>
                                </ul>
                            </div>
                        </div>
                        <div class="col-lg-3 col-md-6">
                            <div class="footer-widget">
                                <h4 class="footer-widget-title">@(isRtl ? "সামাজিক মাধ্যম" : "Follow Us")</h4>
                                @if (socialLinks.Any())
                                {
                                    <p class="footer-social-text">@(isRtl ? "সামাজিক মাধ্যমে আমাদের সাথে থাকুন" : "Stay connected with us on social media")</p>
                                    <div class="footer-social-links">
                                        @foreach (var link in socialLinks)
                                        {
                                            <a href="@link.Url" target="_blank" rel="noopener"
                                               class="social-link @SocialPlatformHelper.GetCssClass(link.Platform)"
                                               aria-label="@link.Platform">
                                                <i class="@SocialPlatformHelper.GetIcon(link.Platform, link.Icon)"></i>
                                            </a>
                                        }
                                    </div>
                                }
                                <div class="visitor-counter mt-3">
                                    <i class="fas fa-eye"></i>
                                    <span>@(isRtl ? "মোট দর্শক:" : "Total Visitors:") </span>
                                    <span id="visitorCount" class="visitor-count">0</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="footer-bottom">
                <div class="container">
                    <div class="row align-items-center">
                        <div class="col-md-6">
                            @await Component.InvokeAsync("FooterInfo")
                        </div>
                        <div class="col-md-6 text-md-end">
                            <ul class="footer-bottom-links">
                                <li><a asp-controller="Home" asp-action="Privacy">@(isRtl ? "গোপনীয়তা" : "Privacy")</a></li>
                                <li><a href="#">@(isRtl ? "শর্তাবলী" : "Terms")</a></li>
                                <li><a href="#">@(isRtl ? "সাইটম্যাপ" : "Sitemap")</a></li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
        </footer>
    </div>

    <button id="backToTop" class="btn btn-primary back-to-top" aria-label="Back to Top">
        <i class="fas fa-arrow-up"></i>
    </button>

    <div class="cookie-consent" id="cookieConsent">
        <div class="cookie-content">
            <p>@(isRtl ? "আমরা আপনার অভিজ্ঞতা উন্নত করতে কুকি ব্যবহার করি।" : "We use cookies to enhance your experience.")</p>
            <button class="btn btn-sm btn-primary" id="cookieAccept">@(isRtl ? "স্বীকার করুন" : "Accept")</button>
            <button class="btn btn-sm btn-outline-secondary" id="cookieDecline">@(isRtl ? "প্রত্যাখ্যান" : "Decline")</button>
        </div>
    </div>

    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
