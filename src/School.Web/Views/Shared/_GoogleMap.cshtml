@model string
@{
    var isRtl = (ViewData["CurrentLanguage"]?.ToString() ?? "en") == "bn";
    var address = Model ?? "Your District, Bangladesh";
    var mapSrc = $"https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d1000!2d90.0!3d25.0!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x0%3A0x0!2zMjXCsDAwJzAwLjAiTiA5MMKwMDAnMDAuMCJF!5e0!3m2!1sen!2sbd!4v1";
}
<section class="map-section">
    <div class="container-fluid p-0">
        <div class="map-container">
            <iframe src="@mapSrc"
                    width="100%" height="400" style="border:0;"
                    allowfullscreen=""
                    loading="lazy"
                    referrerpolicy="no-referrer-when-downgrade"
                    title="@(isRtl ? "বিদ্যালয়ের অবস্থান" : "School Location")">
            </iframe>
            <div class="map-overlay d-none d-md-flex">
                <div class="map-address-card">
                    <i class="fas fa-map-marker-alt"></i>
                    <h5>@(isRtl ? "আমাদের অবস্থান" : "Our Location")</h5>
                    <p>@address</p>
                </div>
            </div>
        </div>
    </div>
</section>
