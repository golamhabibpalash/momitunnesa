@{
    ViewData["Title"] = "Administration";
    var isRtl = (ViewData["CurrentLanguage"]?.ToString() ?? "en") == "bn";
}
<div class="administration-page">
    <div class="row g-4">
        <div class="col-12">
            <div class="alert alert-info">
                <i class="fas fa-info-circle me-2"></i>
                @(isRtl ? "প্রশাসনিক তথ্য শীঘ্রই যুক্ত করা হবে।" : "Administration information coming soon.")
            </div>
        </div>
    </div>
</div>
