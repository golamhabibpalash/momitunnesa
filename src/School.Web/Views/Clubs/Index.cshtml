@{
    ViewData["Title"] = "Clubs";
    var isRtl = (ViewData["CurrentLanguage"]?.ToString() ?? "en") == "bn";
}
<div class="clubs-page">
    <div class="row g-4">
        <div class="col-12">
            @if (!string.IsNullOrEmpty(ViewBag.Content))
            {
                <div class="page-content">
                    @Html.Raw(ViewBag.Content)
                </div>
            }
            else
            {
                <div class="alert alert-info">
                    <i class="fas fa-info-circle me-2"></i>
                    @(isRtl ? "ক্লাবের তথ্য শীঘ্রই যুক্ত করা হবে।" : "Clubs information will be available soon.")
                </div>
            }
        </div>
    </div>
</div>
