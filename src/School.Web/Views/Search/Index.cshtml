@model School.Web.Models.SearchViewModel
@{
    ViewData["Title"] = "Search Results";
    var isRtl = (ViewData["CurrentLanguage"]?.ToString() ?? "en") == "bn";
    var results = Model?.Results;
    var totalResults = Model?.TotalResults ?? 0;
    var query = Model?.Query ?? Context.Request.Query["q"].ToString();
}
<div class="search-page">
    <div class="row g-4">
        <div class="col-12">
            <div class="search-header mb-4">
                <form asp-action="Index" method="get" class="search-form">
                    <div class="input-group input-group-lg">
                        <input type="text" name="q" class="form-control" value="@query"
                               placeholder="@(isRtl ? "অনুসন্ধান করুন..." : "Search...")" />
                        <button class="btn btn-primary" type="submit">
                            <i class="fas fa-search"></i>
                        </button>
                    </div>
                </form>
                @if (!string.IsNullOrEmpty(query))
                {
                    <p class="search-stats mt-2 text-muted">
                        @(isRtl ? "অনুসন্ধান ফলাফল:" : "Search results for:") <strong>"@query"</strong>
                        &mdash; @(isRtl ? $"মোট {totalResults}টি ফলাফল পাওয়া গেছে" : $"Total {totalResults} results found")
                    </p>
                }
            </div>
            @if (results != null && results.Any())
            {
                <div class="search-results">
                    @foreach (var item in results)
                    {
                        <div class="result-item p-3 border-bottom">
                            <h5><a href="@item.Url">@item.Title</a></h5>
                            @if (!string.IsNullOrEmpty(item.Description))
                            {
                                <p class="result-snippet">@item.Description</p>
                            }
                            <div class="result-meta">
                                <span class="badge bg-primary">@(isRtl && !string.IsNullOrEmpty(item.TypeBn) ? item.TypeBn : item.Type)</span>
                                @if (!string.IsNullOrEmpty(item.Date))
                                {
                                    <small class="text-muted ms-2">@item.Date</small>
                                }
                            </div>
                        </div>
                    }
                </div>
            }
            else if (!string.IsNullOrEmpty(query))
            {
                <div class="alert alert-info">
                    <i class="fas fa-info-circle me-2"></i>
                    @(isRtl ? "কোনো ফলাফল পাওয়া যায়নি।" : "No results found.")
                </div>
            }
        </div>
    </div>
</div>
