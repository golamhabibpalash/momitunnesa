@model School.Web.Models.GalleryIndexViewModel
@{
    ViewData["Title"] = "Gallery";
    var isRtl = (ViewData["CurrentLanguage"]?.ToString() ?? "en") == "bn";
}
<div class="gallery-page">
    <ul class="nav nav-tabs gallery-tabs mb-4" id="galleryTab" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active" id="photo-tab" data-bs-toggle="tab" data-bs-target="#photo" type="button" role="tab">
                <i class="fas fa-image me-2"></i>@(isRtl ? "ফটো" : "Photos")
            </button>
        </li>
    </ul>
    <div class="tab-content" id="galleryTabContent">
        <div class="tab-pane fade show active" id="photo" role="tabpanel">
            <div class="row g-4">
                @if (Model.Albums != null)
                {
                    foreach (var album in Model.Albums)
                    {
                        <div class="col-lg-4 col-md-6">
                            <a asp-action="Album" asp-route-id="@album.Id" class="album-card text-decoration-none">
                                <div class="album-cover position-relative">
                                    <img src="@(album.CoverImageUrl ?? "/images/placeholder.jpg")" alt="@(isRtl ? album.TitleBn ?? album.Title : album.Title)" class="img-fluid rounded"
                                         onerror="this.src='/images/placeholder.jpg'" />
                                    <div class="album-overlay">
                                        <div class="album-info text-center text-white">
                                            <h5>@(isRtl ? album.TitleBn ?? album.Title : album.Title)</h5>
                                            <span class="badge bg-light text-dark">@album.PhotoCount @(isRtl ? "টি ছবি" : "Photos")</span>
                                        </div>
                                    </div>
                                </div>
                            </a>
                        </div>
                    }
                }
            </div>
        </div>
    </div>
</div>
