@model List<School.Application.DTOs.Achievement.AchievementDto>
@{
    ViewData["Title"] = "Achievements";
    var isRtl = (ViewData["CurrentLanguage"]?.ToString() ?? "en") == "bn";
}
<div class="achievements-page">
    <ul class="nav nav-pills mb-4" id="achievementTab">
        <li class="nav-item"><a class="nav-link active" href="#">@(isRtl ? "সব" : "All")</a></li>
        <li class="nav-item"><a class="nav-link" href="#">@(isRtl ? "একাডেমিক" : "Academic")</a></li>
        <li class="nav-item"><a class="nav-link" href="#">@(isRtl ? "ক্রীড়া" : "Sports")</a></li>
        <li class="nav-item"><a class="nav-link" href="#">@(isRtl ? "সাংস্কৃতিক" : "Cultural")</a></li>
        <li class="nav-item"><a class="nav-link" href="#">@(isRtl ? "বিজ্ঞান" : "Science")</a></li>
    </ul>
    <div class="row g-4">
        @if (Model != null)
        {
            foreach (var item in Model)
            {
                var category = item.AchievementCategory;
                var badgeColor = category == "Academic" ? "primary" : category == "Sports" ? "success" : category == "Cultural" ? "info" : "warning";
                var categoryBn = category == "Academic" ? "একাডেমিক" : category == "Sports" ? "ক্রীড়া" : category == "Cultural" ? "সাংস্কৃতিক" : "বিজ্ঞান";
                <div class="col-lg-4 col-md-6">
                    <div class="achievement-card card h-100 shadow-sm">
                        <div class="card-body p-4">
                            <div class="d-flex align-items-center mb-3">
                                <div class="achievement-badge me-3">
                                    <i class="fas fa-trophy fa-2x text-warning"></i>
                                </div>
                                <div>
                                    <span class="badge bg-@badgeColor mb-2">
                                        @(isRtl ? categoryBn : category)
                                    </span>
                                    <h5 class="mb-0">@(isRtl ? item.TitleBn : item.TitleEn)</h5>
                                </div>
                            </div>
                            <p class="achievement-description text-muted">
                                @(isRtl ? item.DescriptionBn ?? item.DescriptionEn : item.DescriptionEn)
                            </p>
                            <div class="achievement-meta d-flex justify-content-between align-items-center">
                                <small class="text-muted"><i class="far fa-calendar me-1"></i>@item.Date.ToString("MMM yyyy")</small>
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
    </div>
</div>
