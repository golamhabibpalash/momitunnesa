@model List<School.Application.DTOs.Academic.SyllabusDto>
@{
    ViewData["Title"] = "Syllabus";
    var isRtl = (ViewData["CurrentLanguage"]?.ToString() ?? "en") == "bn";
}
<div class="syllabus-page">
    <partial name="_PageContent" />
    @if (!Model.Any())
    {
        <div class="alert alert-info"><i class="fas fa-info-circle me-2"></i>@(isRtl ? "সিলেবাস শীঘ্রই প্রকাশ করা হবে।" : "The syllabus will be published soon.")</div>
    }
    <div class="row g-4">
        @foreach (var group in Model.GroupBy(s => s.ClassName))
        {
            <div class="col-md-6">
                <div class="card shadow-sm h-100 border-0">
                    <div class="card-header bg-primary text-white fw-semibold"><i class="fas fa-book me-2"></i>@group.Key</div>
                    <ul class="list-group list-group-flush">
                        @foreach (var item in group)
                        {
                            <li class="list-group-item d-flex justify-content-between align-items-center gap-2">
                                <div>
                                    <div>@(isRtl && !string.IsNullOrWhiteSpace(item.TitleBn) ? item.TitleBn : item.TitleEn)</div>
                                    @if (!string.IsNullOrWhiteSpace(item.Subject)) { <small class="text-muted">@item.Subject</small> }
                                </div>
                                <a href="@item.FileUrl" target="_blank" class="btn btn-sm btn-outline-primary flex-shrink-0"><i class="fas fa-download me-1"></i>@(item.FileType ?? (isRtl ? "ডাউনলোড" : "Download"))</a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        }
    </div>
</div>
