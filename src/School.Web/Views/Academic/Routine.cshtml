@{
    ViewData["Title"] = "Class Routine";
    var isRtl = (ViewData["CurrentLanguage"]?.ToString() ?? "en") == "bn";
}
<div class="routine-page">
    <div class="row g-4">
        <div class="col-12">
            @if (!string.IsNullOrEmpty(ViewBag.Content))
            {
                <div class="page-content mb-4">
                    @Html.Raw(ViewBag.Content)
                </div>
            }
            <div class="alert alert-info">
                <i class="fas fa-info-circle me-2"></i>
                @(isRtl ? "শ্রেণি রুটিনের তথ্য শীঘ্রই যুক্ত করা হবে।" : "Class routine data will be available soon.")
            </div>
        </div>
    </div>
</div>
