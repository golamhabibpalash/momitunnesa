@{
    ViewData["Title"] = "Academic Calendar";
    var isRtl = (ViewData["CurrentLanguage"]?.ToString() ?? "en") == "bn";
}
<div class="academic-calendar-page">
    <div class="row g-4">
        <div class="col-12">
            @if (!string.IsNullOrEmpty(ViewBag.Content))
            {
                <div class="page-content mb-4">
                    @Html.Raw(ViewBag.Content)
                </div>
            }
            <div class="alert alert-info">
                <i class="fas fa-info-circle me-2"></i>
                @(isRtl ? "একাডেমিক ক্যালেন্ডারের তথ্য শীঘ্রই যুক্ত করা হবে।" : "Academic calendar content coming soon.")
            </div>
        </div>
    </div>
</div>
