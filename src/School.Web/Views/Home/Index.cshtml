@{
    ViewData["Title"] = "Home";
    var isRtl = (ViewData["CurrentLanguage"]?.ToString() ?? "en") == "bn";
    var sliders = ViewBag.Sliders as IEnumerable<School.Application.DTOs.Slider.SliderDto>;
    var notices = ViewBag.Notices as IEnumerable<School.Application.DTOs.Notice.NoticeDto>;
    var newsItems = ViewBag.News as IEnumerable<School.Application.DTOs.News.NewsDto>;
    var events = ViewBag.Events as IEnumerable<School.Application.DTOs.Event.EventDto>;
}
@section Hero {
    <section class="hero-slider-section">
        <div id="heroCarousel" class="carousel slide hero-carousel" data-bs-ride="carousel">
            <div class="carousel-indicators">
                @if (sliders != null)
                {
                    var idx = 0;
                    foreach (var slider in sliders)
                    {
                        <button type="button" data-bs-target="#heroCarousel" data-bs-slide-to="@idx" class="@(idx == 0 ? "active" : "")" aria-current="@(idx == 0 ? "true" : null)"></button>
                        idx++;
                    }
                }
            </div>
            <div class="carousel-inner">
                @if (sliders != null)
                {
                    var idx = 0;
                    foreach (var slider in sliders)
                    {
                        <div class="carousel-item @(idx == 0 ? "active" : "")">
                            <div class="hero-slide" style="background-image: url('@slider.ImageUrl');">
                                <div class="hero-overlay"></div>
                                <div class="container">
                                    <div class="hero-content">
                                        <h1 class="hero-title">@(isRtl ? slider.TitleBn : slider.TitleEn)</h1>
                                        <p class="hero-subtitle">@(isRtl ? slider.SubtitleBn : slider.SubtitleEn)</p>
                                        <div class="hero-buttons">
                                            <a asp-controller="About" asp-action="Index" class="btn btn-primary btn-lg">@(isRtl ? "আরও জানুন" : "Learn More")</a>
                                            <a asp-controller="Contact" asp-action="Index" class="btn btn-outline-light btn-lg">@(isRtl ? "যোগাযোগ" : "Contact Us")</a>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        idx++;
                    }
                }
            </div>
            <button class="carousel-control-prev" type="button" data-bs-target="#heroCarousel" data-bs-slide="prev">
                <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                <span class="visually-hidden">Previous</span>
            </button>
            <button class="carousel-control-next" type="button" data-bs-target="#heroCarousel" data-bs-slide="next">
                <span class="carousel-control-next-icon" aria-hidden="true"></span>
                <span class="visually-hidden">Next</span>
            </button>
        </div>
    </section>
}

<div class="home-page">
    @if (notices != null && notices.Any())
    {
        <section class="notice-ticker-section">
            <div class="container">
                <div class="notice-ticker-wrapper">
                    <div class="ticker-label">
                        <i class="fas fa-bullhorn"></i>
                        <span>@(isRtl ? "নোটিশ" : "Notice")</span>
                    </div>
                    <div class="ticker-content" id="noticeTicker">
                        @foreach (var notice in notices)
                        {
                            <div class="ticker-item">
                                <a asp-controller="Notice" asp-action="Details" asp-route-id="@notice.Id">
                                    @(isRtl ? notice.TitleBn : notice.TitleEn)
                                </a>
                            </div>
                        }
                    </div>
                    <a asp-controller="Notice" asp-action="Index" class="ticker-view-all">
                        @(isRtl ? "সব দেখুন" : "All") <i class="fas fa-arrow-right"></i>
                    </a>
                </div>
            </div>
        </section>
    }

    <section class="about-brief-section section-padding">
        <div class="container">
            <div class="row align-items-center g-4">
                <div class="col-lg-6">
                    <div class="about-brief-content">
                        <div class="section-subtitle">@(isRtl ? "আমাদের সম্পর্কে" : "About Us")</div>
                        <h2 class="section-title">@(isRtl ? "মোমিতুন্নেসা মাধ্যমিক বিদ্যালয়" : "Momitunnesa Secondary School")</h2>
                        <p>@(isRtl ? "মোমিতুন্নেসা মাধ্যমিক বিদ্যালয় একটি ঐতিহ্যবাহী শিক্ষাপ্রতিষ্ঠান যা মানসম্মত শিক্ষা প্রদানের লক্ষ্যে প্রতিষ্ঠিত। আমরা শিক্ষার্থীদের মধ্যে নৈতিক মূল্যবোধ, জ্ঞান ও দক্ষতা বিকাশে প্রতিশ্রুতিবদ্ধ।" : "Momitunnesa Secondary School is a traditional educational institution established with the aim of providing quality education. We are committed to developing moral values, knowledge, and skills among students.")</p>
                        <p>@(isRtl ? "আমাদের আধুনিক শিক্ষা পদ্ধতি, দক্ষ শিক্ষকমণ্ডলী ও উন্নত অবকাঠামো শিক্ষার্থীদের সর্বোত্তম শিক্ষা নিশ্চিত করে।" : "Our modern teaching methods, skilled teachers, and excellent infrastructure ensure the best education for students.")</p>
                        <a asp-controller="About" asp-action="Index" class="btn btn-primary mt-3">
                            @(isRtl ? "আরও পড়ুন" : "Read More") <i class="fas fa-arrow-right ms-2"></i>
                        </a>
                    </div>
                </div>
                <div class="col-lg-6">
                    <div class="about-brief-image">
                        <img src="/images/about-school.jpg" alt="School" class="img-fluid rounded shadow" />
                    </div>
                </div>
            </div>
        </div>
    </section>

    @await Html.PartialAsync("_Statistics")

    @{
        var headTeacherMsg = ViewBag.HeadTeacher as School.Web.Models.HeadTeacherMessageViewModel;
    }
    @if (headTeacherMsg != null)
    {
        @await Html.PartialAsync("_HeadTeacherMessage", headTeacherMsg)
    }

    @if (newsItems != null && newsItems.Any())
    {
        <section class="news-section section-padding bg-light">
            <div class="container">
                <div class="section-header text-center">
                    <div class="section-subtitle">@(isRtl ? "সর্বশেষ খবর" : "Latest News")</div>
                    <h2 class="section-title">@(isRtl ? "আমাদের খবর" : "Our News")</h2>
                </div>
                <div class="row g-4">
                    @foreach (var news in newsItems)
                    {
                        <div class="col-lg-4 col-md-6">
                            <div class="news-card">
                                <div class="news-image">
                                    <img src="@(news.ImageUrl ?? "/images/placeholder.jpg")" alt="@(isRtl ? news.TitleBn : news.TitleEn)" class="img-fluid" />
                                    <div class="news-date">
                                        <span class="day">@news.PublishDate.Day</span>
                                        <span class="month">@(isRtl ? news.PublishDate.ToString("MMM") : news.PublishDate.ToString("MMM"))</span>
                                    </div>
                                </div>
                                <div class="news-body">
                                    <h5 class="news-title">
                                        <a asp-controller="News" asp-action="Details" asp-route-id="@news.Id">
                                            @(isRtl ? news.TitleBn : news.TitleEn)
                                        </a>
                                    </h5>
                                    <p class="news-excerpt">@(isRtl ? (news.ContentBn?.Length > 100 ? news.ContentBn[..100] + "..." : news.ContentBn) : (news.ContentEn?.Length > 100 ? news.ContentEn[..100] + "..." : news.ContentEn))</p>
                                    <a asp-controller="News" asp-action="Details" asp-route-id="@news.Id" class="news-read-more">
                                        @(isRtl ? "বিস্তারিত" : "Read More") <i class="fas fa-arrow-right"></i>
                                    </a>
                                </div>
                            </div>
                        </div>
                    }
                </div>
                <div class="text-center mt-4">
                    <a asp-controller="News" asp-action="Index" class="btn btn-outline-primary">
                        @(isRtl ? "সব খবর দেখুন" : "View All News") <i class="fas fa-arrow-right ms-2"></i>
                    </a>
                </div>
            </div>
        </section>
    }

    @if (events != null && events.Any())
    {
        <section class="events-section section-padding">
            <div class="container">
                <div class="section-header text-center">
                    <div class="section-subtitle">@(isRtl ? "আগামী ইভেন্ট" : "Upcoming Events")</div>
                    <h2 class="section-title">@(isRtl ? "আমাদের ইভেন্ট" : "Our Events")</h2>
                </div>
                <div class="row g-4">
                    @foreach (var evt in events)
                    {
                        <div class="col-lg-4 col-md-6">
                            <div class="event-card">
                                <div class="event-date-badge">
                                    <span class="event-day">@evt.EventDate.Day</span>
                                    <span class="event-month">@(isRtl ? evt.EventDate.ToString("MMM") : evt.EventDate.ToString("MMM"))</span>
                                </div>
                                <div class="event-details">
                                    <h5 class="event-title">@(isRtl ? evt.TitleBn : evt.TitleEn)</h5>
                                    @if (evt.StartTime.HasValue)
                                    {
                                        <p class="event-meta"><i class="fas fa-clock"></i> @evt.StartTime.Value.ToString(@"hh\:mm")@(evt.EndTime.HasValue ? $" - {evt.EndTime.Value.ToString(@"hh\:mm")}" : "")</p>
                                    }
                                    <p class="event-desc">@(isRtl ? (evt.DescriptionBn?.Length > 80 ? evt.DescriptionBn[..80] + "..." : evt.DescriptionBn) : (evt.DescriptionEn?.Length > 80 ? evt.DescriptionEn[..80] + "..." : evt.DescriptionEn))</p>
                                </div>
                            </div>
                        </div>
                    }
                </div>
                <div class="text-center mt-4">
                    <a asp-controller="Event" asp-action="Index" class="btn btn-outline-primary">
                        @(isRtl ? "সব ইভেন্ট দেখুন" : "View All Events") <i class="fas fa-arrow-right ms-2"></i>
                    </a>
                </div>
            </div>
        </section>
    }

    <section class="achievements-section section-padding bg-primary text-white">
        <div class="container">
            <div class="section-header text-center text-white">
                <div class="section-subtitle text-white-50">@(isRtl ? "আমাদের সাফল্য" : "Our Achievements")</div>
                <h2 class="section-title text-white">@(isRtl ? "গর্বিত অর্জন" : "Proud Achievements")</h2>
            </div>
            <div class="row g-4">
                <div class="col-lg-3 col-md-6">
                    <div class="achievement-item text-center">
                        <div class="achievement-icon"><i class="fas fa-medal"></i></div>
                        <div class="achievement-number" data-target="5">0</div>
                        <p class="achievement-label">@(isRtl ? "জাতীয় পুরস্কার" : "National Awards")</p>
                    </div>
                </div>
                <div class="col-lg-3 col-md-6">
                    <div class="achievement-item text-center">
                        <div class="achievement-icon"><i class="fas fa-trophy"></i></div>
                        <div class="achievement-number" data-target="25">0</div>
                        <p class="achievement-label">@(isRtl ? "বিভাগীয় পুরস্কার" : "Divisional Awards")</p>
                    </div>
                </div>
                <div class="col-lg-3 col-md-6">
                    <div class="achievement-item text-center">
                        <div class="achievement-icon"><i class="fas fa-award"></i></div>
                        <div class="achievement-number" data-target="100">0</div>
                        <p class="achievement-label">@(isRtl ? "এ+ প্রাপ্ত শিক্ষার্থী" : "A+ Students")</p>
                    </div>
                </div>
                <div class="col-lg-3 col-md-6">
                    <div class="achievement-item text-center">
                        <div class="achievement-icon"><i class="fas fa-star"></i></div>
                        <div class="achievement-number" data-target="50">0</div>
                        <p class="achievement-label">@(isRtl ? "বৃত্তি প্রাপ্ত" : "Scholarship Winners")</p>
                    </div>
                </div>
            </div>
        </div>
    </section>
</div>
