@model School.Web.Models.NewsListViewModel
@{
    ViewData["Title"] = "News";
    var isRtl = (ViewData["CurrentLanguage"]?.ToString() ?? "en") == "bn";
}
<div class="news-page">
    <div class="row g-4">
        <div class="col-lg-8">
            <div class="news-toolbar mb-4">
                <div class="row g-2">
                    <div class="col-md-4">
                        <div class="category-filter">
                            <select class="form-select" onchange="window.location.href=this.value">
                                <option value="@Url.Action("Index")">@(isRtl ? "সব ক্যাটাগরি" : "All Categories")</option>
                                <option value="@Url.Action("Index", new { category = "academic" })">@(isRtl ? "একাডেমিক" : "Academic")</option>
                                <option value="@Url.Action("Index", new { category = "sports" })">@(isRtl ? "ক্রীড়া" : "Sports")</option>
                                <option value="@Url.Action("Index", new { category = "cultural" })">@(isRtl ? "সাংস্কৃতিক" : "Cultural")</option>
                                <option value="@Url.Action("Index", new { category = "achievement" })">@(isRtl ? "সাফল্য" : "Achievement")</option>
                            </select>
                        </div>
                    </div>
                    <div class="col-md-8">
                        <form asp-action="Index" method="get" class="d-flex gap-2">
                            <div class="input-group">
                                <input type="text" name="q" class="form-control" placeholder="@(isRtl ? "খবর অনুসন্ধান..." : "Search news...")" />
                                <button class="btn btn-primary" type="submit"><i class="fas fa-search"></i></button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
            <div class="news-grid">
                @if (Model.NewsItems != null && Model.NewsItems.Any())
                {
                    <div class="row g-4">
                        @foreach (var news in Model.NewsItems)
                        {
                            <div class="col-md-6">
                                <div class="news-card">
                                    <div class="news-image">
                                        <img src="@news.ImageUrl" alt="@news.Title" class="img-fluid" onerror="this.src='/images/placeholder.svg'" />
                                        <div class="news-date">
                                            <span class="day">@news.PublishDate?.ToString("dd")</span>
                                            <span class="month">@news.PublishDate?.ToString("MMM")</span>
                                        </div>
                                    </div>
                                    <div class="news-body">
                                        <h5 class="news-title">
                                            <a asp-action="Details" asp-route-id="@news.Id">
                                                @(isRtl ? news.TitleBn ?? news.Title : news.Title)
                                            </a>
                                        </h5>
                                        <p class="news-excerpt">@news.Description</p>
                                        <a asp-action="Details" asp-route-id="@news.Id" class="news-read-more">
                                            @(isRtl ? "বিস্তারিত" : "Read More") <i class="fas fa-arrow-right"></i>
                                        </a>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
            <nav aria-label="News pagination" class="mt-4">
                <ul class="pagination justify-content-center">
                    <li class="page-item @(Model.CurrentPage <= 1 ? "disabled" : "")">
                        <a class="page-link" asp-action="Index" asp-route-page="@(Model.CurrentPage - 1)" asp-route-category="@Model.Category"><i class="fas fa-chevron-left"></i></a>
                    </li>
                    @for (int p = 1; p <= Model.TotalPages; p++)
                    {
                        <li class="page-item @(p == Model.CurrentPage ? "active" : "")">
                            <a class="page-link" asp-action="Index" asp-route-page="@p" asp-route-category="@Model.Category">@p</a>
                        </li>
                    }
                    <li class="page-item @(Model.CurrentPage >= Model.TotalPages ? "disabled" : "")">
                        <a class="page-link" asp-action="Index" asp-route-page="@(Model.CurrentPage + 1)" asp-route-category="@Model.Category"><i class="fas fa-chevron-right"></i></a>
                    </li>
                </ul>
            </nav>
        </div>
        <div class="col-lg-4">
            <aside class="news-sidebar">
                @await Html.PartialAsync("_ImportantLinks")
            </aside>
        </div>
    </div>
</div>
