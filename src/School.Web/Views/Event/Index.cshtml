@model School.Web.Models.EventListViewModel
@{
    ViewData["Title"] = "Events";
    var isRtl = (ViewData["CurrentLanguage"]?.ToString() ?? "en") == "bn";
}
<div class="events-page">
    <div class="row g-4">
        <div class="col-lg-8">
            <div class="events-header mb-4">
                <ul class="nav nav-pills" id="eventFilter">
                    <li class="nav-item"><a class="nav-link active" href="#">@(isRtl ? "আসন্ন" : "Upcoming")</a></li>
                    <li class="nav-item"><a class="nav-link" href="#">@(isRtl ? "চলমান" : "Ongoing")</a></li>
                    <li class="nav-item"><a class="nav-link" href="#">@(isRtl ? "অতীত" : "Past")</a></li>
                </ul>
            </div>
            <div class="events-list">
                @if (Model.Events != null && Model.Events.Any())
                {
                    <div class="row g-4">
                        @foreach (var evt in Model.Events)
                        {
                            <div class="col-md-6">
                                <div class="event-card-horizontal d-flex">
                                    <div class="event-date-box flex-shrink-0">
                                        <span class="event-day">@evt.EventDate?.ToString("dd")</span>
                                        <span class="event-month">@evt.EventDate?.ToString("MMM")</span>
                                    </div>
                                    <div class="event-info flex-grow-1">
                                        <h5 class="event-title">
                                            <a asp-action="Details" asp-route-id="@evt.Id">
                                                @(isRtl ? evt.TitleBn ?? evt.Title : evt.Title)
                                            </a>
                                        </h5>
                                        <p class="event-meta">
                                            <span><i class="fas fa-clock me-1"></i>@evt.StartTime - @evt.EndTime</span>
                                            <span class="ms-2"><i class="fas fa-map-marker-alt me-1"></i>@(isRtl ? evt.LocationBn ?? evt.Location : evt.Location)</span>
                                        </p>
                                        <p class="event-description">@evt.Description</p>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
            <nav aria-label="Event pagination" class="mt-4">
                <ul class="pagination justify-content-center">
                    <li class="page-item @(Model.CurrentPage <= 1 ? "disabled" : "")">
                        <a class="page-link" asp-action="Index" asp-route-page="@(Model.CurrentPage - 1)" asp-route-filter="@Model.Filter"><i class="fas fa-chevron-left"></i></a>
                    </li>
                    @for (int p = 1; p <= Model.TotalPages; p++)
                    {
                        <li class="page-item @(p == Model.CurrentPage ? "active" : "")">
                            <a class="page-link" asp-action="Index" asp-route-page="@p" asp-route-filter="@Model.Filter">@p</a>
                        </li>
                    }
                    <li class="page-item @(Model.CurrentPage >= Model.TotalPages ? "disabled" : "")">
                        <a class="page-link" asp-action="Index" asp-route-page="@(Model.CurrentPage + 1)" asp-route-filter="@Model.Filter"><i class="fas fa-chevron-right"></i></a>
                    </li>
                </ul>
            </nav>
        </div>
        <div class="col-lg-4">
            <aside class="events-sidebar">
                <div class="card mb-4">
                    <div class="card-header bg-primary text-white">
                        <h5 class="mb-0">@(isRtl ? "চলতি মাস" : "Current Month")</h5>
                    </div>
                    <div class="card-body">
                        <div class="mini-calendar text-center">
                            <div class="calendar-header">
                                <i class="fas fa-calendar-alt fa-3x text-primary mb-2"></i>
                                <h6>@DateTime.Now.ToString("MMMM yyyy")</h6>
                            </div>
                            <p class="text-muted mb-0">@(isRtl ? "এই মাসে ৫টি ইভেন্ট" : "5 events this month")</p>
                        </div>
                    </div>
                </div>
                @await Html.PartialAsync("_ImportantLinks")
            </aside>
        </div>
    </div>
</div>
