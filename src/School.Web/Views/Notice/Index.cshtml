@model School.Web.Models.NoticeListViewModel
@{
    ViewData["Title"] = "Notice Board";
    var isRtl = (ViewData["CurrentLanguage"]?.ToString() ?? "en") == "bn";
    var categories = new[] {
        new { Name = "All", NameBn = "সব" },
        new { Name = "Admission", NameBn = "ভর্তি" },
        new { Name = "Exam", NameBn = "পরীক্ষা" },
        new { Name = "Meeting", NameBn = "সভা" },
        new { Name = "Result", NameBn = "ফলাফল" },
        new { Name = "Notice", NameBn = "নোটিশ" }
    };
}
<div class="notice-page">
    <div class="row g-4">
        <div class="col-lg-8">
            <div class="notice-filters mb-4">
                <div class="d-flex flex-wrap gap-2">
                    @foreach (var cat in categories)
                    {
                        <a href="@Url.Action("Index", new { category = cat.Name == "All" ? "" : cat.Name })"
                           class="btn btn-sm @(ViewContext.RouteData.Values["category"]?.ToString() == cat.Name || (ViewContext.RouteData.Values["category"] == null && cat.Name == "All") ? "btn-primary" : "btn-outline-primary")">
                            @(isRtl ? cat.NameBn : cat.Name)
                        </a>
                    }
                </div>
            </div>
            <div class="notice-list">
                @if (Model.Notices != null && Model.Notices.Any())
                {
                    @foreach (var notice in Model.Notices)
                    {
                        <div class="notice-card @(notice.IsFeatured ? "featured" : "")">
                            <div class="notice-header">
                                @if (notice.IsFeatured) { <span class="badge bg-danger mb-2">@(isRtl ? "গুরুত্বপূর্ণ" : "Featured")</span> }
                                <h5 class="notice-title">
                                    <a asp-action="Details" asp-route-id="@notice.Id">
                                        @(isRtl ? notice.TitleBn ?? notice.Title : notice.Title)
                                    </a>
                                </h5>
                                <div class="notice-meta">
                                    <span><i class="far fa-calendar-alt me-1"></i>@notice.PublishDate?.ToString("dd MMM yyyy")</span>
                                    <span class="ms-3"><i class="far fa-folder me-1"></i>@(isRtl ? notice.CategoryBn ?? notice.Category : notice.Category)</span>
                                </div>
                            </div>
                            <p class="notice-excerpt">@notice.Description</p>
                            @if (notice.Attachments != null && notice.Attachments.Any())
                            {
                                <div class="notice-attachments">
                                    <a href="#" class="btn btn-sm btn-outline-primary">
                                        <i class="fas fa-file-pdf"></i> @(isRtl ? "ডাউনলোড" : "Download")
                                    </a>
                                </div>
                            }
                        </div>
                    }
                }
            </div>
            <nav aria-label="Notice pagination" class="mt-4">
                <ul class="pagination justify-content-center">
                    <li class="page-item @(Model.CurrentPage <= 1 ? "disabled" : "")">
                        <a class="page-link" asp-action="Index" asp-route-page="@(Model.CurrentPage - 1)" asp-route-category="@Model.Category"><i class="fas fa-chevron-left"></i></a>
                    </li>
                    @for (int p = 1; p <= Model.TotalPages; p++)
                    {
                        <li class="page-item @(p == Model.CurrentPage ? "active" : "")">
                            <a class="page-link" asp-action="Index" asp-route-page="@p" asp-route-category="@Model.Category">@p</a>
                        </li>
                    }
                    <li class="page-item @(Model.CurrentPage >= Model.TotalPages ? "disabled" : "")">
                        <a class="page-link" asp-action="Index" asp-route-page="@(Model.CurrentPage + 1)" asp-route-category="@Model.Category"><i class="fas fa-chevron-right"></i></a>
                    </li>
                </ul>
            </nav>
        </div>
        <div class="col-lg-4">
            <aside class="notice-sidebar">
                @await Html.PartialAsync("_ImportantLinks")
            </aside>
        </div>
    </div>
</div>
