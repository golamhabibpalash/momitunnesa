@model School.Web.Models.NoticeListViewModel
@{
    ViewData["Title"] = "Notice Board";
    var isRtl = (ViewData["CurrentLanguage"]?.ToString() ?? "en") == "bn";
    var categories = new[] {
        new { Name = "All", NameBn = "সব" },
        new { Name = "Admission", NameBn = "ভর্তি" },
        new { Name = "Exam", NameBn = "পরীক্ষা" },
        new { Name = "Meeting", NameBn = "সভা" },
        new { Name = "Result", NameBn = "ফলাফল" },
        new { Name = "Notice", NameBn = "নোটিশ" }
    };
}
<div class="notice-page">
    <div class="row g-4">
        <div class="col-lg-8">
            <div class="notice-filters mb-4">
                <div class="d-flex flex-wrap gap-2">
                    @foreach (var cat in categories)
                    {
                        <a href="@Url.Action("Index", new { category = cat.Name == "All" ? "" : cat.Name })"
                           class="btn btn-sm @(ViewContext.RouteData.Values["category"]?.ToString() == cat.Name || (ViewContext.RouteData.Values["category"] == null && cat.Name == "All") ? "btn-primary" : "btn-outline-primary")">
                            @(isRtl ? cat.NameBn : cat.Name)
                        </a>
                    }
                </div>
            </div>
            <div class="notice-list">
                @for (int i = 1; i <= 6; i++)
                {
                    <div class="notice-card @(i == 1 ? "featured" : "")">
                        <div class="notice-header">
                            @if (i == 1) { <span class="badge bg-danger mb-2">@(isRtl ? "গুরুত্বপূর্ণ" : "Featured")</span> }
                            <h5 class="notice-title">
                                <a asp-action="Details" asp-route-id="@i">
                                    @(isRtl ? $"নোটিশ শিরোনাম {i}" : $"Notice Title {i}")
                                </a>
                            </h5>
                            <div class="notice-meta">
                                <span><i class="far fa-calendar-alt me-1"></i>@DateTime.Now.AddDays(-i).ToString("dd MMM yyyy")</span>
                                <span class="ms-3"><i class="far fa-folder me-1"></i>@(isRtl ? "নোটিশ" : "Notice")</span>
                            </div>
                        </div>
                        <p class="notice-excerpt">@(isRtl ? "এটি নোটিশের বিবরণ। বিস্তারিত জানতে ক্লিক করুন..." : "This is the notice description. Click for details...")</p>
                        @if (i % 2 == 0)
                        {
                            <div class="notice-attachments">
                                <a href="#" class="btn btn-sm btn-outline-primary">
                                    <i class="fas fa-file-pdf"></i> @(isRtl ? "ডাউনলোড" : "Download") (PDF, 250 KB)
                                </a>
                            </div>
                        }
                    </div>
                }
            </div>
            <nav aria-label="Notice pagination" class="mt-4">
                <ul class="pagination justify-content-center">
                    <li class="page-item disabled"><a class="page-link" href="#"><i class="fas fa-chevron-left"></i></a></li>
                    <li class="page-item active"><a class="page-link" href="#">1</a></li>
                    <li class="page-item"><a class="page-link" href="#">2</a></li>
                    <li class="page-item"><a class="page-link" href="#">3</a></li>
                    <li class="page-item"><a class="page-link" href="#"><i class="fas fa-chevron-right"></i></a></li>
                </ul>
            </nav>
        </div>
        <div class="col-lg-4">
            <aside class="notice-sidebar">
                @await Html.PartialAsync("_ImportantLinks")
            </aside>
        </div>
    </div>
</div>
