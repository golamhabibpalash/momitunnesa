@model School.Web.Models.NoticeViewModel
@{
    ViewData["Title"] = Model?.Title ?? "Notice Details";
    var isRtl = (ViewData["CurrentLanguage"]?.ToString() ?? "en") == "bn";
    var breadcrumbItems = new List<KeyValuePair<string, string>>
    {
        new KeyValuePair<string, string>(isRtl ? "নোটিশ বোর্ড" : "Notice Board", Url.Action("Index", "Notice") ?? ""),
        new KeyValuePair<string, string>(Model?.Title ?? "Notice", "")
    };
    ViewData["BreadcrumbItems"] = breadcrumbItems;
}
<div class="notice-details">
    <div class="row g-4">
        <div class="col-lg-8">
            <article class="notice-article">
                <div class="notice-header-detail">
                    @if (Model?.IsFeatured == true)
                    {
                        <span class="badge bg-danger mb-2">@(isRtl ? "গুরুত্বপূর্ণ" : "Featured")</span>
                    }
                    <h1 class="notice-title-detail">@(isRtl ? Model?.TitleBn ?? Model?.Title : Model?.Title)</h1>
                    <div class="notice-meta-detail">
                        <span class="notice-date"><i class="far fa-calendar-alt me-2"></i>@(Model?.PublishDate?.ToString("dd MMMM yyyy") ?? DateTime.Now.ToString("dd MMMM yyyy"))</span>
                        <span class="notice-category ms-3"><i class="far fa-folder me-2"></i>@(isRtl ? Model?.CategoryBn ?? Model?.Category : Model?.Category)</span>
                    </div>
                </div>
                <div class="notice-body mt-4">
                    @if (!string.IsNullOrEmpty(Model?.Content) || !string.IsNullOrEmpty(Model?.ContentBn))
                    {
                        @Html.Raw(isRtl ? (Model?.ContentBn ?? Model?.Content) : Model?.Content)
                    }
                </div>
                @if (Model?.Attachments != null && Model.Attachments.Count > 0)
                {
                    <div class="notice-attachments mt-4">
                        <h5><i class="fas fa-paperclip me-2"></i>@(isRtl ? "সংযুক্ত ফাইল" : "Attachments")</h5>
                        <div class="file-list">
                            @foreach (var file in Model.Attachments)
                            {
                                <div class="file-item">
                                    <i class="fas fa-file-pdf text-danger me-2"></i>
                                    <a href="@file.Url">@(isRtl ? file.NameBn : file.Name)</a>
                                    <span class="file-size text-muted ms-2">(@file.Size)</span>
                                </div>
                            }
                        </div>
                    </div>
                }
                <div class="notice-share mt-4 pt-3 border-top">
                    <span class="me-2">@(isRtl ? "শেয়ার করুন:" : "Share:")</span>
                    <a href="https://www.facebook.com/sharer/sharer.php?u=@Context.Request.GetEncodedUrl()" target="_blank" class="btn btn-sm btn-outline-primary" rel="noopener"><i class="fab fa-facebook-f"></i></a>
                    <a href="https://twitter.com/intent/tweet?url=@Context.Request.GetEncodedUrl()" target="_blank" class="btn btn-sm btn-outline-info" rel="noopener"><i class="fab fa-twitter"></i></a>
                    <a href="https://wa.me/?text=@Context.Request.GetEncodedUrl()" target="_blank" class="btn btn-sm btn-outline-success" rel="noopener"><i class="fab fa-whatsapp"></i></a>
                </div>
            </article>
        </div>
        <div class="col-lg-4">
            <aside class="notice-sidebar">
                @await Html.PartialAsync("_ImportantLinks")
            </aside>
        </div>
    </div>
</div>
