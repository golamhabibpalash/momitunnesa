@model School.Web.Models.TeacherListViewModel
@using School.Domain.Enums
@{
    ViewData["Title"] = "Teachers";
    var isRtl = (ViewData["CurrentLanguage"]?.ToString() ?? "en") == "bn";
    var filters = new[] { Designation.HeadTeacher, Designation.AssistantHeadTeacher, Designation.SeniorTeacher, Designation.JuniorTeacher };
}
<div class="teachers-page">
    <div class="row g-4">
        <div class="col-lg-9">
            <div class="teacher-filters mb-4">
                <div class="d-flex flex-wrap gap-2">
                    <a href="@Url.Action("Index")" class="btn btn-sm @(string.IsNullOrEmpty(Model.Designation) ? "btn-primary" : "btn-outline-primary")">@(isRtl ? "সব" : "All")</a>
                    @foreach (var d in filters)
                    {
                        <a href="@Url.Action("Index", new { designation = d.ToString() })" class="btn btn-sm @(Model.Designation == d.ToString() ? "btn-primary" : "btn-outline-primary")">@CategoryHelper.Label(d)</a>
                    }
                </div>
            </div>
            @if (Model.Teachers == null || !Model.Teachers.Any())
            {
                <div class="alert alert-light border text-center py-5">@(isRtl ? "কোনো শিক্ষক পাওয়া যায়নি।" : "No teachers found.")</div>
            }
            else
            {
                <div class="row g-4">
                    @foreach (var teacher in Model.Teachers)
                    {
                        var card = new PersonCardModel
                        {
                            Name = teacher.Name,
                            Role = teacher.Designation,
                            Meta = string.Join(" • ", new[] { teacher.Subject, teacher.Qualification }.Where(x => !string.IsNullOrWhiteSpace(x))),
                            ImageUrl = teacher.ImageUrl,
                            Email = teacher.Email,
                            Phone = teacher.Phone,
                            DetailsUrl = Url.Action("Details", new { id = teacher.Id })
                        };
                        <div class="col-xl-4 col-md-6">
                            <partial name="_PersonCard" model="card" />
                        </div>
                    }
                </div>
            }
        </div>
        <div class="col-lg-3">
            <aside>
                @await Html.PartialAsync("_ImportantLinks")
            </aside>
        </div>
    </div>
</div>
