{
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost,1433;Database=SchoolManagement;User Id=sa;Password=YourPassword123!;TrustServerCertificate=True;MultipleActiveResultSets=true"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning",
        "Microsoft.AspNetCore": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "logs/log-.txt",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30
        }
      }
    ]
  },
  "AllowedHosts": "*",
  "SiteSettings": {
    "Name": "School Management",
    "Version": "1.0.0",
    "DefaultLanguage": "en",
    "PageSize": 10,
    "FileUpload": {
      "MaxFileSize": 10485760,
      "AllowedExtensions": [".jpg",".jpeg",".png",".gif",".pdf",".doc",".docx",".xls",".xlsx",".zip"],
      "AllowedImageExtensions": [".jpg",".jpeg",".png",".gif"]
    }
  }
}
